---
/**
 * /writings/personal/ and /writings/work/.
 * The card's photo becomes a low header band (it carries across with a view transition) with the same
 * glass plate holding the name and line; the Personal / Work switch is a glass pill on the photo.
 * Below: topics as one quiet line (only once a section has enough pieces for filtering to help), then the list.
 */
import { getCollection } from 'astro:content';
import SiteLayout from '../../../layouts/SiteLayout.astro';
import WritingList from '../../../components/WritingList.astro';
import PerchingCrow from '../../../components/PerchingCrow.astro';
import { sections, sectionKeys, srcset, published, type SectionKey } from '../../../lib/writings';

export function getStaticPaths() {
  return sectionKeys.map((section) => ({ params: { section } }));
}
const k = Astro.params.section as SectionKey;
const s = sections[k];
const list = published(await getCollection('writings', (e) => e.data.section === k));
const topics = s.topics.map((t) => ({ t, n: list.filter((e) => e.data.topic === t).length })).filter((x) => x.n > 0);
const showTopics = list.length >= 4 && topics.length >= 2;
const site = 'https://imkiruthika.in';
const url = `${site}/writings/${k}/`;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url, url, name: `${s.name} writing by Kiruthika Ramesh`,
  isPartOf: { '@id': site + '/#website' }, author: { '@id': site + '/#person' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Writings', item: site + '/writings/' },
    { '@type': 'ListItem', position: 3, name: s.name, item: url },
  ] },
};
---
<SiteLayout
  title={s.seo.title}
  description={s.seo.description}
  canonical={url}
  current="Writings"
  quote={s.quote}
  ogImage={`https://imkiruthika.in/og-${k}.png`}
  ogImageAlt={`The white handwritten Kr. logo beside /${k} on a solid orange background.`}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Writings by Kiruthika Ramesh" href="/writings/rss.xml" />

  <section class="wrap band-wrap" aria-labelledby="s-title">
    <div class="band" style={`--focus:${s.photo.focus}`}>
      <img data-vt style={`--vt: photo-${k}`} src={s.photo.large} srcset={srcset(k)} sizes="100vw" alt="" width="1600" height="2400" fetchpriority="high" decoding="async" />
      <nav class="switch" aria-label="Writing sections" data-vt-glass>
        {sectionKeys.map((x) => <a href={`/writings/${x}/`} aria-current={x === k ? 'page' : undefined}>{sections[x].name}</a>)}
      </nav>
      <div class="plate" data-vt-glass>
        <a class="crumb" href="/writings/">Writings</a>
        <h1 id="s-title">{s.name}</h1>
        <p class="desc">{s.desc}</p>
      </div>
    </div>
  </section>

  <section class="wrap body" aria-label={`${s.name} writing`}>
    {showTopics && (
      <ul class="topics" aria-label="Filter by topic">
        <li><button type="button" data-topic="" aria-pressed="true">All</button></li>
        {topics.map((x) => <li><button type="button" data-topic={x.t} aria-pressed="false">{x.t}</button></li>)}
      </ul>
    )}
    {list.length > 0 && <PerchingCrow targets=".row" at={0.035} size={2} />}
    {list.length > 0
      ? <WritingList list={list} filterable={showTopics} />
      : <p class="empty">The first piece is still in drafts. <a href="/writings/personal/">Read something personal meanwhile <span aria-hidden="true">→</span></a></p>}
  </section>

</SiteLayout>

<style>
  .band-wrap { padding-top: clamp(16px, 3svh, 32px); }
  .band { position: relative; isolation: isolate; overflow: hidden; height: clamp(300px, 46svh, 520px); border-radius: clamp(20px, 2.2vw, 30px); }
  .band img { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus); }
  .plate {
    position: absolute; left: clamp(10px, 1.2vw, 16px); bottom: clamp(10px, 1.2vw, 16px); width: min(560px, calc(100% - 2 * clamp(10px, 1.2vw, 16px)));
    display: flex; flex-direction: column; gap: 8px; padding: clamp(18px, 2.2vw, 30px);
    border-radius: clamp(14px, 1.6vw, 22px);
    background: color-mix(in srgb, var(--page) 64%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.5); backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 55%, transparent), inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
  }
  :global(:root[data-theme='dark']) .plate { background: color-mix(in srgb, var(--page) 58%, transparent); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12), inset 0 0 0 1px rgba(255, 255, 255, .06); }
  .crumb { width: fit-content; font-size: 13px; color: color-mix(in srgb, var(--ink) 62%, transparent); text-decoration: none; }
  .crumb::before { content: '← '; }
  .crumb:hover { color: var(--brand); }
  h1 { font-size: clamp(40px, min(5vw, 8svh), 80px); font-weight: 500; line-height: .95; letter-spacing: -.045em; }
  .desc { font-size: clamp(15px, 1.2vw, 17px); line-height: 1.45; color: color-mix(in srgb, var(--ink) 72%, transparent); }
  .switch {
    position: absolute; top: clamp(12px, 1.4vw, 18px); right: clamp(12px, 1.4vw, 18px); display: inline-flex; gap: 2px; padding: 4px; border-radius: 999px;
    background: rgba(255, 255, 255, .14); -webkit-backdrop-filter: blur(14px) saturate(1.4); backdrop-filter: blur(14px) saturate(1.4);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22);
  }
  .switch a { display: inline-flex; align-items: center; min-height: 34px; padding: 0 15px; border-radius: 999px; font-size: 14px; font-weight: 500; color: rgba(255, 255, 255, .85); text-decoration: none; transition: background-color .3s ease, color .2s ease; }
  .switch a:hover { color: #fff; }
  .switch a[aria-current='page'] { color: var(--ink); background: color-mix(in srgb, var(--page) 88%, transparent); }

  /* the crow stands on the line above the piece you are about to read */
  .body { position: relative; padding-block: clamp(56px, 8svh, 88px) clamp(56px, 10svh, 120px); }
  .topics { list-style: none; display: flex; flex-wrap: wrap; gap: 4px 26px; margin: 0 0 clamp(14px, 2.4svh, 24px); padding: 0; }
  .topics button {
    min-height: 40px; padding: 0; border: 0; background: none; font: inherit; font-size: 16px; color: var(--muted); cursor: pointer;
    text-decoration: underline; text-decoration-color: transparent; text-decoration-thickness: 1px; text-underline-offset: .4em;
    transition: color .2s ease, text-decoration-color .2s ease;
  }
  .topics button:hover { color: var(--ink); }
  .topics button[aria-pressed='true'] { color: var(--ink); text-decoration-color: var(--brand); }
  .empty { display: flex; flex-wrap: wrap; align-items: baseline; gap: 6px 24px; padding-block: 28px; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); font-size: clamp(18px, 1.6vw, 22px); color: var(--muted); }
  .empty a {
    display: inline-flex; gap: .4em; font-size: 16px; font-weight: 500; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); transition: color .2s ease, border-color .2s ease;
  }
  .empty a:hover, .empty a:focus-visible { color: var(--brand); border-color: var(--brand); }

  @media (max-width: 820px) {
    .band { height: clamp(300px, 52svh, 440px); }
    .switch a { padding: 0 12px; font-size: 13px; }
  }
</style>

<script>
  // topic filter: in place, remembered in the address (?topic=) so a filtered view can be shared
  const buttons = Array.from(document.querySelectorAll<HTMLButtonElement>('.topics button'));
  const rows = Array.from(document.querySelectorAll<HTMLElement>('[data-list] .row'));
  const apply = (topic: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String((b.dataset.topic || '') === topic)));
    rows.forEach((r) => { r.hidden = !!topic && r.dataset.topic !== topic; });
    const url = new URL(location.href); topic ? url.searchParams.set('topic', topic) : url.searchParams.delete('topic');
    history.replaceState(null, '', url);
  };
  buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.topic || '')));
  const start = new URL(location.href).searchParams.get('topic');
  if (start && buttons.some((b) => b.dataset.topic === start)) apply(start);
</script>
