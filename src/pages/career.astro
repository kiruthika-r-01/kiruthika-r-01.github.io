---
/**
 * Career: a timeline that reads like a ledger.
 * Each company's name, role and dates stay pinned on the left while its highlights scroll past (desktop);
 * the crow rides beside the company name being read and flies down the line to the next role as you scroll;
 * the orange line fills behind it.
 * Results are orange, roles and titles italic. Tools reuse the quiet tile language of the homepage testimonials;
 * competencies are set as one typographic line. All content comes from src/data/career.json.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import career from '../data/career.json';
import Crow from '../components/Crow.astro';

const title = 'Kiruthika Ramesh | Marketing Experience & Skills';
const description = "Explore Kiruthika Ramesh's marketing experience across GTM, content, SEO, automation, and design, with selected projects, results, and tools.";
const canonicalUrl = 'https://imkiruthika.in/career/';
const siteUrl = 'https://imkiruthika.in/';

type Highlight = { text: string; emphasis?: string[]; italic?: string };
const formatHighlight = (h: Highlight) => {
  const emphasis = h.emphasis ?? [];
  const terms = [...new Set([...emphasis, h.italic].filter(Boolean) as string[])].sort((a, b) => b.length - a.length);
  if (!terms.length) return [{ text: h.text }];
  const escaped = terms.map((t) => t.replace(/[.*+?^${}()|[\]\\]/g, '\\$&'));
  return h.text.split(new RegExp(`(${escaped.join('|')})`, 'g')).filter(Boolean)
    .map((text) => ({ text, emphasized: emphasis.includes(text), italic: h.italic === text }));
};
const slug = (s: string) => 'job-' + s.replace(/\W+/g, '-').toLowerCase();

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: title,
  description,
  mainEntity: { '@id': siteUrl + '#person' },
  isPartOf: { '@id': siteUrl + '#website' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'Career', item: canonicalUrl },
    ],
  },
};
---
<SiteLayout
  title={title}
  description={description}
  canonical={canonicalUrl}
  ogImage="https://imkiruthika.in/og-career.png"
  ogImageAlt="The white handwritten Kr. logo beside /career on a solid orange background."
  current="Career"
  quote={{ text: 'I learn by going where I have to go.', by: 'Theodore Roethke' }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="wrap c-intro" aria-labelledby="career-title">
    <h1 id="career-title">Career <em>Timeline</em></h1>
    <p class="support"><em>Across content, growth, GTM, and design.</em></p>
    <a class="resume" href="/resume.pdf" target="_blank" rel="noopener noreferrer" aria-label="View résumé PDF (opens in a new tab)">View résumé <span aria-hidden="true">↗</span></a>
  </section>

  <section class="wrap timeline" aria-label="Career experiences">
    <span class="track" aria-hidden="true"><span class="fill"></span></span>
    <span class="tl-crow" aria-hidden="true"><Crow size={1.6} mood="still" flyer /></span>
    {career.experiences.map((e) => (
      <article class="job" aria-labelledby={slug(e.company)}>
        <header class="job-head">
          <p class="when">{e.dates}</p>
          <h2 id={slug(e.company)}>{e.company}</h2>
          <p class="role"><em>{e.role}</em></p>
        </header>
        <ul class="points">
          {e.highlights.map((h) => (
            <li>{formatHighlight(h as Highlight).map((part) => part.emphasized ? <strong>{part.text}</strong> : part.italic ? <em>{part.text}</em> : part.text)}</li>
          ))}
        </ul>
      </article>
    ))}
  </section>

  <section class="wrap tools" aria-labelledby="tools-title">
    <h2 class="section-title" id="tools-title">Tools</h2>
    <ul class="tool-grid">
      {career.tools.map((t) => (
        <li class="tool">
          <span class="tool-logo">
            {t.logo ? <img src={t.logo} alt="" width="40" height="40" loading="lazy" decoding="async" /> : <span class="tool-mark" aria-hidden="true">{t.mark}</span>}
          </span>
          <span class="tool-name">{t.name}</span>
        </li>
      ))}
    </ul>
  </section>

  <section class="wrap comps" aria-labelledby="comps-title">
    <h2 class="section-title" id="comps-title">Competencies</h2>
    <ul class="comp-line">
      {career.competencies.map((c) => <li><span class="c">{c}</span></li>)}
    </ul>
  </section>
</SiteLayout>

<script>
  // The crow rides beside the company name that is being read (pinned at the top on desktop, ~40% down on phones).
  // Between roles nothing sits there, so it flaps and keeps pace with you until the next name arrives.
  const tl = document.querySelector<HTMLElement>('.timeline');
  const holder = tl?.querySelector<HTMLElement>('.tl-crow');
  const bird = holder?.querySelector<HTMLElement>('[data-crow]');
  const heads = Array.from(tl?.querySelectorAll<HTMLElement>('.job-head') ?? []);
  const header = document.querySelector<HTMLElement>('.site-header');
  const wide = matchMedia('(min-width: 821px)');
  const still = matchMedia('(prefers-reduced-motion: reduce)');
  const fill = tl?.querySelector<HTMLElement>('.fill');
  if (tl && holder && bird && fill && heads.length) {
    let pos = -1, target = 0, wantFly = false, raf = 0, flying = false;
    // geometry that only changes on resize / font load, so scrolling reads as little layout as possible
    let half = 0, start = 0, end = 0, height = 1;
    const geometry = () => {
      half = holder.offsetHeight / 2;
      start = heads[0].offsetTop + 10;
      height = tl.offsetHeight || 1;
      end = height - holder.offsetHeight;
    };
    const measure = () => {
      const top = tl.getBoundingClientRect().top;
      const anchor = wide.matches ? (header?.offsetHeight ?? 80) + 32 + 10 : innerHeight * 0.4;
      // perched: a company name sits at the anchor (pinned there on desktop, passing it on phones)
      const perched = heads.some((h) => Math.abs(h.getBoundingClientRect().top + 10 - anchor) < (wide.matches ? 6 : 36));
      const y = anchor - top;
      target = Math.min(Math.max(y, start), end);
      wantFly = !perched && y > start && y < end;
    };
    // writes go straight to the two moving elements as transforms (no layout, no restyle of the timeline)
    const step = () => {
      pos = pos < 0 || still.matches ? target : pos + (target - pos) * 0.2;
      holder.style.transform = `translate3d(0, ${(pos - half).toFixed(1)}px, 0)`;
      fill.style.transform = `scaleY(${(pos / height).toFixed(4)})`;
      const moving = Math.abs(target - pos) > 1.5;
      if (flying !== (wantFly || moving)) { flying = !flying; bird.toggleAttribute('data-flying', flying); }
      raf = moving ? requestAnimationFrame(step) : 0;
    };
    geometry();
    // apply straight away on each scroll; keep easing on following frames only while still catching up
    const update = () => { measure(); cancelAnimationFrame(raf); step(); };
    update();
    addEventListener('scroll', update, { passive: true });
    const relayout = () => { geometry(); update(); };
    addEventListener('resize', relayout);
    document.fonts?.ready.then(relayout);
  }
</script>

<style>
  /* ---- intro: compact, so the timeline begins in the first fold */
  .c-intro { display: grid; grid-template-columns: 1fr auto; align-items: end; gap: 12px 32px; padding-block: clamp(32px, 7svh, 88px) clamp(28px, 5svh, 56px); }
  h1 { grid-column: 1; font-size: clamp(44px, min(6.4vw, 10svh), 96px); font-weight: 500; line-height: .98; letter-spacing: -.045em; }
  h1 em { font-style: italic; font-weight: 450; }
  .support { grid-column: 1; font-size: clamp(18px, 1.6vw, 22px); color: var(--muted); }
  .resume {
    grid-column: 2; grid-row: 1 / span 2; align-self: end;
    display: inline-flex; align-items: center; gap: 8px; min-height: 46px; padding: 0 20px; border-radius: 999px;
    font-size: 15px; font-weight: 500; color: var(--ink); text-decoration: none;
    background: color-mix(in srgb, var(--page) 60%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.6); backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .06), inset 0 1px 0 rgba(255, 255, 255, .5);
    transition: border-color .2s ease, color .2s ease, transform .2s var(--ease);
  }
  .resume:hover, .resume:focus-visible { color: var(--brand); border-color: var(--brand); }
  .resume:active { transform: scale(.97); }
  .resume span { transition: transform .25s var(--ease); }
  .resume:hover span { transform: translate(2px, -2px); }

  /* ---- timeline */
  .timeline { --gap: clamp(16px, 2vw, 28px); --head-w: calc((100% + var(--gap)) / 12 * 4); --line-x: calc(var(--head-w) - var(--gap) - 18px); position: relative; border-top: 1px solid var(--line); }
  .track { position: absolute; left: var(--line-x); top: 0; bottom: 0; width: 1px; background: var(--line); }
  .fill { position: absolute; left: 0; top: 0; width: 1px; height: 100%; background: var(--brand); transform: scaleY(0); transform-origin: 0 0; will-change: transform; }
  /* the crow: centred on the line, moved by the script below */
  .tl-crow { position: absolute; z-index: 2; top: 0; left: calc(var(--line-x) - 17px); line-height: 0; will-change: transform; }
  .tl-crow :global(.crow) { --crow-lens: var(--page); }
  .job { display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px); padding-block: clamp(40px, 8svh, 96px); border-bottom: 1px solid var(--line); }
  .job:last-child { border-bottom: 0; }
  .job-head { grid-column: 1 / span 4; position: sticky; top: calc(var(--hh, var(--header-height)) + 32px); align-self: start; padding-right: 48px; }
  .when { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: .01em; }
  h2 { margin-top: 6px; font-size: clamp(30px, 3.2vw, 46px); font-weight: 500; line-height: 1.04; letter-spacing: -.035em; }
  .role { margin-top: 6px; font-size: 17px; }
  .points { grid-column: 6 / -1; list-style: none; margin: 0; padding: 0; display: grid; gap: clamp(16px, 2.6svh, 26px); }
  .points li { max-width: 36em; font-size: clamp(18px, 1.5vw, 21px); line-height: 1.5; letter-spacing: -.008em; text-wrap: pretty; }
  .points strong { font-weight: 600; color: var(--brand); }
  .points em { font-style: italic; }

  /* ---- tools: quiet tiles, same family as the homepage testimonial grid */
  .tools { padding-top: clamp(72px, 12svh, 140px); }
  .section-title { font-size: clamp(30px, 3vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -.03em; margin-bottom: clamp(20px, 3svh, 32px); }
  .tool-grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 196px), 1fr)); gap: 12px; }
  .tool {
    display: flex; align-items: center; gap: 14px; min-height: 76px; padding: 14px 16px; border-radius: 16px;
    background: color-mix(in srgb, var(--ink) 3%, var(--page)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 6%, transparent);
    transition: transform .25s var(--ease), box-shadow .25s ease;
  }
  .tool:hover { transform: translateY(-2px); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--brand) 40%, transparent), 0 12px 24px -16px rgba(70, 30, 10, .35); }
  .tool-logo { width: 40px; height: 40px; flex: 0 0 auto; display: grid; place-items: center; border-radius: 10px; background: #fff; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06); }
  .tool-logo img { width: 30px; height: 30px; object-fit: contain; }
  .tool-mark { font-size: 15px; font-weight: 700; letter-spacing: -.04em; color: #1B1A17; }
  .tool-name { font-size: 15px; font-weight: 500; line-height: 1.3; }

  /* ---- competencies: one typographic line, orange italic separators */
  .comps { padding-block: clamp(72px, 12svh, 140px) clamp(48px, 8svh, 96px); }
  .comp-line { list-style: none; margin: 0; padding: 0; max-width: 40em; font-size: clamp(18px, 1.6vw, 23px); font-weight: 400; line-height: 1.55; letter-spacing: -.01em; }
  .comp-line li { display: inline; }
  .comp-line .c { white-space: nowrap; }
  .comp-line li:not(:last-child)::after { content: ' / '; font-style: italic; font-weight: 400; color: var(--brand); }

  /* ---- tablet and phone: natural scrolling, no pinning */
  @media (max-width: 820px) {
    .c-intro { grid-template-columns: 1fr; }
    .resume { grid-column: 1; grid-row: auto; justify-self: start; margin-top: 8px; }
    .timeline { --line-x: 13px; padding-left: 44px; }
    .tl-crow { left: 0; scale: .8; transform-origin: 50% 50%; }
    .job { display: block; padding-block: 36px; }
    .job-head { position: relative; top: auto; padding-right: 0; }
    .points { margin-top: 18px; }
    .points li { font-size: 17px; }
  }

</style>
