---
/**
 * Shared page shell for every page (home, About, Career, 404).
 * Holds the theme tokens, fonts, theme bootstrapping, header, closing quote and footer.
 */
import SiteHeader from '../components/SiteHeader.astro';
import SiteFooter from '../components/SiteFooter.astro';
import ClosingQuote from '../components/ClosingQuote.astro';
import GoogleAnalytics from '../components/GoogleAnalytics.astro';

interface Props {
  title: string;
  description: string;
  canonical?: string;
  ogImage?: string;
  ogImageAlt?: string;
  /** Optional separate description for social cards. */
  ogDescription?: string;
  ogType?: string;
  robots?: string;
  current?: string;
  analytics?: boolean;
  /** The closing quote + footer share one screen-high fold. On by default for every page. */
  endFold?: boolean;
  /** This page's closing quote; defaults to the homepage's. */
  quote?: { text: string; by: string };
}
const {
  title, description, canonical, ogImage, ogImageAlt, ogDescription, ogType = 'website',
  robots = 'index, follow', current, analytics = true, endFold = true, quote,
} = Astro.props;

// ---- site-wide identity, declared once for search engines and LLMs (every page links to it by @id)
const site = 'https://imkiruthika.in';
const profiles = [
  'https://www.linkedin.com/in/kiruthika-ramesh/',
  'https://github.com/kiruthika-r-01',
  'https://letterboxd.com/kirthika_/',
];
const identity = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite', '@id': site + '/#website', url: site + '/', name: 'Kiruthika Ramesh',
      inLanguage: 'en', publisher: { '@id': site + '/#person' },
    },
    {
      '@type': 'Person', '@id': site + '/#person', name: 'Kiruthika Ramesh', url: site + '/',
      image: site + '/images/kiruthika-portrait.webp', jobTitle: 'Marketing Generalist',
      email: 'mailto:kiruthikar0123@gmail.com',
      address: { '@type': 'PostalAddress', addressLocality: 'Chennai', addressCountry: 'IN' },
      knowsAbout: ['Content Marketing', 'SEO', 'AEO', 'Marketing Design', 'GTM', 'Email Marketing', 'Marketing Automation', 'Sales Enablement', 'Product Marketing'],
      sameAs: profiles,
    },
  ],
};
// every shared link gets a picture: the page's own, or the site's default card
const shareImage = ogImage ?? (robots.startsWith('noindex') ? undefined : site + '/og-home.png');
const shareAlt = ogImageAlt ?? (shareImage ? 'The white handwritten Kr. logo on a solid orange background.' : undefined);
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    {analytics && <GoogleAnalytics />}
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="robots" content={robots} />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta name="theme-color" content="#FFFFFF" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#171717" media="(prefers-color-scheme: dark)" />
    <meta name="author" content="Kiruthika Ramesh" />
    <!-- icons: a white "kr." on an orange tile, visible on light and dark browser tabs -->
    <link rel="icon" href="/favicon.ico" sizes="32x32 48x48" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="alternate" type="text/plain" href="/llms.txt" title="llms.txt" />
    {profiles.map((p) => <link rel="me" href={p} />)}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Schibsted+Grotesk:ital,wght@0,400..800;1,400..800&display=swap" rel="stylesheet" />
    <meta property="og:type" content={ogType} />
    <meta property="og:site_name" content="Kiruthika Ramesh" />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={ogDescription ?? description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {shareImage && <meta property="og:image" content={shareImage} />}
    {shareImage && <meta property="og:image:width" content="1200" />}
    {shareImage && <meta property="og:image:height" content="630" />}
    {shareAlt && <meta property="og:image:alt" content={shareAlt} />}
    <meta name="twitter:card" content={shareImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={ogDescription ?? description} />
    {shareImage && <meta name="twitter:image" content={shareImage} />}
    {shareAlt && <meta name="twitter:image:alt" content={shareAlt} />}
    <script type="application/ld+json" set:html={JSON.stringify(identity)} />
    <slot name="head" />
    <script is:inline>
      // Same rule and storage key as the rest of the site: system first, a manual choice wins and is remembered.
      (() => {
        let theme;
        try { theme = localStorage.getItem('site-theme'); } catch {}
        if (theme !== 'light' && theme !== 'dark') theme = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = theme;
      })();
    </script>
    <style is:global>
      :root {
        color-scheme: light;
        --page: #FFFFFF;
        --surface: #F4F1EC;
        --ink: #1B1A17;
        --muted: #6B6862;
        --line: #E6E2DB;
        --brand: #F94D03;
        --brand-ink: #C23C00;            /* orange that passes contrast as small text on white */
        --social-icon-filter: none;
        --logo-filter: none;
        /* Schibsted Grotesk: a newspaper grotesk, plain but with opinions. Used on every page. */
        --sans: 'Schibsted Grotesk', 'Google Sans Flex', Arial, sans-serif;
        --gutter: 40px;
        --max: 1260px;
        --header-height: 82px;
        --ease: cubic-bezier(.3, .7, .2, 1);
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --page: #171717;
        --surface: #222220;
        --ink: #F2EEE5;
        --muted: #B0ADA4;
        --line: #33332F;
        --brand: #FF6A2B;
        --brand-ink: #FF8A55;
        --social-icon-filter: invert(1);
        --logo-filter: invert(1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { background: var(--page); -webkit-text-size-adjust: 100%; overflow-x: clip; }
      body {
        margin: 0; background: var(--page); color: var(--ink);
        font-family: var(--sans); font-size: 18px; line-height: 1.6;
        -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility;
        transition: background-color .25s ease, color .25s ease;
      }
      h1, h2, h3, p, figure, blockquote, ul, ol { margin: 0; }
      img { display: block; max-width: 100%; height: auto; }
      button { font: inherit; color: inherit; }
      :focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; }
      .wrap { width: min(100% - 2 * var(--gutter), var(--max)); margin-inline: auto; }
      .skip-link { position: fixed; z-index: 50; top: 10px; left: 10px; padding: 10px 14px; transform: translateY(-160%); background: var(--ink); color: var(--page); border-radius: 2px; }
      .skip-link:focus { transform: none; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; border: 0; }
      @media (max-width: 1060px) { :root { --gutter: 28px; --header-height: 76px; } }
      /* below 820px the header has two rows (logo + swipeable links); the header script measures the exact height into --hh */
      @media (max-width: 820px) { :root { --header-height: 104px; } }
      @media (max-width: 620px) { :root { --gutter: 20px; } body { font-size: 16px; } }
      /* one fold = the screen below the header */
      /* dvh: at the very bottom phone toolbars are usually collapsed, so the closing fold follows the real screen height */
      .end-fold { min-height: calc(100svh - var(--hh, var(--header-height))); min-height: calc(100dvh - var(--hh, var(--header-height))); display: flex; flex-direction: column; scroll-snap-align: end; }
      .end-fold-main { flex: 1; display: grid; place-items: center; }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { transition-duration: .01ms !important; animation-duration: .01ms !important; scroll-behavior: auto !important; } }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <SiteHeader current={current} />
    <main id="main-content">
      <slot />
    </main>
    {endFold
      ? <div class="end-fold"><div class="end-fold-main"><ClosingQuote text={quote?.text} by={quote?.by} /></div><SiteFooter /></div>
      : <SiteFooter />}
  </body>
</html>
