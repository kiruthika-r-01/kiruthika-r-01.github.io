---
/**
 * One folder of Selected Works (/work/<slug>/). The folder's glass front becomes this page's header (view
 * transition from the landing), then the folder's sections, each in the layout chosen for it in Pages CMS:
 *   cards     projects: image, short account, links to the live work (a clear break between projects)
 *   tiles     glass cards, one per piece: its format, who it is for, the title, the company. Optional
 *             format filter, so a stranger can pick by what they want to see (a buyer's guide, a how-to...)
 *   matchups  glass cards for comparison / alternative pages: the head-to-head set large, filter by market
 *   archive   everything, as one frosted list, with company filters
 * Glass needs something to frost: a soft band of warm light sits behind each section of cards.
 * Kafka stands on the closing line with her remark about the folder. Sealed folders show her review instead.
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import Crow from '../../components/Crow.astro';
import { imageSize } from '../../lib/writings';
import { work, folders, companies, countLabel, companyOf, smallSrc, isExternal, countOf, type Folder, type WorkItem } from '../../lib/work';

export function getStaticPaths() {
  return folders.map((f) => ({ params: { folder: f.slug }, props: { f } }));
}
const { f } = Astro.props as { f: Folder };
const site = 'https://imkiruthika.in';
const url = `${site}/work/${f.slug}/`;
const others = folders.filter((o) => o.slug !== f.slug);
const empty = countOf(f) === 0;
const ext = (u?: string) => (isExternal(u) ? { target: '_blank', rel: 'noopener' } : {});
type Item = WorkItem & { format?: string; product?: string; rival?: string; market?: string };
// the companies that appear in this folder, in the order set in Pages CMS
const used = companies.filter((c) => f.groups.some((g) => g.items.some((i) => (i.company ?? '').includes(c.name))));
// logos look the same size when they cover the same area (a wide wordmark is shorter than a compact one)
const LOGO_AREA = 171 * 28;
const logoBox = (src?: string) => {
  const s = src ? imageSize(src) : null; if (!s) return null;
  const ratio = s.width / s.height; const h = Math.round(Math.min(44, Math.sqrt(LOGO_AREA / ratio)));
  return { width: Math.round(h * ratio), height: h };
};
const filtersOf = (items: Item[], key: 'format' | 'market' | 'company') => {
  const seen: string[] = [];
  items.forEach((i) => { const v = i[key]; if (v && !seen.includes(v)) seen.push(v); });
  return seen.map((v) => ({ v, n: items.filter((i) => i[key] === v).length }));
};
const readerOf = (i: Item) => companyOf(i.company)?.reader;
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url, url, name: `${f.name}: Selected Works by Kiruthika Ramesh`,
  description: f.seoDescription, isPartOf: { '@id': site + '/#website' }, author: { '@id': site + '/#person' },
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Selected Works', item: site + '/work/' },
    { '@type': 'ListItem', position: 3, name: f.name, item: url },
  ] },
};
---
<SiteLayout
  title={f.seoTitle ?? `${f.name} | Selected Works | Kiruthika Ramesh`}
  description={f.seoDescription ?? work.seo.description}
  canonical={url}
  current="Selected Works"
  quote={work.quote}
  ogImage={site + '/og-selected-works.png'}
  ogImageAlt="The white handwritten Kr. logo beside /selected works on a solid orange background."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <div class="wrap page">
    <header class="band">
      {f.peek && <img src={f.peek} srcset={smallSrc(f.peek) ? `${smallSrc(f.peek)} 750w, ${f.peek} 1500w` : undefined} sizes="100vw" alt="" width="1500" height="600" fetchpriority="high" decoding="async" />}
      <div class="plate" style={`view-transition-name: folder-${f.slug}`}>
        <a class="crumb" href="/work/">All folders</a>
        <h1>{f.name}</h1>
        {f.blurb && <p class="desc">{f.blurb}</p>}
      </div>
    </header>

    {!empty && used.length > 0 && f.groups.some((g) => g.layout === 'tiles' || g.layout === 'archive') && (
      <ul class="companies" role="list" aria-label="Companies">
        {used.map((c) => {
          const b = logoBox(c.logo);
          return (
            <li class="co">
              {c.logo && b ? <span class="logo"><img src={c.logo} alt={c.name} width={b.width} height={b.height} loading="lazy" decoding="async" /></span> : <span class="co-name">{c.name}</span>}
              <span class="co-text">
                {c.about && <span class="co-about">{c.about}</span>}
                {c.profile && <a class="co-link" href={c.profile} target="_blank" rel="noopener">{c.profileLabel ?? 'Author page'} <span aria-hidden="true">↗</span></a>}
              </span>
            </li>
          );
        })}
      </ul>
    )}

    {empty ? (
      <section class="sealed-note" aria-label="Status">
        <span class="stamp" aria-hidden="true">Under review</span>
        <p>{f.sealedNote}</p>
        <figure class="reviewer">
          <Crow size={5} mood="puzzled" label="Kafka, the crow who lives here" />
          <figcaption>{f.kafka}</figcaption>
        </figure>
      </section>
    ) : (
      <div class="body">
        {f.groups.map((g, gi) => {
          const items = g.items as Item[];
          const key = g.layout === 'matchups' ? 'market' : g.layout === 'archive' ? 'company' : 'format';
          const chips = (g as any).filter || g.layout === 'archive' ? filtersOf(items, key) : [];
          return (
            <section class:list={['group', `g-${g.layout}`]} aria-labelledby={`g-${gi}`} data-filterable={chips.length > 1 ? key : undefined}>
              <div class="g-head">
                <h2 id={`g-${gi}`}>{g.title}</h2>
                {g.note && <p class="g-note">{g.note}</p>}
              </div>

              {chips.length > 1 && (
                <div class="filters" role="group" aria-label={`Filter by ${key}`}>
                  <button type="button" aria-pressed="true" data-filter="">All <span>{items.length}</span></button>
                  {chips.map((c) => <button type="button" aria-pressed="false" data-filter={c.v}>{c.v} <span>{c.n}</span></button>)}
                </div>
              )}

              {g.layout === 'cards' && (
                <div class="projects">
                  {items.map((it, ii) => (
                    <article class="project">
                      {it.image && (
                        <figure class="shot">
                          <img src={it.image} srcset={smallSrc(it.image) ? `${smallSrc(it.image)} 750w, ${it.image} 1500w` : undefined} sizes="(max-width: 820px) 92vw, 55vw" alt={`${it.title}${it.company ? ', ' + it.company : ''}`} width="1500" height="600" loading={gi === 0 && ii === 0 ? 'eager' : 'lazy'} fetchpriority={gi === 0 && ii === 0 ? 'high' : undefined} decoding="async" />
                        </figure>
                      )}
                      <div class="p-text">
                        <p class="p-meta">{[it.kind, it.company].filter(Boolean).join(' · ')}</p>
                        <h3>{it.title}</h3>
                        {it.description && <p class="p-desc">{it.description}</p>}
                        <p class="p-links">
                          {it.url && <a class="pill" href={it.url} {...ext(it.url)}>{it.label ?? 'See it live'} <span aria-hidden="true">↗</span></a>}
                          {it.url2 && <a class="pill" href={it.url2} {...ext(it.url2)}>{it.label2 ?? 'More'} <span aria-hidden="true">↗</span></a>}
                        </p>
                      </div>
                    </article>
                  ))}
                </div>
              )}

              {(g.layout === 'tiles' || g.layout === 'list' || g.layout === 'by-company') && (
                <ul class="tiles" role="list">
                  {items.map((it) => (
                    <li class="tile-li" data-key={it.format}>
                      <a class="tile" href={it.url} {...ext(it.url)}>
                        <span class="t-top">{it.format && <span class="tag">{it.format}</span>}<span class="t-go" aria-hidden="true">↗</span></span>
                        <span class="t-title">{it.title}</span>
                        <span class="t-foot">
                          <span class="t-co">{it.company}</span>
                          {readerOf(it) && <span class="t-for">For {readerOf(it)}</span>}
                        </span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {g.layout === 'matchups' && (
                <ul class="tiles matchups" role="list">
                  {items.map((it) => (
                    <li class="tile-li" data-key={it.market}>
                      <a class="tile" href={it.url} {...ext(it.url)} title={it.title}>
                        <span class="t-top"><span class="tag">{it.kind}</span>{it.market && <span class="mkt">{it.market}</span>}<span class="t-go" aria-hidden="true">↗</span></span>
                        {it.product
                          ? <span class="vs">{it.product} <span class="vs-x">vs</span> {it.rival}</span>
                          : <span class="vs">{it.rival} <span class="vs-alt">{/pricing/i.test(it.kind ?? '') ? 'pricing and alternatives' : 'alternatives'}</span></span>}
                        <span class="t-foot"><span class="t-co">{it.company}</span></span>
                        <span class="sr-only">: {it.title}</span>
                      </a>
                    </li>
                  ))}
                </ul>
              )}

              {g.layout === 'archive' && (
                <ul class="ledger" role="list">
                  {items.map((it) => (
                    <li class="tile-li row" data-key={it.company}><a href={it.url} {...ext(it.url)}><span class="r-title">{it.title}</span><span class="r-meta">{[it.company, it.kind].filter(Boolean).join(' · ')}</span><span class="r-go" aria-hidden="true">↗</span></a></li>
                  ))}
                </ul>
              )}
              <p class="sr-only" aria-live="polite" data-filter-count></p>
            </section>
          );
        })}
      </div>
    )}

    {!empty && f.kafka && (
      <figure class="verdict">
        <span class="v-crow"><Crow size={3} label="Kafka, the crow who lives here" /></span>
        <figcaption>{f.kafka}</figcaption>
      </figure>
    )}

    <nav class:list={['others', { after: !empty && f.kafka }]} aria-labelledby="others-title">
      <h2 id="others-title">Other folders</h2>
      <ul role="list">
        {others.map((o) => (
          <li><a href={`/work/${o.slug}/`} style={`view-transition-name: folder-${o.slug}`}>{o.name}</a></li>
        ))}
      </ul>
    </nav>
  </div>
</SiteLayout>

<script>
  // filters: show one format / market / company, or all of them
  document.querySelectorAll<HTMLElement>('[data-filterable]').forEach((box) => {
    const items = Array.from(box.querySelectorAll<HTMLElement>('.tile-li'));
    const live = box.querySelector<HTMLElement>('[data-filter-count]');
    box.querySelectorAll<HTMLButtonElement>('[data-filter]').forEach((b) => b.addEventListener('click', () => {
      const v = b.dataset.filter ?? '';
      box.querySelectorAll('[data-filter]').forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      let shown = 0;
      items.forEach((i) => { const on = !v || i.dataset.key === v; i.hidden = !on; if (on) shown++; });
      if (live) live.textContent = `Showing ${shown}${v ? ': ' + v : ''}`;
    }));
  });
</script>

<style>
  .page { padding-block: clamp(16px, 3svh, 32px) clamp(56px, 10svh, 120px); }

  /* the header: the folder's cover as a band, the folder's front as a glass plate over it (Writings section style) */
  .band { position: relative; isolation: isolate; overflow: hidden; height: clamp(280px, 40svh, 460px); margin-top: clamp(4px, 1svh, 12px); border-radius: clamp(20px, 2.2vw, 30px); background: #E9D9C8; }
  /* the cover, blurred into a warm field (as article covers are), so the glass plate has colour and texture to frost */
  .band img { position: absolute; inset: 0; z-index: -2; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; filter: blur(22px) saturate(1.6) contrast(1.05); transform: scale(1.25); }
  .band::after {
    content: ''; position: absolute; inset: 0; z-index: -1; pointer-events: none;
    background: radial-gradient(60% 90% at 85% 15%, rgba(249, 77, 3, .38), transparent 70%), radial-gradient(70% 90% at 10% 100%, rgba(255, 170, 110, .45), transparent 70%), linear-gradient(160deg, rgba(255, 214, 170, .35), rgba(120, 50, 20, .25));
  }
  :global(:root[data-theme='dark']) .band img { filter: blur(22px) saturate(1.5) brightness(.55); }
  :global(:root[data-theme='dark']) .band::after { background: radial-gradient(60% 90% at 85% 15%, rgba(249, 77, 3, .42), transparent 70%), radial-gradient(70% 90% at 10% 100%, rgba(190, 80, 30, .4), transparent 70%), linear-gradient(160deg, rgba(60, 25, 10, .35), rgba(10, 6, 4, .45)); }
  .plate {
    position: absolute; left: clamp(10px, 1.2vw, 16px); bottom: clamp(10px, 1.2vw, 16px); width: min(600px, calc(100% - 2 * clamp(10px, 1.2vw, 16px)));
    display: flex; flex-direction: column; gap: 8px; padding: clamp(18px, 2.2vw, 30px);
    border-radius: clamp(14px, 1.6vw, 22px);
    background: color-mix(in srgb, var(--page) 64%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.5); backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 55%, transparent), inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
  }
  :global(:root[data-theme='dark']) .plate { background: color-mix(in srgb, var(--page) 58%, transparent); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .14), inset 0 0 0 1px rgba(255, 255, 255, .08); }
  .crumb { width: fit-content; font-size: 13px; color: color-mix(in srgb, var(--ink) 62%, transparent); text-decoration: none; }
  .crumb::before { content: '← '; }
  .crumb:hover, .crumb:focus-visible { color: var(--brand); }
  h1 { font-size: clamp(40px, min(5vw, 8svh), 80px); font-weight: 500; line-height: .95; letter-spacing: -.045em; }
  .desc { font-size: clamp(15px, 1.2vw, 17px); line-height: 1.45; color: color-mix(in srgb, var(--ink) 72%, transparent); }

  /* companies in this folder: logos the same visual size, one line each */
  .companies { list-style: none; margin: clamp(28px, 5svh, 48px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(260px, 1fr)); gap: 14px; }
  .co { display: flex; flex-direction: column; gap: 12px; padding: 18px 20px; border-radius: 18px; background: color-mix(in srgb, var(--page) 60%, transparent); -webkit-backdrop-filter: blur(18px); backdrop-filter: blur(18px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent); }
  :global(:root[data-theme='dark']) .co { background: linear-gradient(165deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .025) 45%); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .17), inset 0 0 0 1px rgba(255, 255, 255, .1); }
  .logo { display: inline-flex; align-items: center; width: fit-content; height: 64px; padding: 0 16px; border-radius: 12px; background: #fff; box-shadow: inset 0 0 0 1px rgba(0, 0, 0, .06); }
  .logo img { display: block; }
  .co-name { font-size: 20px; font-weight: 500; }
  .co-text { display: flex; flex-direction: column; gap: 6px; }
  .co-about { font-size: 15px; line-height: 1.45; color: var(--muted); }
  .co-link { width: fit-content; font-size: 14px; color: var(--ink); text-decoration: underline; text-decoration-color: var(--brand); text-underline-offset: .2em; }
  .co-link:hover { color: var(--brand-ink); }

  .body { position: relative; }
  .group { position: relative; isolation: isolate; padding-top: clamp(56px, 10svh, 112px); }
  .g-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 6px 24px; margin-bottom: clamp(16px, 2.6svh, 26px); }
  h2 { font-size: clamp(28px, 2.8vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -.03em; }
  .g-note { font-size: 15px; font-style: italic; color: var(--muted); }

  /* a soft band of warm light behind the glass (so the glass has something to frost) */
  .g-tiles::before, .g-matchups::before, .g-archive::before {
    content: ''; position: absolute; z-index: -1; inset: 30% -4% -6%; pointer-events: none; filter: blur(40px);
    background: radial-gradient(40% 50% at 18% 40%, rgba(255, 150, 90, .22), transparent 70%), radial-gradient(36% 46% at 82% 64%, rgba(249, 77, 3, .14), transparent 70%), radial-gradient(30% 40% at 52% 90%, rgba(255, 196, 140, .2), transparent 70%);
  }
  :global(:root[data-theme='dark']) .group::before { opacity: .7; }

  /* filters */
  .filters { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 20px; }
  .filters button {
    min-height: 40px; padding: 0 16px; border-radius: 999px; font: inherit; font-size: 14px; cursor: pointer; color: var(--ink);
    background: color-mix(in srgb, var(--page) 55%, transparent); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent); transition: border-color .2s ease, background .2s ease, color .2s ease;
  }
  .filters button span { margin-left: 4px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .filters button:hover { border-color: var(--brand); }
  .filters button[aria-pressed='true'] { background: var(--ink); color: var(--page); border-color: var(--ink); }
  :global(:root[data-theme='dark']) .filters button { border-color: rgba(255, 255, 255, .18); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .08); }
  :global(:root[data-theme='dark']) .filters button[aria-pressed='true'] { border-color: var(--ink); }
  .filters button[aria-pressed='true'] span { color: color-mix(in srgb, var(--page) 70%, transparent); }

  /* projects: image left, account right; a hairline and generous space between projects */
  .projects { display: grid; }
  .project { display: grid; grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr); gap: clamp(24px, 3.4vw, 56px); align-items: stretch; }
  .project + .project { margin-top: clamp(40px, 7svh, 72px); padding-top: clamp(40px, 7svh, 72px); border-top: 1px solid var(--line); }
  /* the image fills the height of the account beside it (never less than a comfortable size), so both edges line up */
  .shot { position: relative; margin: 0; min-height: 210px; overflow: hidden; border-radius: 18px; background: #F5F5F5; box-shadow: 0 30px 60px -44px rgba(40, 20, 8, .55); }
  .shot img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 50% 40%; transition: transform 1s var(--ease); }
  .p-text { display: flex; flex-direction: column; justify-content: center; }
  .project:hover .shot img { transform: scale(1.025); }
  .p-meta { font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--brand-ink); }
  h3 { margin-top: 8px; font-size: clamp(26px, 2.4vw, 36px); font-weight: 500; line-height: 1.08; letter-spacing: -.03em; }
  .p-desc { margin-top: 12px; font-size: clamp(16px, 1.2vw, 18px); line-height: 1.6; text-wrap: pretty; }
  .p-links { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 22px; }
  .pill {
    display: inline-flex; align-items: center; gap: 8px; min-height: 44px; padding: 0 18px; border-radius: 999px;
    font-size: 14px; font-weight: 500; color: var(--ink); text-decoration: none;
    background: color-mix(in srgb, var(--page) 60%, transparent);
    -webkit-backdrop-filter: blur(14px) saturate(1.6); backdrop-filter: blur(14px) saturate(1.6);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .06), inset 0 1px 0 rgba(255, 255, 255, .5);
    transition: border-color .2s ease, color .2s ease, transform .2s var(--ease);
  }
  .pill:hover, .pill:focus-visible { color: var(--brand); border-color: var(--brand); }
  .pill:active { transform: scale(.97); }

  /* glass tiles: one per piece, easy to scan */
  .tiles { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(auto-fill, minmax(min(100%, 280px), 1fr)); gap: 14px; }
  .tile {
    position: relative; height: 100%; min-height: 188px; display: flex; flex-direction: column; gap: 14px; padding: 20px 22px;
    border-radius: 20px; color: var(--ink); text-decoration: none;
    background: color-mix(in srgb, var(--page) 58%, transparent);
    -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent), 0 20px 40px -34px rgba(40, 20, 8, .5);
    transition: transform .35s var(--ease), box-shadow .35s ease;
  }
  :global(:root[data-theme='dark']) .tile { background: linear-gradient(165deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .025) 45%), color-mix(in srgb, var(--page) 55%, transparent); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .17), inset 0 0 0 1px rgba(255, 255, 255, .1), 0 24px 44px -32px rgba(0, 0, 0, .8); }
  :global(:root[data-theme='dark']) .tile:hover, :global(:root[data-theme='dark']) .tile:focus-visible { box-shadow: inset 0 1px 0 rgba(255, 255, 255, .2), inset 0 0 0 1px rgba(255, 106, 43, .45), 0 24px 44px -30px rgba(0, 0, 0, .85); }
  .tile:hover, .tile:focus-visible { transform: translateY(-3px); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 0 0 1px color-mix(in srgb, var(--brand) 45%, transparent), 0 26px 46px -34px rgba(40, 20, 8, .55); }
  .tile:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }
  .t-top { display: flex; flex-wrap: wrap; align-items: center; gap: 6px 8px; padding-right: 22px; position: relative; }
  .tag { white-space: nowrap; padding: 4px 10px; border-radius: 999px; font-size: 12px; font-weight: 500; letter-spacing: .02em; color: var(--brand-ink); background: color-mix(in srgb, var(--brand) 10%, transparent); }
  .mkt { font-size: 12px; white-space: nowrap; color: var(--muted); }
  .t-go { position: absolute; right: 0; top: 2px; color: var(--muted); transition: transform .25s var(--ease), color .2s ease; }
  .tile:hover .t-go { color: var(--brand); transform: translate(2px, -2px); }
  .t-title { font-size: clamp(18px, 1.35vw, 20px); font-weight: 500; line-height: 1.3; letter-spacing: -.012em; text-wrap: pretty; }
  .t-foot { margin-top: auto; display: flex; flex-direction: column; gap: 2px; font-size: 13px; }
  .t-co { font-weight: 500; }
  .t-for { color: var(--muted); }

  /* head-to-heads: read like the other cards (the same title size), "vs" in orange between the names */
  .vs { overflow-wrap: anywhere; font-size: clamp(18px, 1.35vw, 20px); font-weight: 500; line-height: 1.3; letter-spacing: -.012em; }
  .vs-x { font-size: .85em; font-style: italic; font-weight: 400; color: var(--brand-ink); }
  .vs-alt { font-weight: 400; font-style: italic; color: var(--muted); }
  .matchups .tile { min-height: 150px; }

