---
import home from '../data/home.json';

const siteUrl = 'https://imkiruthika.in/';
const portfolioUrl = 'https://ripe-stoat-21e.notion.site/Kiruthika-Ramesh-Portfolio-b938168891d8823892b08165cdc90adf?pvs=74';
const resumeUrl = 'https://drive.google.com/file/d/1aCFHSqvPiBWr9Y2mzTP71CKIsD_AvyIh/view?usp=drive_link';
const linkedInUrl = 'https://www.linkedin.com/in/kiruthika-ramesh/';
const email = 'kiruthikar0123@gmail.com';
const title = 'Kiruthika Ramesh | Marketing Generalist';
const description = 'Kiruthika Ramesh is a high-agency marketing generalist working across B2B and SaaS marketing, content, SEO, AEO, GTM, product marketing, marketing automation, and design.';
const paragraphs = home.essay.split('\n\n');
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: 'Kiruthika Ramesh',
  url: siteUrl,
  jobTitle: 'Marketing Generalist',
  email: `mailto:${email}`,
  sameAs: [linkedInUrl, portfolioUrl]
};
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#f7f6f2" />
    <meta name="description" content={description} />
    <meta name="robots" content="index, follow" />
    <title>{title}</title>
    <link rel="canonical" href={siteUrl} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;450;500;550;600;650;700;750&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kiruthika Ramesh" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={siteUrl} />
    <meta property="og:image" content={`${siteUrl}og-image.png`} />
    <meta property="og:image:alt" content="Kiruthika Ramesh, marketing generalist" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={`${siteUrl}og-image.png`} />
    <script type="application/ld+json" set:html={JSON.stringify(personSchema)} />
    <style>
      :root {
        color-scheme: light;
        --paper: #f7f6f2;
        --ink: #24251f;
        --muted: #74746b;
        --line: #d9d8cf;
        --accent: #f94d03;
        --sans: 'Inter', ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', sans-serif;
      }
      * { box-sizing: border-box; }
      html { background: var(--paper); scroll-behavior: smooth; }
      body { margin: 0; background: var(--paper); color: var(--ink); font-family: var(--sans); font-size: 15px; line-height: 1.6; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; }
      a { color: inherit; text-decoration: none; }
      a:focus-visible { outline: 2px solid var(--accent); outline-offset: 5px; }
      .page { width: min(100% - 72px, 1240px); margin: 0 auto; }
      .topbar { display: flex; align-items: center; justify-content: space-between; gap: 24px; padding: 18px 0 15px; border-bottom: 1px solid var(--line); font-size: 12px; letter-spacing: .025em; }
      .wordmark { font-weight: 750; letter-spacing: .055em; text-transform: uppercase; white-space: nowrap; }
      .header-actions { display: flex; align-items: center; gap: clamp(18px, 3.5vw, 42px); }
      .resume-link, .text-link { display: inline-flex; align-items: center; gap: 7px; text-underline-offset: 5px; }
      .resume-link:hover, .text-link:hover { text-decoration: underline; text-decoration-color: var(--accent); text-decoration-thickness: 1px; }
      .arrow { width: 12px; height: 12px; flex: 0 0 auto; }
      .availability { display: inline-flex; align-items: center; gap: 8px; white-space: nowrap; color: var(--muted); }
      .availability-dot { width: 7px; height: 7px; background: var(--accent); border-radius: 50%; }
      main { padding: clamp(38px, 6.3vh, 62px) 0 0; }
      .hero { min-height: min(650px, calc(100svh - 58px)); display: flex; flex-direction: column; justify-content: center; padding-bottom: clamp(30px, 5vh, 52px); }
      .eyebrow { margin: 0 0 20px; color: var(--accent); font-size: 11px; font-weight: 750; letter-spacing: .105em; text-transform: uppercase; }
      h1 { max-width: 1080px; margin: 0; font-size: clamp(39px, 4.8vw, 66px); font-weight: 600; letter-spacing: -.065em; line-height: 1.08; text-wrap: balance; }
      .intro-grid { display: block; max-width: 850px; margin-top: clamp(22px, 3.5vh, 34px); }
      .intro-copy { max-width: 800px; }
      .intro { margin: 0; color: #4f5048; font-size: clamp(15px, 1.25vw, 17px); line-height: 1.72; max-width: 800px; }
      .personal-note { margin: 10px 0 0; color: var(--muted); font-size: 13px; line-height: 1.65; }
      .links { display: flex; align-items: center; gap: 24px; margin-top: 18px; }
      .text-link { position: relative; font-size: 13px; font-weight: 600; padding: 3px 0 5px; }
      .text-link::after { content: ''; position: absolute; left: 0; right: 18px; bottom: 0; height: 1px; background: var(--accent); opacity: 0; transition: opacity 160ms ease; }
      .text-link:hover::after { opacity: 1; }
      .essay-section { display: grid; grid-template-columns: minmax(230px, .72fr) minmax(0, 1.28fr); gap: clamp(36px, 7vw, 100px); align-items: start; min-height: min(720px, 100svh); padding: clamp(30px, 5vh, 48px) 0 46px; border-top: 1px solid var(--line); }
      .essay-heading { position: sticky; top: 28px; }
      .section-kicker { margin: 0 0 15px; color: var(--accent); font-size: 10px; font-weight: 750; letter-spacing: .12em; text-transform: uppercase; }
      h2 { margin: 0; font-size: clamp(27px, 3.1vw, 42px); font-weight: 600; letter-spacing: -.055em; line-height: 1.15; }
      .essay { columns: 2; column-gap: clamp(24px, 3.4vw, 48px); }
      .essay p { break-inside: avoid; margin: 0 0 15px; color: #44453f; font-size: 14px; line-height: 1.72; }
      .essay p:last-child { margin-bottom: 0; }
      .site-note { display: grid; grid-template-columns: minmax(0, 1fr) minmax(240px, 430px); gap: 42px; align-items: start; margin-top: 0; padding: clamp(30px, 5vh, 46px) 0 clamp(42px, 6vh, 54px); border-top: 1px solid var(--line); }
      .site-note h2 { max-width: 420px; font-size: clamp(27px, 3vw, 38px); }
      .site-note p { margin: 3px 0 0; color: #55564e; font-size: 14px; line-height: 1.75; }
      .footer-quote { width: min(100% - 72px, 1240px); margin: 0 auto; padding: clamp(38px, 5.5vh, 50px) 0 clamp(34px, 4.5vh, 42px); text-align: center; border-top: 1px solid var(--line); }
      .footer-quote blockquote { margin: 0; font-size: 16px; font-weight: 550; line-height: 1.45; }
      .footer-quote figcaption { display: inline; margin-left: 10px; color: var(--muted); font-size: 12px; }
      footer { display: grid; grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr); align-items: center; gap: 16px 28px; padding: 20px 0 26px; border-top: 1px solid var(--line); color: var(--muted); font-size: 13px; }
      .footer-meta, .footer-links { display: flex; align-items: center; gap: 20px; min-width: 0; }
      .footer-meta { display: contents; }
      .footer-meta > span { grid-column: 1; justify-self: start; }
      .clock { grid-column: 2; justify-self: center; }
      .footer-links { grid-column: 3; justify-content: flex-end; }
      .footer-links a:hover { color: var(--ink); text-decoration: underline; text-decoration-color: var(--accent); text-underline-offset: 4px; }
      .clock { color: var(--accent); font-variant-numeric: tabular-nums; white-space: nowrap; font-weight: 600; text-align: center; }
      @media (min-width: 1000px) and (min-height: 700px) {
        .hero { min-height: calc(100svh - 80px); }
        .essay-section { min-height: 100svh; }
      }
      @media (max-width: 900px) {
        .page { width: min(100% - 48px, 1240px); }
        h1 { font-size: clamp(38px, 6.2vw, 58px); }
        .essay-section { grid-template-columns: minmax(180px, .65fr) minmax(0, 1.35fr); gap: 30px; }
        .essay { columns: 1; }
      }
      @media (max-width: 640px) {
        .page { width: min(100% - 36px, 1240px); }
        .topbar { align-items: flex-start; padding: 16px 0 14px; font-size: 11px; }
        .header-actions { flex-wrap: wrap; justify-content: flex-end; gap: 8px 14px; }
        .availability { font-size: 10px; }
        .resume-link { font-size: 10px; }
        main { padding-top: 40px; }
        .hero { min-height: auto; padding-bottom: 38px; }
        h1 { font-size: clamp(36px, 9.3vw, 52px); letter-spacing: -.06em; }
        .intro-grid { margin-top: 22px; }
        .intro { font-size: 15px; }
        .personal-note { font-size: 12px; }
        .links { gap: 22px; margin-top: 15px; }
        .essay-section { display: block; min-height: auto; padding: 26px 0 34px; }
        .essay-heading { position: static; margin-bottom: 24px; }
        h2 { font-size: 31px; }
        .essay { columns: 1; }
        .essay p { font-size: 14px; line-height: 1.75; margin-bottom: 15px; }
        .site-note { grid-template-columns: 1fr; gap: 12px; padding: 28px 0 26px; }
        .site-note p { font-size: 14px; }
        .footer-quote { width: min(100% - 36px, 1240px); margin-bottom: 0; padding: 34px 0 30px; }
        .footer-quote blockquote { font-size: 15px; }
        .footer-quote figcaption { display: block; margin: 5px 0 0; }
        footer { grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 18px 12px; padding: 18px 0 24px; font-size: 12px; }
        .footer-meta > span { grid-column: 1; grid-row: 1; }
        .clock { grid-column: 1 / -1; grid-row: 2; justify-self: center; }
        .footer-links { grid-column: 2; grid-row: 1; gap: 16px; }
      }
      @media (prefers-reduced-motion: reduce) { *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; } }
    </style>
  </head>
  <body>
    <div class="page">
      <header class="topbar">
        <a class="wordmark" href="/" aria-label="Kiruthika Ramesh home">{home.siteName}</a>
        <nav class="header-actions" aria-label="Header links">
          <a class="resume-link" href={resumeUrl} target="_blank" rel="noreferrer">Résumé <svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
          <span class="availability"><span class="availability-dot" aria-hidden="true"></span>Available to work</span>
        </nav>
      </header>

      <main>
        <section class="hero" aria-labelledby="intro-heading">
          <p class="eyebrow">{home.eyebrow}</p>
          <h1 id="intro-heading">{home.headline}</h1>
          <div class="intro-grid">
            <div class="intro-copy">
              <p class="intro">{home.intro}</p>
              <p class="personal-note">{home.personalNote}</p>
            </div>
            <nav class="links" aria-label="Selected links">
              <a class="text-link" href={portfolioUrl} target="_blank" rel="noreferrer">{home.worksLabel}<svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
              <a class="text-link" href={`mailto:${email}`}>{home.contactLabel}<svg class="arrow" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M4 12 12 4M5 4h7v7" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" /></svg></a>
            </nav>
          </div>
        </section>

        <section class="essay-section" aria-labelledby="essay-heading">
          <div class="essay-heading">
            <p class="section-kicker">A small thought on time</p>
            <h2 id="essay-heading">{home.essayTitle}</h2>
          </div>
          <div class="essay">
            {paragraphs.map((paragraph) => <p>{paragraph}</p>)}
          </div>
        </section>

        <section class="site-note" aria-labelledby="site-note-heading">
          <h2 id="site-note-heading">{home.siteSectionTitle}</h2>
          <p>{home.siteSectionCopy}</p>
        </section>
      </main>

      <figure class="footer-quote">
        <blockquote>“{home.footerQuote}”</blockquote>
        <figcaption>— {home.footerQuoteAttribution}</figcaption>
      </figure>

      <footer>
        <div class="footer-meta">
          <span>© <span id="copyright-year">2026</span> Kiruthika Ramesh</span>
          <time class="clock" id="india-clock" datetime="">Chennai · IST</time>
        </div>
        <nav class="footer-links" aria-label="Social and contact links">
          <a href={linkedInUrl} target="_blank" rel="noreferrer">LinkedIn</a>
          <a href={`mailto:${email}`}>Email</a>
        </nav>
      </footer>
    </div>
    <script>
      const clock = document.querySelector('#india-clock');
      const year = document.querySelector('#copyright-year');
      const updateClock = () => {
        const now = new Date();
        if (clock) {
          clock.textContent = `${new Intl.DateTimeFormat('en-IN', { hour: 'numeric', minute: '2-digit', hour12: true, timeZone: 'Asia/Kolkata' }).format(now)} IST`;
          clock.setAttribute('datetime', now.toISOString());
        }
        if (year) year.textContent = new Intl.DateTimeFormat('en-IN', { year: 'numeric', timeZone: 'Asia/Kolkata' }).format(now);
      };
      updateClock();
      window.setInterval(updateClock, 30_000);
    </script>
  </body>
</html>
