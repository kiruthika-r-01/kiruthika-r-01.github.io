---
/**
 * The closing quote that sits centred directly above the footer.
 * Pages can pass their own quote; otherwise it falls back to the homepage's (text from home.json).
 */
import home from '../data/home.json';

interface Props { text?: string; by?: string }
const { text = home.footerQuote, by = home.footerQuoteAttribution } = Astro.props;
---
<figure class="wrap closing">
  <blockquote>“{text}”</blockquote>
  <figcaption>{by}</figcaption>
</figure>

<style>
  .closing { display: grid; place-content: center; margin: 0 auto; padding-block: 32px; text-align: center; }
  .closing blockquote { max-width: 34em; margin: 0 auto 6px; font-size: clamp(16px, 2.4svh, 20px); line-height: 1.5; text-wrap: balance; }
  .closing figcaption { font-size: 13px; color: var(--muted); }
  .closing figcaption::before { content: '— '; }
</style>
