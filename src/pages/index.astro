---
import home from '../data/home.json';
import SiteFooter from '../components/SiteFooter.astro';
const greeting = "Hi, I'm Kiruthika.";
const introCopy = home.intro.startsWith(greeting) ? home.intro.slice(greeting.length).trimStart() : home.intro;
const introduction = [...introCopy.split('\n\n'), home.personalNote].filter(Boolean);
const portfolioUrl = 'https://ripe-stoat-21e.notion.site/Kiruthika-Ramesh-Portfolio-b938168891d8823892b08165cdc90adf?pvs=74';
const emailUrl = 'mailto:kiruthikar123@gmail.com';
const githubUrl = 'https://github.com/kiruthika-r-01';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F7F6F2" />
    <meta name="description" content="I'm Kiruthika Ramesh, a high-agency marketing generalist working across content, SEO, GTM, sales enablement, and design. I use AI and code to explore better marketing workflows." />
    <meta name="robots" content="index, follow" />
    <title>Kiruthika Ramesh | High Agency Marketing Generalist</title>
    <link rel="canonical" href="https://imkiruthika.in/" />
    <link rel="icon" type="image/svg+xml" href="/kr-favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,100..1000&family=Caveat:wght@400;500;600&display=swap" rel="stylesheet" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="Kiruthika Ramesh" />
    <meta property="og:title" content="Kiruthika Ramesh | High Agency Marketing Generalist" />
    <meta property="og:description" content="A high-agency marketing generalist working across content, SEO, GTM, sales enablement, and design. Exploring AI and code to build better marketing workflows." />
    <meta property="og:url" content="https://imkiruthika.in/" />
    <meta property="og:image" content="https://imkiruthika.in/og-home.png" />
    <meta property="og:image:alt" content="The white handwritten Kr. logo centered on a solid orange background." />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content="Kiruthika Ramesh | High Agency Marketing Generalist" />
    <meta name="twitter:description" content="A high-agency marketing generalist working across content, SEO, GTM, sales enablement, and design." />
    <meta name="twitter:image" content="https://imkiruthika.in/og-home.png" />
    <meta name="twitter:image:alt" content="The white handwritten Kr. logo centered on a solid orange background." />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('site-theme');
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : systemPrefersDark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
        --page: #F7F6F2;
        --surface: #eee8dc;
        --ink: #24231f;
        --muted: #67655e;
        --line: #d8d2c6;
        --brand: #F94D03;
        --social-icon-filter: none;
        --sans: 'Google Sans Flex', 'Google Sans', Arial, sans-serif;
        --hand: 'Caveat', cursive;
        --header-height: 82px;
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --page: #171815;
        --surface: #20211d;
        --ink: #f2eee5;
        --muted: #b0ada4;
        --line: #3b3c35;
        --social-icon-filter: invert(1);
        --logo-filter: invert(1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { scroll-behavior: smooth; background: var(--page); }
      body { margin: 0; background: var(--page); color: var(--ink); font-family: var(--sans); font-size: 17px; line-height: 1.68; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; transition: background-color 180ms ease, color 180ms ease; }
      button, a { -webkit-tap-highlight-color: transparent; }
      button:focus-visible { outline: 2px solid var(--brand); outline-offset: 5px; }
      .skip-link { position: fixed; z-index: 20; top: 10px; left: 10px; padding: 10px 14px; transform: translateY(-150%); background: var(--ink); color: var(--page); }
      .skip-link:focus { transform: translateY(0); }
      .site-header { position: sticky; z-index: 10; top: 0; height: var(--header-height); border-bottom: 1px solid var(--line); background: var(--page); }
      .header-inner { width: min(100% - 80px, 1380px); height: 100%; margin: 0 auto; display: flex; align-items: center; gap: clamp(20px, 3vw, 44px); }
      .brand { display: inline-flex; align-items: center; flex: 0 0 auto; line-height: 0; }
      .brand img { display: block; width: 75px; height: 58px; object-fit: contain; filter: var(--logo-filter, none); }
      .primary-nav { display: flex; align-items: center; justify-content: flex-end; gap: clamp(14px, 2.1vw, 30px); flex: 1; }
      .primary-nav a { position: relative; white-space: nowrap; font-size: 14px; font-weight: 500; line-height: 1.2; }
      .primary-nav a:not([aria-disabled='true']):hover::after { transform: scaleX(1); }
      .primary-nav a::after { content: ''; position: absolute; right: 0; bottom: -7px; left: 0; height: 2px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 160ms ease; }
      .primary-nav a[data-placeholder] { color: var(--muted); }
      .nav-soon { display: none; position: absolute; top: 18px; right: 0; color: var(--muted); font-size: 9px; letter-spacing: .04em; }
      .primary-nav a[data-placeholder] .nav-soon { display: block; }
      .theme-toggle { width: 58px; height: 34px; position: relative; display: inline-flex; align-items: center; flex: 0 0 auto; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); cursor: pointer; }
      .switch-thumb { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; color: var(--brand); background: var(--page); transform: translateX(0); transition: transform 180ms ease, background-color 180ms ease; }
      :root[data-theme='dark'] .switch-thumb { transform: translateX(23px); }
      .cat-icon { width: 18px; height: 18px; overflow: visible; }
      .cat-icon path, .cat-icon circle { fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
      .cat-awake, .cat-sleep { transition: opacity 140ms ease; }
      .cat-sleep { opacity: 0; }
      :root[data-theme='dark'] .cat-awake { opacity: 0; }
      :root[data-theme='dark'] .cat-sleep { opacity: 1; }
      .mobile-menu-button { display: none; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; }
      .mobile-menu-button svg { width: 20px; height: 20px; }
      .mobile-menu-button path { stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
      main { width: min(100% - 80px, 1260px); margin: 0 auto; }
      .hero { position: relative; min-height: min(760px, calc(100svh - var(--header-height))); display: grid; grid-template-columns: minmax(0, 1.08fr) minmax(0, .92fr); align-items: center; gap: clamp(44px, 7vw, 104px); padding: 50px 0 72px; }
      .hero-copy { max-width: 660px; }
      h1, h2, h3, p, figure, blockquote { margin-top: 0; }
      h1 { max-width: 690px; margin-bottom: 30px; font-size: 64px; font-weight: 650; line-height: 1.04; letter-spacing: -.065em; text-wrap: balance; }
      .intro-copy { max-width: 615px; }
      .intro-copy p { margin: 0 0 15px; font-size: 17px; line-height: 1.68; }
      .intro-greeting { font-family: var(--hand); font-size: 24px; font-weight: 600; line-height: 1; color: var(--brand); }
      .hero-actions { display: flex; flex-wrap: wrap; align-items: center; gap: 14px 27px; margin-top: 30px; }
      .hero-link { min-height: 47px; display: inline-flex; align-items: center; gap: 10px; border-bottom: 1px solid var(--line); font-size: 16px; font-weight: 600; transition: border-color 150ms ease, color 150ms ease; }
      .hero-link:hover { border-color: var(--brand); color: var(--brand); }
      .hero-link svg { width: 15px; height: 15px; flex: 0 0 auto; }
      .hero-link svg path { fill: none; stroke: currentColor; stroke-width: 1.5; stroke-linecap: round; stroke-linejoin: round; }
      .coming-soon { padding: 3px 7px; border-radius: 999px; color: var(--ink); background: color-mix(in srgb, var(--brand) 16%, var(--page)); font-size: 11px; font-weight: 500; }
      .hero-portrait { width: min(100%, 420px); justify-self: end; margin: 0; align-self: center; }
      .hero-portrait img { display: block; width: 100%; height: auto; max-height: 320px; aspect-ratio: 1.61; object-fit: cover; object-position: 43% 45%; -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 12%, #000 75%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0%, #000 16%, #000 84%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 12%, #000 75%, transparent 100%); mask-composite: intersect; }

      .recommendations { padding: 79px 0 45px; border-top: 1px solid var(--line); }
      .section-intro { max-width: 720px; margin-bottom: 55px; }
      .section-kicker { margin: 0 0 13px; color: var(--muted); font-size: 14px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; }
      h2 { margin-bottom: 12px; font-size: 40px; font-weight: 600; line-height: 1.13; letter-spacing: -.05em; text-wrap: balance; }
      .handwritten-title { color: var(--brand); font-family: var(--hand); font-size: 1.16em; font-weight: 600; letter-spacing: 0; text-transform: capitalize; }
      .section-intro > p:last-child { max-width: 650px; margin: 0; color: var(--muted); font-size: 17px; line-height: 1.6; }
      .testimonial-layout { display: grid; grid-template-columns: minmax(0, 370px) minmax(0, 1fr); gap: clamp(32px, 5vw, 64px); align-items: start; padding-top: 10px; }
      .testimonial-person { min-width: 0; }
      .portrait-stage { position: relative; width: min(100%, 370px); aspect-ratio: 1 / 1; margin-bottom: 25px; }
      .portrait-stage img { display: block; width: 100%; height: 100%; object-fit: cover; object-position: 50% 50%; }
      .testimonial-switches { display: flex; gap: 10px; margin-top: 18px; }
      .testimonial-switch { width: 48px; height: 48px; display: grid; place-items: center; overflow: hidden; padding: 3px; border: 1px solid var(--line); border-radius: 50%; background: var(--surface); cursor: pointer; transition: border-color 150ms ease, background-color 150ms ease; }
      .testimonial-switch img { display: block; width: 100%; height: 100%; border-radius: 50%; object-fit: cover; object-position: 50% 42%; }
      .testimonial-switch.is-selected { border-color: var(--brand); background: var(--brand); }
      .person-attribution h3 { margin: 0 0 4px; font-size: 26px; font-weight: 600; line-height: 1.2; letter-spacing: -.025em; }
      .person-attribution p { margin: 0; color: var(--muted); font-size: 14px; line-height: 1.5; }
      .testimonial-content { min-width: 0; max-width: 760px; }
      .testimonial-panel[hidden] { display: none; }
      .testimonial-highlight { width: 100%; max-width: 100%; margin: 0 0 9px; color: var(--brand); font-family: var(--hand); font-size: clamp(30px, 2.5vw, 34px); font-weight: 600; line-height: 1.15; }
      blockquote.testimonial-quote { width: 100%; margin: 0; padding: 0; }
      .testimonial-quote p { margin: 0 0 17px; font-size: 17px; line-height: 1.68; }
      .testimonial-quote p:last-child { margin-bottom: 0; }
      .murakami-quote { margin: 35px auto 0; padding: 43px 24px 47px; border-top: 1px solid var(--line); text-align: center; }
      .murakami-quote blockquote { max-width: 750px; margin: 0 auto 8px; color: var(--ink); font-size: 14px; line-height: 1.55; }
      .murakami-quote figcaption { color: var(--muted); font-size: 13px; }
      .sr-only { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0; }
      @media (max-width: 1060px) {
        :root { --header-height: 76px; }
        .header-inner, main { width: min(100% - 56px, 1260px); }
        .primary-nav { gap: clamp(12px, 1.55vw, 20px); }
        .primary-nav a { font-size: 13px; }
        .brand img { width: 68px; }
        .hero { gap: 42px; }
        h1 { font-size: 54px; }
      }
      @media (max-width: 820px) {
        .header-inner { gap: 14px; }
        .primary-nav { display: none; position: absolute; top: calc(var(--header-height) - 1px); right: 0; left: 0; align-items: stretch; padding: 15px 28px 23px; border-bottom: 1px solid var(--line); background: var(--page); }
        .primary-nav.is-open { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
        .primary-nav a { min-height: 46px; display: flex; align-items: center; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
        .primary-nav a::after { display: none; }
        .nav-soon { position: static; display: inline !important; margin-left: 12px; font-size: 10px; }
        .mobile-menu-button { display: inline-flex; margin-left: auto; }
        .hero { min-height: initial; grid-template-columns: minmax(0, 1fr) minmax(0, .9fr); gap: 30px; padding: 67px 0 78px; }
        h1 { font-size: 47px; }
        .intro-copy p { font-size: 16px; }
        .hero-actions { gap: 10px 21px; }
        .testimonial-layout { grid-template-columns: 1fr; gap: 34px; }
        .testimonial-person { display: grid; grid-template-columns: minmax(170px, 250px) minmax(0, 1fr); align-items: end; gap: 22px; }
        .portrait-stage { width: 100%; margin-bottom: 0; }
      }
      @media (max-width: 620px) {
        :root { --header-height: 70px; }
        body { font-size: 16px; }
        .header-inner, main { width: min(100% - 40px, 1260px); }
        .brand img { width: 62px; height: 50px; }
        .header-inner { gap: 12px; }
        .theme-toggle { order: 3; }
        .mobile-menu-button { order: 2; }
        .primary-nav { padding-right: 20px; padding-left: 20px; }
        .hero { display: flex; flex-direction: column; align-items: stretch; gap: 18px; padding: 46px 0 57px; }
        .hero-copy { display: contents; }
        h1 { order: 1; max-width: 540px; margin: 0 0 2px; font-size: 40px; line-height: 1.07; }
        .hero-portrait { order: 2; width: 100%; max-width: 420px; margin: 0 auto 4px; }
        .hero-portrait img { max-height: 290px; aspect-ratio: 1.61; object-position: 43% 45%; -webkit-mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 92%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 7%, #000 78%, transparent 100%); -webkit-mask-composite: source-in; mask-image: linear-gradient(to right, transparent 0%, #000 12%, #000 92%, transparent 100%), linear-gradient(to bottom, transparent 0%, #000 7%, #000 78%, transparent 100%); mask-composite: intersect; }
        .intro-copy { order: 3; max-width: 560px; }
        .intro-copy p { margin-bottom: 14px; font-size: 16px; line-height: 1.65; }
        .intro-greeting { font-size: 22px; }
        .hero-actions { order: 4; gap: 8px 21px; margin-top: 12px; }
        .hero-link { min-height: 44px; font-size: 15px; }
        .recommendations { padding: 58px 0 27px; }
        .section-intro { margin-bottom: 34px; }
        .section-kicker { font-size: 13px; }
        h2 { margin-bottom: 11px; font-size: 30px; }
        .section-intro > p:last-child { font-size: 16px; }
        .testimonial-person { grid-template-columns: 1fr; gap: 17px; }
        .portrait-stage { width: min(100%, 340px); justify-self: center; }
        .person-attribution h3 { font-size: 23px; }
        .testimonial-layout { gap: 31px; }
        .testimonial-highlight { margin-bottom: 8px; font-size: clamp(24px, 5.8vw, 27px); line-height: 1.2; }
        .testimonial-quote p { margin-bottom: 15px; font-size: 16px; line-height: 1.67; }
        .murakami-quote { margin-top: 22px; padding: 34px 0 38px; }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
      }
    </style>
    <script type="application/ld+json">
      {
        "@context": "https://schema.org",
        "@type": "Person",
        "name": "Kiruthika Ramesh",
        "url": "https://imkiruthika.in/",
        "jobTitle": "Marketing Generalist",
        "description": "High-agency marketing generalist working across content, SEO, go-to-market strategy, sales enablement, and design, with an interest in AI-assisted marketing workflows."
      }
    </script>  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Kiruthika Ramesh home">
          <img src="/kr-logo.svg" alt="" width="75" height="58" />
        </a>
        <button class="mobile-menu-button" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" /></svg>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation">
          <a href="/about/">About</a>
          <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Career" aria-label="Career, coming soon">Career <span class="nav-soon" aria-hidden="true">Soon</span></a>
          <a href={portfolioUrl}>Selected Works</a>
          <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Writings" aria-label="Writings, coming soon">Writings <span class="nav-soon" aria-hidden="true">Soon</span></a>
          <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Shelf" aria-label="Shelf, coming soon">Shelf <span class="nav-soon" aria-hidden="true">Soon</span></a>
          <a href={emailUrl}>Contact</a>
        </nav>
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Switch to dark theme" title="Switch to dark theme">
          <span class="switch-thumb" aria-hidden="true">
            <svg class="cat-icon" viewBox="0 0 24 24">
              <path d="M5 10 4.2 5.2 9 7.5a8 8 0 0 1 6 0l4.8-2.3L19 10a7 7 0 1 1-14 0Z" />
              <path class="cat-awake" d="M8.3 11v1.1m7.4-1.1v1.1M9.6 15c1.4 1.1 3.4 1.1 4.8 0M5.8 13.2 3.8 12.7m14.4.5 2-.5" />
              <path class="cat-sleep" d="M7.9 12.1q1-.9 2 0m4.2 0q1-.9 2 0m-5.1 2.8q1.5 1 3 0m3.4-8.2h2l-2 2h2" />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main id="main-content">
      <section class="hero" aria-labelledby="hero-title">
        <div class="hero-copy">
          <h1 id="hero-title">{home.headline}</h1>
          <div class="intro-copy">
            {introduction.map((paragraph, index) => (
              <p>{index === 0 ? <><span class="intro-greeting">{greeting}</span>{' '}{paragraph}</> : paragraph}</p>
            ))}
          </div>
          <nav class="hero-actions" aria-label="Featured destinations">
            <a class="hero-link" href={portfolioUrl}>Selected work <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M3 13 13 3M5 3h8v8" /></svg></a>
            <a class="hero-link" href="#ai-lab" data-placeholder="AI lab &amp; notes" aria-disabled="true" aria-label="AI lab and notes, destination in progress">AI lab &amp; notes <span class="coming-soon" aria-hidden="true">In progress</span></a>
          </nav>
        </div>
        <figure class="hero-portrait">
          <img src="/images/kiruthika-portrait.png" alt="Kiruthika smiling in a pink sweater at a café" width="1024" height="635" fetchpriority="high" />
        </figure>

      </section>

      <section class="recommendations" aria-labelledby="recommendations-title">
        <div class="section-intro">
          <p class="section-kicker">Testimonials</p>
          <h2 id="recommendations-title">Good words from <span class="handwritten-title">good people.</span></h2>
          <p>A couple of people I've worked with have been kind enough to share what that experience was like.</p>
        </div>

        <div class="testimonial-layout" data-active-testimonial="karthik">
          <div class="testimonial-person">
            <div class="portrait-stage">
              <img id="testimonial-portrait" src="/images/karthik-kamalakannan-portrait.png" alt="Portrait of Karthik Kamalakannan" width="800" height="800" loading="lazy" decoding="async" />
            </div>
            <div class="person-attribution" aria-live="polite">
              <h3 id="testimonial-name">Karthik Kamalakannan</h3>
              <p id="testimonial-role">CEO &amp; Co-Founder</p>
              <p id="testimonial-company">Skcript</p>
            </div>
            <div class="testimonial-switches" role="group" aria-label="Choose a testimonial">
              <button class="testimonial-switch is-selected" type="button" data-testimonial-switch="karthik" data-portrait="/images/karthik-kamalakannan-portrait.png" data-name="Karthik Kamalakannan" data-role="CEO &amp; Co-Founder" data-company="Skcript" aria-label="Show Karthik Kamalakannan's testimonial" aria-pressed="true"><img src="/images/karthik-kamalakannan-portrait.png" alt="" width="800" height="800" loading="lazy" decoding="async" /></button>
              <button class="testimonial-switch" type="button" data-testimonial-switch="swathy" data-portrait="/images/swathy-ravisankar-portrait.png" data-name="Swathy Ravisankar" data-role="Customer Success Manager" data-company="Skcript" aria-label="Show Swathy Ravisankar's testimonial" aria-pressed="false"><img src="/images/swathy-ravisankar-portrait.png" alt="" width="800" height="800" loading="lazy" decoding="async" /></button>
            </div>
          </div>

          <div class="testimonial-content" aria-live="polite" aria-atomic="true">
            <article class="testimonial-panel" data-testimonial-panel="karthik" aria-labelledby="karthik-highlight">
              <p class="testimonial-highlight" id="karthik-highlight">“I have rarely seen anyone who would go out of their way to get things done.”</p>
              <blockquote class="testimonial-quote">
                <p>Working with Kiruthika has been a really good experience.</p>
                <p>Kiruthika is a really good deep thinker and I have rarely seen anyone who would go out of their way to get things done. She created her own industry-standard design that helps us push our branding up a notch.</p>
                <p>Anyone who is going to be working with her, remember that she can get things done and she takes ownership of what she needs to get done. That's a great startup attitude to have.</p>
                <p>Kiruthika, I wish you all the very best for your future. 👏</p>
              </blockquote>
            </article>
            <article class="testimonial-panel" data-testimonial-panel="swathy" aria-labelledby="swathy-highlight" hidden>
              <p class="testimonial-highlight" id="swathy-highlight">“From day one, her creativity stood out. She had a knack for coming up with innovative ideas for our content strategies and marketing campaigns.”</p>
              <blockquote class="testimonial-quote">
                <p>I had the pleasure of working with Kiruthika at Skcript, and I can wholeheartedly recommend her for any future opportunities. 😃</p>
                <p>From day one, her creativity stood out. She had a knack for coming up with innovative ideas for our content strategies and marketing campaigns. Collaborating with her was not only productive but also a lot of fun.</p>
                <p>Kiruthika is not just a talented marketer - she's also an amazing designer. Her skills in both areas make her a real asset to any team. I genuinely enjoyed working with her and wish her all the best in her future endeavors!</p>
              </blockquote>
            </article>
          </div>
        </div>
      </section>

      <figure class="murakami-quote">
        <blockquote>“{home.footerQuote}”</blockquote>
        <figcaption>— {home.footerQuoteAttribution}</figcaption>
      </figure>
    </main>

    <SiteFooter />

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        const mobileMenuButton = document.querySelector('.mobile-menu-button');
        const navigation = document.querySelector('#primary-navigation');
        const status = document.querySelector('#placeholder-status');
        const testimonialLayout = document.querySelector('.testimonial-layout');
        const testimonialName = document.querySelector('#testimonial-name');
        const testimonialRole = document.querySelector('#testimonial-role');
        const testimonialCompany = document.querySelector('#testimonial-company');
        const testimonialPortrait = document.querySelector('#testimonial-portrait');
        const testimonialPanels = [...document.querySelectorAll('[data-testimonial-panel]')];
        const themePreference = window.matchMedia('(prefers-color-scheme: dark)');
        let statusTimer;

        const showPlaceholder = (messageOrLink) => {
          status.textContent = typeof messageOrLink === 'string'
            ? messageOrLink
            : messageOrLink.dataset.placeholder + ' page is coming later.';
          status.classList.add('is-visible');
          window.clearTimeout(statusTimer);
          statusTimer = window.setTimeout(() => status.classList.remove('is-visible'), 2600);
        };

        const updateToggle = () => {
          const isDark = root.dataset.theme === 'dark';
          toggle.setAttribute('aria-checked', String(isDark));
          toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
          toggle.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        };

        updateToggle();
        toggle.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          try { localStorage.setItem('site-theme', nextTheme); } catch {}
          updateToggle();
        });

        themePreference.addEventListener('change', (event) => {
          try { if (localStorage.getItem('site-theme')) return; } catch {}
          root.dataset.theme = event.matches ? 'dark' : 'light';
          updateToggle();
        });

        mobileMenuButton.addEventListener('click', () => {
          const open = mobileMenuButton.getAttribute('aria-expanded') !== 'true';
          mobileMenuButton.setAttribute('aria-expanded', String(open));
          mobileMenuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
          navigation.classList.toggle('is-open', open);
        });

        navigation.addEventListener('click', (event) => {
          const link = event.target.closest('[data-placeholder]');
          if (link) {
            event.preventDefault();
            showPlaceholder(link);
            return;
          }
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          mobileMenuButton.setAttribute('aria-label', 'Open navigation');
          navigation.classList.remove('is-open');
        });
        navigation.addEventListener('keydown', (event) => {
          const link = event.target.closest('[data-placeholder]');
          if (link && event.key === 'Enter') {
            event.preventDefault();
            showPlaceholder(link);
          }
        });

        document.querySelector('.hero-actions').addEventListener('click', (event) => {
          const link = event.target.closest('[data-placeholder]');
          if (!link) return;
          event.preventDefault();
          showPlaceholder('AI lab & notes is in progress.');
        });

        document.querySelectorAll('[data-testimonial-switch]').forEach((button) => {
          button.addEventListener('click', () => {
            const selected = button.dataset.testimonialSwitch;
            testimonialLayout.dataset.activeTestimonial = selected;
            testimonialName.textContent = button.dataset.name;
            testimonialRole.textContent = button.dataset.role;
            testimonialCompany.textContent = button.dataset.company;
            testimonialPortrait.src = button.dataset.portrait;
            testimonialPortrait.alt = 'Portrait of ' + button.dataset.name;
            document.querySelectorAll('[data-testimonial-switch]').forEach((switchButton) => {
              const isSelected = switchButton === button;
              switchButton.classList.toggle('is-selected', isSelected);
              switchButton.setAttribute('aria-pressed', String(isSelected));
            });
            testimonialPanels.forEach((panel) => {
              panel.hidden = panel.dataset.testimonialPanel !== selected;
            });
          });
        });

      })();
    </script>
  </body>
</html>
