---
/**
 * Homepage: introduction, testimonials, then closing quote + footer. Nothing else on purpose.
 * Each part is exactly one fold: it fills the screen below the header on every device and scales
 * its type and image to fit (svh units), so nothing spills into the next screen.
 * Introduction idea, "the fog clears": the portrait sits behind frosted glass with one clear patch
 * over her face. The patch opens on load and follows the pointer, like wiping a misted window.
 * Copy comes from src/data/home.json or the existing approved testimonials.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import home from '../data/home.json';

const greeting = "Hi, I'm Kiruthika.";
const introCopy = home.intro.startsWith(greeting) ? home.intro.slice(greeting.length).trimStart() : home.intro;
const intro = introCopy.split('\n\n').map((p) => p.trim()).filter(Boolean);
const portfolioUrl = 'https://ripe-stoat-21e.notion.site/Kiruthika-Ramesh-Portfolio-b938168891d8823892b08165cdc90adf?pvs=74';

// `hl` is the phrase inside each quote that gets the orange accent.
const testimonials = [
  {
    id: 'karthik', name: 'Karthik Kamalakannan', role: 'CEO & Co-Founder, Skcript',
    portrait: '/images/karthik-kamalakannan-portrait.png',
    quote: 'I have rarely seen anyone who would go out of their way to get things done.',
    hl: 'go out of their way to get things done',
  },
  {
    id: 'swathy', name: 'Swathy Ravisankar', role: 'Customer Success Manager, Skcript',
    portrait: '/images/swathy-ravisankar-portrait.png',
    quote: 'From day one, her creativity stood out. She had a knack for coming up with innovative ideas for our content strategies and marketing campaigns.',
    hl: 'her creativity stood out',
  },
];
const split = (q: string, h: string) => { const i = q.indexOf(h); return i < 0 ? [q, '', ''] : [q.slice(0, i), h, q.slice(i + h.length)]; };
const tiles = Array.from({ length: 20 });

const structuredData = {
  '@context': 'https://schema.org', '@type': 'Person', '@id': 'https://imkiruthika.in/#person',
  name: 'Kiruthika Ramesh', url: 'https://imkiruthika.in/', jobTitle: 'Marketing Generalist',
};
---
<SiteLayout
  title="Kiruthika Ramesh | High Agency Marketing Generalist"
  description="I'm Kiruthika Ramesh, a high-agency marketing generalist working across content, SEO, GTM, sales enablement, and design. I use AI and code to explore better marketing workflows."
  canonical="https://imkiruthika.in/"
  ogImage="https://imkiruthika.in/og-home.png"
  ogImageAlt="The white handwritten Kr. logo centered on a solid orange background."
  endFold
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- Fold 1: introduction -->
  <section class="wrap fold intro" aria-labelledby="intro-title">
    <p class="hello">{greeting}</p>
    <h1 id="intro-title">{home.headline}</h1>
    <div class="intro-copy">
      {intro.map((p) => <p>{p}</p>)}
      <p class="quiet">{home.personalNote}</p>
      <p class="intro-links">
        <a href={portfolioUrl}>{home.worksLabel} <span aria-hidden="true">↗</span></a>
        <a href="/resume.pdf" target="_blank" rel="noopener">Résumé <span class="sr-only">(PDF, opens in a new tab)</span><span aria-hidden="true">↗</span></a>
      </p>
    </div>
    <figure class="window" data-window>
      <img src="/images/kiruthika-portrait.png" alt="Kiruthika smiling in a pink sweater at a café" width="1024" height="635" fetchpriority="high" decoding="async" />
      <span class="fog" aria-hidden="true"></span>
    </figure>
  </section>

  <!-- Future: tools section goes here, between the introduction and the testimonials (as its own fold). -->

  <!-- Fold 2: testimonials -->
  <section class="wrap fold words" aria-labelledby="words-title">
    <h2 id="words-title">Good words from good people.</h2>
    <div class="words-stage">
      <div class="tiles">
        {tiles.map(() => <span class="tile" aria-hidden="true"></span>)}
        <div class="people" role="tablist" aria-label="Choose a testimonial">
          {testimonials.map((t, i) => (
            <button class="face" type="button" role="tab" id={`tab-${t.id}`} aria-controls="words-quote"
              aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} data-id={t.id}
              style={`view-transition-name: face-${t.id}`}>
              <img src={t.portrait} alt="" width="800" height="800" decoding="async" />
              <span class="sr-only">{t.name}</span>
            </button>
          ))}
        </div>
      </div>
      <figure class="quote" id="words-quote" role="tabpanel" aria-live="polite">
        <span class="quote-mark" aria-hidden="true">“</span>
        <div class="quote-bodies">
          {testimonials.map((t, i) => {
            const [a, h, b] = split(t.quote, t.hl);
            return (
              <div class="quote-body" data-for={t.id} data-on={i === 0 ? '' : undefined} aria-hidden={i === 0 ? undefined : 'true'}>
                <blockquote><p>{a}<em class="hl">{h}</em>{b}</p></blockquote>
                <figcaption><span class="who">{t.name}</span><span class="role">{t.role}</span></figcaption>
              </div>
            );
          })}
        </div>
        <div class="quote-nav">
          <button class="nav-btn" type="button" data-step="-1" aria-label="Previous testimonial"><span aria-hidden="true">←</span></button>
          <button class="nav-btn" type="button" data-step="1" aria-label="Next testimonial"><span aria-hidden="true">→</span></button>
        </div>
      </figure>
    </div>
  </section>

  <!-- Fold 3: the closing quote + footer come from the shared layout -->
</SiteLayout>

<style>
  /* gentle snapping so each fold lands whole; native and easy to scroll past */
  :global(html) { scroll-snap-type: y proximity; }
  .fold {
    min-height: calc(100svh - var(--hh, var(--header-height)));
    scroll-snap-align: start; scroll-margin-top: var(--hh, var(--header-height));
  }
  .quiet { color: var(--muted); }

  /* ------------------------------------------------------------ fold 1: introduction */
  .intro {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px);
    align-content: center; padding-block: clamp(16px, 4svh, 48px);
  }
  /* the one orange moment of the fold */
  .hello { grid-column: 1 / -1; margin-bottom: clamp(8px, 1.6svh, 14px); font-size: clamp(18px, 2.6svh, 21px); font-weight: 600; letter-spacing: -.01em; color: var(--brand); }
  h1 {
    grid-column: 1 / -1; max-width: 13em;
    font-size: clamp(34px, min(6.2vw, 9.2svh), 92px); font-weight: 500; line-height: 1; letter-spacing: -.042em; text-wrap: balance;
  }
  .intro-copy { grid-column: 1 / span 5; grid-row: 3; align-self: start; margin-top: clamp(20px, 5svh, 64px); max-width: 30em; font-size: clamp(15px, min(1.25vw, 2.25svh), 18px); line-height: 1.55; }
  .intro-copy p + p { margin-top: .75em; }
  .intro-links { display: flex; flex-wrap: wrap; gap: 4px 26px; margin-top: 1.3em !important; font-size: 16px; }
  /* one underline only; orange appears on hover, focus and press */
  .intro-links a {
    display: inline-flex; align-items: center; gap: .35em; min-height: 40px; font-weight: 500;
    color: var(--ink); text-decoration: none; border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    transition: border-color .2s ease, color .2s ease;
  }
  .intro-links a:hover, .intro-links a:focus-visible, .intro-links a:active { color: var(--brand); border-color: var(--brand); }
  .intro-links a span[aria-hidden] { transition: transform .25s var(--ease); }
  .intro-links a:hover span[aria-hidden] { transform: translate(2px, -2px); }

  /* the misted window */
  @property --clear { syntax: '<percentage>'; inherits: false; initial-value: 0%; }
  .window {
    /* same row as the text, stretched to exactly its height: tops and bottoms line up */
    grid-column: 7 / -1; grid-row: 3; align-self: stretch; position: relative; margin: clamp(20px, 5svh, 64px) 0 0;
    min-height: 220px; overflow: hidden; border-radius: clamp(18px, 2vw, 28px);
    background: var(--surface);
    box-shadow: 0 1px 0 rgba(255, 255, 255, .6) inset, 0 30px 60px -40px rgba(30, 20, 10, .5);
    isolation: isolate; touch-action: pan-y;
  }
  .window img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; object-position: 54% 40%; }
  .fog {
    --fx: 54%; --fy: 38%;
    position: absolute; inset: 0; z-index: 1;
    background: color-mix(in srgb, #fff 16%, transparent);
    -webkit-backdrop-filter: blur(16px) saturate(1.15); backdrop-filter: blur(16px) saturate(1.15);
    -webkit-mask: radial-gradient(circle at var(--fx) var(--fy), transparent 0 var(--clear), #000 calc(var(--clear) + 16%));
    mask: radial-gradient(circle at var(--fx) var(--fy), transparent 0 var(--clear), #000 calc(var(--clear) + 16%));
    animation: clear-fog 1.6s .25s cubic-bezier(.3, .7, .2, 1) forwards;
  }
  :root[data-theme='dark'] .fog { background: color-mix(in srgb, #000 18%, transparent); }
  @keyframes clear-fog { to { --clear: 24%; } }
  @media (prefers-reduced-motion: reduce) { .fog { animation: none; --clear: 24%; } }

  /* ------------------------------------------------------------ fold 2: testimonials */
  .words { display: flex; flex-direction: column; justify-content: center; padding-block: clamp(16px, 4svh, 48px); }
  h2 { font-size: clamp(26px, min(3vw, 4.6svh), 40px); font-weight: 500; line-height: 1.1; letter-spacing: -.03em; }
  .words-stage {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); column-gap: clamp(16px, 2vw, 28px); align-items: center;
    margin-top: clamp(16px, 4svh, 48px);
  }
  /* a quiet grid of empty tiles that fades out at its edges; the chosen person is lifted out of it */
  .tiles {
    --cell: clamp(44px, min(6.6vw, 10.4svh), 92px); --gap: clamp(8px, .9vw, 12px);
    grid-column: 1 / span 6; position: relative;
    display: grid; grid-template-columns: repeat(5, var(--cell)); grid-auto-rows: var(--cell); gap: var(--gap);
    justify-content: center; padding-block: 8px;
    -webkit-mask: radial-gradient(ellipse 62% 66% at 50% 50%, #000 52%, transparent 100%);
    mask: radial-gradient(ellipse 62% 66% at 50% 50%, #000 52%, transparent 100%);
  }
  .tile { border-radius: 14px; background: color-mix(in srgb, var(--ink) 3%, var(--page)); box-shadow: inset 0 0 0 1px color-mix(in srgb, var(--ink) 6%, transparent); }
  .people { display: contents; }
  .face { position: relative; z-index: 1; padding: 0; border: 0; cursor: pointer; overflow: hidden; background: var(--surface); border-radius: 14px; -webkit-tap-highlight-color: transparent; }
  .face img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 38%; }
  .face::after { content: ''; position: absolute; inset: 0; border-radius: inherit; box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22), inset 0 1px 0 rgba(255, 255, 255, .35); pointer-events: none; }
  .face[aria-selected='true'] {
    grid-column: 2 / span 2; grid-row: 2 / span 2; border-radius: 18px;
    box-shadow: 0 24px 48px -18px rgba(70, 30, 10, .45), 0 8px 18px -10px rgba(249, 77, 3, .35);
  }
  .face[aria-selected='false'] { grid-column: 4; grid-row: 3; filter: grayscale(1); opacity: .55; transition: opacity .25s ease, filter .25s ease, transform .25s var(--ease); }
  .face[aria-selected='false']:hover { opacity: .9; filter: grayscale(.2); transform: translateY(-2px); }
  .face:focus-visible { outline: 2px solid var(--brand); outline-offset: 3px; }

  .quote { grid-column: 8 / -1; margin: 0; }
  .quote-mark { display: block; height: .5em; margin-bottom: 4px; font-size: clamp(52px, 8svh, 72px); line-height: 1; color: color-mix(in srgb, var(--ink) 22%, transparent); }
  /* both quotes share one grid cell, so switching never changes the height */
  .quote-bodies { display: grid; }
  .quote-body { grid-area: 1 / 1; visibility: hidden; opacity: 0; view-transition-name: none; }
  .quote-body[data-on] { visibility: visible; opacity: 1; view-transition-name: words-quote; }
  .quote blockquote { margin: 0; }
  .quote blockquote p { font-size: clamp(19px, min(2.1vw, 3.4svh), 28px); font-weight: 450; line-height: 1.32; letter-spacing: -.018em; text-wrap: pretty; }
  .hl { font-style: normal; font-weight: 600; color: var(--brand); }
  .quote figcaption { display: flex; flex-wrap: wrap; gap: 2px 10px; margin-top: clamp(12px, 2svh, 18px); font-size: 14px; color: var(--muted); }
  .who { color: var(--ink); font-weight: 600; }
  .quote-nav { display: flex; gap: 10px; margin-top: clamp(16px, 3svh, 28px); }
  .nav-btn {
    width: 40px; height: 40px; display: grid; place-items: center; padding: 0; border-radius: 50%; cursor: pointer;
    color: var(--ink); font-size: 16px;
    background: color-mix(in srgb, var(--page) 60%, transparent);
    -webkit-backdrop-filter: blur(12px) saturate(1.6); backdrop-filter: blur(12px) saturate(1.6);
    border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    box-shadow: 0 1px 2px rgba(0, 0, 0, .06), inset 0 1px 0 rgba(255, 255, 255, .5);
    transition: transform .2s var(--ease), border-color .2s ease, color .2s ease;
  }
  .nav-btn:hover, .nav-btn:focus-visible { border-color: var(--brand); color: var(--brand); }
  .nav-btn:active { transform: scale(.94); }

  ::view-transition-group(*) { animation-duration: .5s; animation-timing-function: cubic-bezier(.3, .7, .2, 1); }

  /* ------------------------------------------------------------ responsive */
  @media (max-width: 1060px) {
    .intro-copy { grid-column: 1 / span 6; }
    .window { grid-column: 7 / -1; }
    .tiles { grid-column: 1 / span 7; }
    .quote { grid-column: 8 / -1; }
  }
  @media (max-width: 820px) {
    .intro-copy, .window, .tiles, .quote { grid-column: 1 / -1; }
    .window { grid-row: 3; align-self: auto; width: 100%; min-height: 0; height: clamp(120px, 24svh, 300px); margin-top: clamp(16px, 3svh, 32px); }
    .intro-copy { grid-row: 4; margin-top: clamp(14px, 3svh, 32px); max-width: 36em; }
    .quote { margin-top: clamp(16px, 3svh, 32px); }
    .tiles { --cell: clamp(48px, min(14vw, 10svh), 92px); }
  }
  @media (max-width: 620px) {
    /* phones: everything scales with the screen height so the introduction always fits one screen */
    .intro, .words { padding-block: clamp(8px, 1.8svh, 20px); }
    .hello { font-size: 17px; margin-bottom: 6px; }
    h1 { font-size: clamp(29px, min(10.4vw, 5.8svh), 46px); line-height: .98; }
    .window { height: clamp(84px, 14svh, 200px); margin-top: clamp(10px, 1.8svh, 24px); border-radius: 16px; }
    .window img { object-position: 54% 30%; }
    .intro-copy { margin-top: clamp(10px, 1.8svh, 24px); font-size: clamp(13.5px, 2svh, 16px); line-height: 1.45; }
    .intro-copy p + p { margin-top: .6em; }
    .intro-links { margin-top: .9em !important; font-size: 15px; }
    .intro-links a { min-height: 36px; }
    h2 { font-size: clamp(20px, 6vw, 26px); }
    .words-stage { margin-top: clamp(10px, 2svh, 24px); }
    .quote { margin-top: clamp(10px, 2svh, 24px); }
    .quote-nav { margin-top: clamp(10px, 2svh, 24px); }
    /* phone: 4 columns x 3 rows of tiles */
    .tiles { --cell: clamp(40px, min(19vw, 8svh), 84px); --gap: 8px; grid-template-columns: repeat(4, var(--cell)); }
    .tiles .tile:nth-of-type(n+8) { display: none; }
    .face[aria-selected='true'] { grid-row: 1 / span 2; }
    .face[aria-selected='false'] { grid-column: 4; grid-row: 2; }
    .quote-mark { font-size: 44px; }
    .quote blockquote p { font-size: clamp(16px, 2.5svh, 21px); }
  }
</style>

<script>
  // ---- misted window: the clear patch follows the pointer (mouse/pen only), drifts back to the face
  const win = document.querySelector<HTMLElement>('[data-window]');
  const fog = win?.querySelector<HTMLElement>('.fog');
  const reduce = matchMedia('(prefers-reduced-motion: reduce)');
  if (win && fog && !reduce.matches) {
    const home = { x: 54, y: 38 };
    let target = { ...home }, pos = { ...home }, raf = 0;
    const step = () => {
      pos.x += (target.x - pos.x) * 0.12; pos.y += (target.y - pos.y) * 0.12;
      fog.style.setProperty('--fx', pos.x.toFixed(2) + '%');
      fog.style.setProperty('--fy', pos.y.toFixed(2) + '%');
      raf = Math.abs(target.x - pos.x) + Math.abs(target.y - pos.y) > 0.05 ? requestAnimationFrame(step) : 0;
    };
    const go = () => { if (!raf) raf = requestAnimationFrame(step); };
    win.addEventListener('pointermove', (e) => {
      if (e.pointerType === 'touch') return;
      const r = win.getBoundingClientRect();
      target = { x: ((e.clientX - r.left) / r.width) * 100, y: ((e.clientY - r.top) / r.height) * 100 };
      go();
    });
    win.addEventListener('pointerleave', () => { target = { ...home }; go(); });
  }

  // ---- testimonials: click/tap a face, arrow buttons, or arrow keys on the faces
  const faces = Array.from(document.querySelectorAll<HTMLButtonElement>('.face'));
  const bodies = Array.from(document.querySelectorAll<HTMLElement>('.quote-body'));
  const ids = faces.map((f) => f.dataset.id!);
  let current = 0;
  const render = (i: number) => {
    current = (i + ids.length) % ids.length;
    faces.forEach((f, k) => { const on = k === current; f.setAttribute('aria-selected', String(on)); f.tabIndex = on ? 0 : -1; });
    bodies.forEach((b) => {
      const on = b.dataset.for === ids[current];
      b.toggleAttribute('data-on', on);
      if (on) b.removeAttribute('aria-hidden'); else b.setAttribute('aria-hidden', 'true');
    });
  };
  const show = (i: number, focus = false) => {
    if (((i + ids.length) % ids.length) === current) return;
    const doc = document as Document & { startViewTransition?: (cb: () => void) => unknown };
    if (doc.startViewTransition && !reduce.matches) doc.startViewTransition(() => render(i));
    else render(i);
    if (focus) faces[current].focus();
  };
  faces.forEach((f, i) => {
    f.addEventListener('click', () => show(i));
    f.addEventListener('keydown', (e) => {
      const d = e.key === 'ArrowRight' || e.key === 'ArrowDown' ? 1 : e.key === 'ArrowLeft' || e.key === 'ArrowUp' ? -1 : 0;
      if (d) { e.preventDefault(); show(current + d, true); }
    });
  });
  document.querySelectorAll<HTMLButtonElement>('.nav-btn').forEach((b) => b.addEventListener('click', () => show(current + Number(b.dataset.step))));
</script>
