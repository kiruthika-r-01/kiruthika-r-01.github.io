---
/**
 * Footer: a dark plate inset from the page edges. Links and details sit small at the top;
 * the sign-off line is set huge and low-contrast, cropped by the plate's bottom edge.
 * Behind the line: a low, realistic sun and its glow, setting into the plate edge. The line sits in front as a
 * dark silhouette; the crow perches on one of its letters, a silhouette too, with the sun showing through its glasses.
 * "Open to work" sits quietly with the details, on a small bobbing sailboat. Shared by every page.
 */
import '../styles/site.css';
import Crow from './Crow.astro';

interface Props { line?: string }
// The sign-off line. Its size scales with its length so it always spans the plate.
const { line: signoff = 'See it through.' } = Astro.props;
const size = Math.min(24, 225 / signoff.length).toFixed(2);
// ...but never taller than the screen allows: on short windows the line (and so the plate) shrinks with the height,
// so the closing quote and the footer always share one screen
const sz = `min(${size}cqi, 18svh)`;
// The crow perches on a flat-topped tall letter (b d h k l) nearest the middle; t or f if there is none.
const mid = (signoff.length - 1) / 2;
const nearest = (set: string) => { let k = -1; for (let i = 0; i < signoff.length; i++) if (set.includes(signoff[i]) && (k < 0 || Math.abs(i - mid) < Math.abs(k - mid))) k = i; return k; };
let at = nearest('bdhkl');
if (at < 0) at = nearest('tf');
if (at < 0) at = Math.floor(mid);
const before = signoff.slice(0, at), letter = signoff[at], after = signoff.slice(at + 1);
const portfolioUrl = 'https://ripe-stoat-21e.notion.site/Kiruthika-Ramesh-Portfolio-b938168891d8823892b08165cdc90adf?pvs=74';
// "Ask AI about me": opens each assistant with the same question, pointing it at the site and its llms.txt
// (ChatGPT and Claude read ?q=; Gemini has no prefill link, so its link also copies the question to paste)
const askPrompt = 'Who is Kiruthika Ramesh? Summarise her work and experience in marketing using https://imkiruthika.in and https://imkiruthika.in/llms.txt';
const q = encodeURIComponent(askPrompt);
const assistants = [
  { name: 'ChatGPT', href: `https://chatgpt.com/?q=${q}` },
  { name: 'Claude', href: `https://claude.ai/new?q=${q}` },
  { name: 'Gemini', href: `https://gemini.google.com/app?q=${q}`, copy: true },
];
const now = new Date();
const buildIstTime = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: true }).format(now);
---
<footer class="site-footer">
  <div class="plate">
    <div class="plate-top">
      <nav class="col" aria-labelledby="ft-site">
        <span class="col-label" id="ft-site">Site</span>
        <a href="/about/">About</a>
        <a href="/career/">Career</a>
        <a href={portfolioUrl}>Selected Works</a>
        <a href="/writings/">Writings</a>
        <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Shelf" aria-label="Shelf, coming soon">Shelf <span class="soon" aria-hidden="true">Soon</span></a>
      </nav>
      <nav class="col" aria-labelledby="ft-else">
        <span class="col-label" id="ft-else">Elsewhere</span>
        <a href="mailto:kiruthikar0123@gmail.com">Email <span aria-hidden="true">↗</span></a>
        <a href="https://www.linkedin.com/in/kiruthika-ramesh/" target="_blank" rel="noopener noreferrer">LinkedIn <span aria-hidden="true">↗</span></a>
        <a href="https://github.com/kiruthika-r-01" target="_blank" rel="noopener noreferrer">GitHub <span aria-hidden="true">↗</span></a>
        <a href="https://letterboxd.com/kirthika_/" target="_blank" rel="noopener noreferrer">Letterboxd <span aria-hidden="true">↗</span></a>
        <a href="/writings/rss.xml" title="Follow new writing in a feed reader">RSS <span aria-hidden="true">↗</span></a>
      </nav>
      <!-- third section: for AI assistants (ask about me, and the plain-text guide they read) -->
      <div class="col col-ai" role="group" aria-labelledby="ask-ai">
        <span class="col-label" id="ask-ai">Ask AI about me</span>
        <span class="ai-links">
          {assistants.map((a) => (
            <a href={a.href} target="_blank" rel="noopener" data-ask-copy={a.copy ? askPrompt : undefined}
              aria-label={`Ask ${a.name} about Kiruthika (opens in a new tab)`}>{a.name} <span aria-hidden="true">↗</span></a>
          ))}
          <a class="llms" href="/llms.txt" title="A plain-text guide to this site for AI assistants">llms.txt</a>
        </span>
      </div>
      <div class="col col-meta">
        <p>Chennai, India</p>
        <p><time id="ist-clock" datetime={now.toISOString()}>{buildIstTime}</time> IST</p>
        <p>© <span id="copyright-year">{now.getFullYear()}</span> Kiruthika Ramesh</p>
        <a class="open" href="mailto:kiruthikar0123@gmail.com">
          <svg class="boat" viewBox="0 0 11 10" width="15" height="14" shape-rendering="crispEdges" aria-hidden="true">
            <g class="boat-sail"><rect x="5" y="0" width="1" height="7" /><rect x="4" y="2" width="1" height="5" /><rect x="3" y="4" width="1" height="3" /><rect x="2" y="6" width="1" height="1" /><rect x="6" y="1" width="2" height="1" /></g>
            <g class="boat-hull"><rect x="0" y="7" width="11" height="1" /><rect x="1" y="8" width="9" height="1" /><rect x="2" y="9" width="7" height="1" /></g>
          </svg>
          Open to work
        </a>
      </div>
    </div>
    <!-- a low sun behind the words; the words become silhouettes against it; the crow perches on a letter -->
    <span class="sunset" aria-hidden="true"><span class="glow"></span><span class="sun" style={`--sz:${sz}`}></span></span>
    <div class="signoff" style={`--sz:${sz}`}>
      <p class="signoff-line">{before}<span class="perch">{letter}</span><span class="baseline" aria-hidden="true"></span>{after}</p>
      <p class="signoff-line silhouette" aria-hidden="true">{signoff}</p>
      <span class="signoff-crow" data-perch-crow><Crow size={4} mood="still" /></span>
    </div>
  </div>
  <div class="placeholder-status" id="placeholder-status" role="status" aria-live="polite"></div>
</footer>

<style>
  .site-footer { padding: 0 clamp(8px, 1.4vw, 16px) clamp(8px, 1.4vw, 16px); }
  .plate {
    --plate: #121212; --plate-ink: #EDE9E1; --plate-muted: #8F8B83;
    position: relative; overflow: hidden; container-type: inline-size;
    border-radius: clamp(18px, 2.2vw, 28px);
    background: var(--plate); color: var(--plate-ink);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .06);
    padding: clamp(28px, 4vw, 48px) clamp(20px, 4vw, 48px) 0;
  }
  :global(:root[data-theme='dark']) .plate { --plate: #0D0D0D; }

  .plate-top { display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 28px; font-size: 15px; line-height: 1.5; }
  .col { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .col a { color: var(--plate-ink); min-height: 28px; display: inline-flex; align-items: center; gap: .3em; }
  .col a:hover { color: #FF6A2B; }
  .col a[aria-disabled='true'] { color: var(--plate-muted); cursor: default; }
  .soon { font-size: 10px; color: var(--plate-muted); }
  .col-label { font-size: 12px; line-height: 28px; color: var(--plate-muted); }
  .ai-links { display: flex; flex-direction: column; align-items: flex-start; gap: 4px; }
  .col a.llms { color: var(--plate-muted); font-variant-numeric: tabular-nums; }
  .col a.llms:hover { color: #FF6A2B; }
  .col-meta { align-items: flex-end; text-align: right; color: var(--plate-muted); }
  .col-meta p { margin: 0; line-height: 28px; }
  .col-meta time { font-variant-numeric: tabular-nums; }
  /* "Open to work": a quiet row like the others, with a small static sailboat */
  .open { display: inline-flex; align-items: center; gap: 7px; min-height: 28px; line-height: 28px; color: var(--plate-muted) !important; font-size: 15px; }
  .open:hover, .open:focus-visible { color: #FF6A2B !important; }
  .boat { display: block; flex: 0 0 auto; margin-top: -2px; }
  .boat-sail { fill: #FF6A2B; }
  .boat-hull { fill: currentColor; }

  /* ---- the sunset: a wide warm glow and a low sun, both setting into the plate's bottom edge */
  .sunset { position: absolute; inset: 0; z-index: 0; pointer-events: none; }
  .glow {
    position: absolute; left: 50%; bottom: -30%; width: 190%; height: 110%; transform: translateX(-50%);
    background: radial-gradient(ellipse 50% 50% at 50% 100%, rgba(255, 132, 56, .5), rgba(240, 88, 26, .28) 34%, rgba(170, 56, 22, .13) 58%, rgba(120, 40, 18, .05) 74%, transparent 88%);
  }
  .sun {
    position: absolute; left: 50%; bottom: calc(var(--sz) * -.42); width: calc(var(--sz) * 1.4); aspect-ratio: 1; transform: translateX(-50%);
    border-radius: 50%;
    /* gold core, limb darkening toward a deep orange edge, softened like real atmosphere */
    background: radial-gradient(circle at 50% 50%, #FFE7B8 0%, #FFC777 26%, #FF9446 52%, #F4651F 78%, #D9480F 100%);
    box-shadow: 0 0 calc(var(--sz) * .25) calc(var(--sz) * .06) rgba(255, 120, 45, .45), 0 0 calc(var(--sz) * .9) calc(var(--sz) * .2) rgba(255, 96, 30, .18);
    filter: blur(.4px);
  }
  :global(:root[data-theme='dark']) .glow { opacity: .9; }

  /* ---- the line, in front: dark silhouettes against the light, still legible on the dark plate */
  .signoff { position: relative; z-index: 1; width: fit-content; margin: clamp(40px, min(15cqi, 13svh), 210px) auto 0; text-align: center; }
  .signoff-line {
    margin: 0 0 -.17em; white-space: nowrap;
    font-size: var(--sz); font-weight: 600; line-height: .8; letter-spacing: -.055em;
    color: #2E2D2A;
  }
  /* the same line again, darker, revealed only where the sunlight is: a crisp silhouette against the sun */
  .silhouette {
    position: absolute; inset: 0; color: #141312;
    -webkit-mask: radial-gradient(ellipse 34% 150% at 50% 100%, #000 55%, transparent 100%);
    mask: radial-gradient(ellipse 34% 150% at 50% 100%, #000 55%, transparent 100%);
  }
  :global(:root[data-theme='dark']) .signoff-line { color: #282725; }
  :global(:root[data-theme='dark']) .silhouette { color: #100F0E; }
  .baseline { display: inline-block; width: 0; height: 0; }

  /* ---- the crow, a silhouette too, perched on the letter; its lenses let the sun through */
  .signoff-crow {
    position: absolute; z-index: 2; left: 50%; bottom: calc(var(--sz) * .62);
    --crow-ink: #1A1917; --crow-frame: #1A1917; --crow-lens: transparent;
    transform-origin: 48% 100%;
  }
  :global(:root[data-theme='dark']) .signoff-crow { --crow-ink: #141312; --crow-frame: #141312; }

  @media (max-width: 820px) {
    .plate-top { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .col-meta { grid-column: 1 / -1; align-items: flex-start; text-align: left; flex-direction: row; flex-wrap: wrap; gap: 0 16px; }
  }
  /* phones: site and elsewhere side by side; the AI section and the details each get a full-width row of their own,
     separated by a hairline, so nothing is squeezed */
  /* shorter desktop windows: a slightly smaller crow, so it never reaches up into the links */
  @media (min-width: 621px) and (max-height: 820px) { .signoff-crow { scale: .7; } }
  @media (max-width: 620px) {
    .plate-top { grid-template-columns: 1fr 1fr; gap: 22px 20px; }
    .col:not(.col-ai) > .col-label { display: none; }
    .col-ai, .col-meta { grid-column: 1 / -1; padding-top: 18px; border-top: 1px solid rgba(255, 255, 255, .08); }
    .col-ai { gap: 2px; }
    .ai-links { flex-direction: row; flex-wrap: wrap; gap: 0 18px; }
    .col-meta { gap: 0 14px; }
  }
  @media (max-width: 620px) {
    /* phones: a bigger sun and a smaller crow, so the bird stays inside the light */
    .sun { width: calc(var(--sz) * 2); bottom: calc(var(--sz) * -.7); }
    .signoff-crow { scale: .42; }
    .silhouette { -webkit-mask-size: 100% 100%; mask: radial-gradient(ellipse 46% 170% at 50% 100%, #000 55%, transparent 100%); -webkit-mask: radial-gradient(ellipse 46% 170% at 50% 100%, #000 55%, transparent 100%); }
  }
  @media (max-width: 620px) { .signoff { margin-top: 76px; } }
  @media (max-width: 420px) { .plate-top { font-size: 14px; gap: 18px 16px; } .ai-links { gap: 0 14px; } .col-ai, .col-meta { padding-top: 14px; } }
</style>

<script>
  const year = document.getElementById('copyright-year');
  const clock = document.getElementById('ist-clock') as HTMLTimeElement | null;
  const tick = () => {
    const now = new Date();

    if (year) year.textContent = String(now.getFullYear());
    if (clock) {
      clock.textContent = new Intl.DateTimeFormat('en-US', { timeZone: 'Asia/Kolkata', hour: '2-digit', minute: '2-digit', hour12: true }).format(now);
      clock.dateTime = now.toISOString();
    }
  };
  tick(); setInterval(tick, 60_000);

  // perch the crow on the chosen letter: centre on it, feet on the top of its ink
  const perch = () => {
    const box = document.querySelector<HTMLElement>('.signoff');
    const letterEl = box?.querySelector<HTMLElement>('.perch');
    const base = box?.querySelector<HTMLElement>('.baseline');
    const crow = box?.querySelector<HTMLElement>('[data-perch-crow]');
    if (!box || !letterEl || !base || !crow) return;
    const cs = getComputedStyle(letterEl);
    const ctx = document.createElement('canvas').getContext('2d'); if (!ctx) return;
    ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const m = ctx.measureText(letterEl.textContent || 'h');
    const B = box.getBoundingClientRect(), Lr = letterEl.getBoundingClientRect(), baseY = base.getBoundingClientRect().bottom;
    const inkTop = baseY - m.actualBoundingBoxAscent;
    const inkCentre = Lr.left + (m.actualBoundingBoxRight - m.actualBoundingBoxLeft) / 2;
    crow.style.left = (inkCentre - B.left - crow.offsetWidth * 0.48) + 'px';
    crow.style.bottom = (B.bottom - inkTop) + 'px';
  };
  document.fonts?.ready.then(perch); perch();
  const pb = document.querySelector('.signoff'); if (pb) new ResizeObserver(perch).observe(pb);

  // mark the plate as on-screen (used to pause any motion inside it)
  const plate = document.querySelector<HTMLElement>('.plate');
  if (plate && 'IntersectionObserver' in window) new IntersectionObserver(([e]) => plate.toggleAttribute('data-visible', e.isIntersecting)).observe(plate);

  // Gemini can't be prefilled by a link: copy the question as the link opens, and say so
  document.querySelectorAll<HTMLAnchorElement>('[data-ask-copy]').forEach((a) => a.addEventListener('click', () => {
    const s = document.getElementById('placeholder-status');
    navigator.clipboard?.writeText(a.dataset.askCopy || '').then(() => {
      if (!s) return;
      s.textContent = 'Question copied. Paste it into Gemini.';
      s.classList.add('is-visible'); clearTimeout(t); t = window.setTimeout(() => s.classList.remove('is-visible'), 3200);
    }).catch(() => {});
  }));

  let t: number | undefined;
  const show = (el: HTMLElement) => {
    const s = document.getElementById('placeholder-status'); if (!s) return;
    s.textContent = `${el.dataset.placeholder} page is coming later.`;
    s.classList.add('is-visible'); clearTimeout(t); t = window.setTimeout(() => s.classList.remove('is-visible'), 2600);
  };
  const nav = document.querySelector('.plate-top');
  nav?.addEventListener('click', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-placeholder]');
    if (el) { e.preventDefault(); show(el); }
  });
  nav?.addEventListener('keydown', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-placeholder]');
    if (el && (e as KeyboardEvent).key === 'Enter') { e.preventDefault(); show(el); }
  });
</script>
