---
/**
 * Writings: two folds, then the closing quote + footer.
 * Fold 1: two large photo cards (Personal, Work). Each photo carries a frosted glass plate with only the name,
 *         one line on what is inside and a glass arrow; a small glass chip counts the pieces.
 * Fold 2: the four newest pieces as one quiet list.
 * Cross-document view transitions carry each card's photo into its section header (skipped for reduced motion).
 */
import { getCollection } from 'astro:content';
import SiteLayout from '../../layouts/SiteLayout.astro';
import WritingList from '../../components/WritingList.astro';
import PerchingCrow from '../../components/PerchingCrow.astro';
import { sections, sectionKeys, srcset, published, writingsQuote } from '../../lib/writings';

const all = published(await getCollection('writings'));
const cards = sectionKeys.map((k) => ({ k, ...sections[k], count: all.filter((e) => e.data.section === k).length }));
const site = 'https://imkiruthika.in';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': site + '/writings/', url: site + '/writings/',
  name: 'Writings by Kiruthika Ramesh', isPartOf: { '@id': site + '/#website' }, author: { '@id': site + '/#person' },
};
---
<SiteLayout
  title="Writings | Kiruthika Ramesh"
  description="Essays and notes by Kiruthika Ramesh on life and work: books, films, observations, marketing, GTM, AI and lessons from her career."
  canonical="https://imkiruthika.in/writings/"
  current="Writings"
  quote={writingsQuote}
  ogImage="https://imkiruthika.in/og-writings.png"
  ogImageAlt="The white handwritten Kr. logo beside /writing on a solid orange background."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />
  <link slot="head" rel="alternate" type="application/rss+xml" title="Writings by Kiruthika Ramesh" href="/writings/rss.xml" />

  <section class="wrap fold doors" aria-labelledby="w-title">
    <header class="w-head">
      <h1 id="w-title">Writings</h1>
      <p class="support"><em>On life, and on work.</em></p>
    </header>
    <div class="cards">
      <!-- the crow perches on the card you are choosing, and flies across when you hover the other -->
      <PerchingCrow targets=".card" at={0.62} />
      {cards.map((c) => (
        <a class="card" href={`/writings/${c.k}/`} style={`--focus:${c.photo.focus}`}>
          <img data-vt style={`--vt: photo-${c.k}`} src={c.photo.large} srcset={srcset(c.k)} sizes="(max-width: 820px) 100vw, 50vw" alt="" width="1600" height="2400" fetchpriority={c.k === 'personal' ? 'high' : undefined} decoding="async" />
          <span class="plate" data-vt-glass>
            <span class="plate-text">
              <span class="name">{c.name}</span>
              <span class="desc">{c.desc}</span>
            </span>
            <span class="go" aria-hidden="true">→</span>
          </span>
          <span class="count" data-vt-glass>{c.count === 0 ? 'First piece soon' : `${c.count} ${c.count === 1 ? 'piece' : 'pieces'}`}</span>
        </a>
      ))}
    </div>
  </section>

  <section class="wrap fold latest" aria-labelledby="latest-title">
    <div class="latest-head">
      <h2 id="latest-title">Latest</h2>
      <p class="all">{sectionKeys.map((k) => <a href={`/writings/${k}/`}>All {sections[k].name.toLowerCase()}</a>)}</p>
    </div>
    <WritingList list={all} showSection limit={4} />
  </section>

  <p class="wrap credit">Photos: {sections.personal.photo.credit}; {sections.work.photo.credit}.</p>
</SiteLayout>

<style>
  .fold { min-height: calc(100svh - var(--hh, var(--header-height))); }

  .doors { display: grid; grid-template-rows: auto 1fr; gap: clamp(48px, 7svh, 64px); padding-block: clamp(20px, 4svh, 48px) clamp(16px, 3svh, 36px); }
  /* title and line stacked on the left, so the space above the cards is free for the crow */
  .w-head { display: flex; flex-direction: column; gap: 10px; }
  h1 { font-size: clamp(40px, min(5.2vw, 8.5svh), 80px); font-weight: 500; line-height: .98; letter-spacing: -.045em; }
  .support { font-size: clamp(17px, 1.5vw, 21px); color: var(--muted); }

  .cards { position: relative; display: grid; grid-template-columns: 1fr 1fr; gap: clamp(12px, 1.6vw, 22px); min-height: 0; }
  .card {
    position: relative; isolation: isolate; overflow: hidden; display: block; min-height: 360px;
    border-radius: clamp(20px, 2.2vw, 30px); color: var(--ink); text-decoration: none;
    box-shadow: 0 30px 60px -42px rgba(40, 20, 8, .55);
  }
  .card img { position: absolute; inset: 0; z-index: -1; width: 100%; height: 100%; object-fit: cover; object-position: var(--focus); transform: scale(1.01); transition: transform 1.2s cubic-bezier(.2, .7, .2, 1); }
  .card:hover img, .card:focus-visible img { transform: scale(1.05); }
  .card:focus-visible { outline: 2px solid var(--brand); outline-offset: 4px; }
  .plate {
    position: absolute; left: clamp(10px, 1.2vw, 16px); right: clamp(10px, 1.2vw, 16px); bottom: clamp(10px, 1.2vw, 16px);
    display: flex; align-items: flex-end; justify-content: space-between; gap: 20px; padding: clamp(18px, 2.2vw, 30px);
    border-radius: clamp(14px, 1.6vw, 22px);
    background: color-mix(in srgb, var(--page) 64%, transparent);
    -webkit-backdrop-filter: blur(24px) saturate(1.5); backdrop-filter: blur(24px) saturate(1.5);
    box-shadow: inset 0 1px 0 color-mix(in srgb, #fff 55%, transparent), inset 0 0 0 1px color-mix(in srgb, #fff 18%, transparent);
  }
  :global(:root[data-theme='dark']) .plate { background: color-mix(in srgb, var(--page) 58%, transparent); box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12), inset 0 0 0 1px rgba(255, 255, 255, .06); }
  .plate-text { display: flex; flex-direction: column; gap: 8px; min-width: 0; }
  .name { font-size: clamp(36px, min(4.4vw, 7svh), 72px); font-weight: 500; line-height: .95; letter-spacing: -.045em; }
  .desc { max-width: 26em; font-size: clamp(15px, 1.2vw, 17px); line-height: 1.45; color: color-mix(in srgb, var(--ink) 72%, transparent); }
  .go {
    flex: none; width: 48px; height: 48px; display: grid; place-items: center; border-radius: 50%; font-size: 18px;
    background: color-mix(in srgb, var(--page) 70%, transparent); border: 1px solid color-mix(in srgb, var(--ink) 12%, transparent);
    transition: transform .3s var(--ease), color .2s ease, border-color .2s ease;
  }
  .card:hover .go, .card:focus-visible .go { transform: translateX(3px); color: var(--brand); border-color: var(--brand); }
  .count {
    position: absolute; top: clamp(12px, 1.4vw, 18px); left: clamp(12px, 1.4vw, 18px);
    padding: 5px 12px; border-radius: 999px; font-size: 13px; color: #fff;
    background: rgba(255, 255, 255, .14); -webkit-backdrop-filter: blur(12px); backdrop-filter: blur(12px);
    box-shadow: inset 0 0 0 1px rgba(255, 255, 255, .22);
  }

  .latest { display: flex; flex-direction: column; justify-content: center; padding-block: clamp(40px, 8svh, 96px); }
  .latest-head { display: flex; flex-wrap: wrap; align-items: baseline; justify-content: space-between; gap: 12px 32px; margin-bottom: clamp(18px, 3svh, 32px); }
  h2 { font-size: clamp(30px, 3vw, 40px); font-weight: 500; line-height: 1.1; letter-spacing: -.03em; }
  .all { display: flex; gap: 24px; }
  .all a {
    display: inline-flex; min-height: 40px; align-items: center; font-size: 15px; font-weight: 500; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); transition: color .2s ease, border-color .2s ease;
  }
  .all a:hover, .all a:focus-visible { color: var(--brand); border-color: var(--brand); }
  .credit { padding-bottom: 24px; font-size: 12px; color: var(--muted); }

  @media (max-width: 820px) {
    .cards { grid-template-columns: 1fr; grid-template-rows: 1fr 1fr; }
    .card { min-height: 220px; }
    .go { width: 42px; height: 42px; }
    .desc { font-size: 14px; }
  }
  @media (prefers-reduced-motion: reduce) { .card img { transition: none; } }
</style>
