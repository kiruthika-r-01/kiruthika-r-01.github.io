---
/**
 * 404: one screen, typographic, like the rest of the site. A small kicker and one display line (as on About),
 * the way home, the pages that do exist; then a huge, low-contrast "404" cropped by the bottom of the fold
 * (set like the footer's "See it through."), with the crow perched on the zero, puzzled, saying one line.
 * No scenery: the footer's sunset is one scroll below, so this page stays quiet.
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Crow from '../components/Crow.astro';
const line = 'This page ranks #1 for nothing.';
const routes = [
  { href: '/about/', label: 'About' },
  { href: '/career/', label: 'Career' },
  { href: '/writings/', label: 'Writings' },
];
---
<SiteLayout title="Page not found | Kiruthika Ramesh" description="This page doesn't exist." robots="noindex, follow">
  <section class="lost" aria-labelledby="lost-title">
    <div class="wrap lost-copy">
      <p class="kicker"><span class="n">404</span><span class="rule" aria-hidden="true"></span></p>
      <h1 id="lost-title">This page <em>doesn't exist.</em></h1>
      <a class="home" href="/">Back to the homepage <span aria-hidden="true">→</span></a>
      <nav class="routes" aria-label="Pages that exist">
        {routes.map((r) => <a href={r.href}>{r.label}</a>)}
      </nav>
    </div>

    <div class="numeral" aria-hidden="true">
      <span>4</span><span class="zero">0<span class="perch"><Crow size={5} mood="puzzled" /><span class="says">{line}</span></span></span><span>4</span>
    </div>
    <p class="sr-only">{line}</p>
  </section>
</SiteLayout>

<style>
  .lost {
    position: relative; overflow: hidden;
    min-height: calc(100svh - var(--hh, var(--header-height)));
    display: flex; flex-direction: column; justify-content: space-between;
    padding-top: clamp(32px, 9svh, 110px);
  }
  .lost-copy { position: relative; z-index: 2; }

  /* kicker as on About: number, then a hairline rule (empty: you are nowhere yet) */
  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(14px, 2.6svh, 26px); }
  .n { font-size: 14px; font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: .02em; }
  .rule { width: 56px; height: 1px; background: color-mix(in srgb, var(--ink) 16%, transparent); }
  h1 { max-width: 12ch; font-size: clamp(46px, min(7vw, 11.5svh), 124px); font-weight: 500; line-height: .96; letter-spacing: -.048em; text-wrap: balance; }
  h1 em { font-style: italic; }

  .home {
    display: inline-flex; align-items: center; gap: .4em; min-height: 44px; margin-top: clamp(18px, 3.4svh, 36px);
    font-size: 18px; font-weight: 500; color: var(--ink); text-decoration: none;
    border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent); transition: color .2s ease, border-color .2s ease;
  }
  .home span { transition: transform .25s var(--ease); }
  .home:hover, .home:focus-visible, .home:active { color: var(--brand); border-color: var(--brand); }
  .home:hover span { transform: translateX(3px); }
  .routes { display: flex; flex-wrap: wrap; gap: 4px 22px; margin-top: 10px; }
  .routes a { display: inline-flex; align-items: center; min-height: 44px; font-size: 16px; color: var(--muted); text-decoration: none; transition: color .2s ease; }
  .routes a:hover, .routes a:focus-visible { color: var(--brand); }

  /* ---- the numeral: huge, quiet, cropped by the fold's bottom edge (like the footer sign-off) */
  .numeral {
    position: relative; z-index: 1; align-self: center; display: flex; white-space: nowrap;
    margin: clamp(40px, 8svh, 96px) 0 calc(var(--nz) * -.16);
    --nz: clamp(180px, min(40vw, 46svh), 560px);
    font-size: var(--nz); font-weight: 600; line-height: .72; letter-spacing: -.055em;
    color: color-mix(in srgb, var(--ink) 7%, var(--page));
    user-select: none;
  }
  /* each digit is its own box from cap height to baseline, so "on top of the zero" is the top of its ink */
  .numeral > span { display: block; line-height: .72; }
  @supports (text-box: trim-both cap alphabetic) { .numeral > span { line-height: 1; text-box: trim-both cap alphabetic; } }
  .zero { position: relative; }

  /* the crow stands on the top of the zero; its line sits beside its head */
  .perch {
    position: absolute; left: 50%; bottom: calc(100% - .02em); translate: -50% 0;
    font-size: 16px; letter-spacing: normal; line-height: 0; color: var(--ink);
    animation: land .7s var(--ease) .35s both;
  }
  .says {
    position: absolute; left: calc(100% + 10px); bottom: 62%; white-space: nowrap;
    font-size: clamp(15px, 1.3vw, 17px); font-style: italic; font-weight: 400; line-height: 1.3; letter-spacing: -.01em; color: var(--muted);
    animation: say .5s ease 1s both;
  }
  @keyframes land { from { opacity: 0; translate: -50% -40px; } 70% { opacity: 1; translate: -50% 3px; } to { opacity: 1; translate: -50% 0; } }
  @keyframes say { from { opacity: 0; } to { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .perch, .says { animation: none; } }

  .sr-only { position: absolute; width: 1px; height: 1px; overflow: hidden; clip-path: inset(50%); white-space: nowrap; }

  @media (max-width: 620px) {
    .lost { padding-top: 28px; }
    .kicker { margin-bottom: 14px; }
    .rule { width: 40px; }
    .numeral { --nz: clamp(150px, 52vw, 260px); }
    .perch :global([data-crow]) { scale: .7; transform-origin: 50% 100%; }
    /* no room beside the crow on a phone: the line sits above it */
    .says { left: 50%; bottom: calc(70% + 10px); translate: -50% 0; font-size: 14px; }   /* the crow is drawn at .7 from its feet */
  }
</style>
