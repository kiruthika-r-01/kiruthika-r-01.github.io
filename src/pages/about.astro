---
/**
 * About: "four chapters, one evening".
 * One chapter per screen. Each opens with a two-line display: the tagline in orange italic over the title in
 * roman ink. Compositions alternate left/right. The page warms very slowly from white toward the footer's sunset.
 * A small glass pill at the bottom tracks the chapter being read. Content is unchanged from the approved copy.
 * The crow stands on the "Elsewhere" title.
 * The page closes with a "Now" note (src/data/now.json, editable in Pages CMS).
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import Crow from '../components/Crow.astro';
import now from '../data/now.json';

const canonicalUrl = 'https://imkiruthika.in/about/';
const title = 'About Kiruthika Ramesh | High Agency Marketing Generalist';
const description = 'Meet Kiruthika Ramesh, a high-agency marketing generalist working across content, SEO, AEO, GTM and design, while exploring marketing automation.';
const openGraphDescription = 'Meet Kiruthika Ramesh and learn how curiosity has shaped her work across content, SEO, AEO, go-to-market strategy and design.';
const siteUrl = 'https://imkiruthika.in/';
const playlistUrl = 'https://open.spotify.com/playlist/4MBuUg744i68jhgNALnzo4?si=PAkqtjYKT2a1hP1EBywrjg';
const careerUrl = `${import.meta.env.BASE_URL}career/`;

const sections = [
  {
    id: '00',
    title: 'Against the grain',
    tagline: 'Restless',
    paragraphs: [
      "When you grow up curious and different in a place known for its repetitiveness and mediocrity, you eventually figure out that you want to run toward the exact things people say you can't do. For me, that was writing and marketing. People told me directly and indirectly that it wasn't a realistic path, which naturally meant I wanted to give it my all.",
    ],
  },
  {
    id: '01',
    title: 'Pulling at threads',
    tagline: 'Curious',
    paragraphs: [
      "I studied Computer Applications and started out as a content writer, with very little knowledge of the wider marketing discipline. I didn't stay in a single lane for long, not because I couldn't handle the writing, but because you can only write so many blogs before you start wondering where the landing page leads, how the campaign brings people there, and what the sales team is actually doing with the leads. I started pulling at those threads, which led me into SEO, website management, building sales decks, and go-to-market strategy. I call myself a marketing generalist now. It wasn't a grand career plan so much as a need to understand how the different pieces fit together, and I usually learn that by getting involved and doing the work myself.",
    ],
  },
  {
    id: '02',
    title: 'The bigger picture',
    tagline: 'Patterns',
    paragraphs: [
      'I see marketing as orchestrating a play. There is a script, a set, lighting, actors, and a whole lot of work happening backstage. You can do a wonderful job with your specific part, but the production only works if all those elements talk to each other. I like being the person who can step into different roles when needed, rather than just watching from the audience. Working in lean, technology-focused teams has given me the room to operate like this. It showed me the actual value of taking ownership—having the freedom to step outside your job description and take responsibility for a project simply because a problem needs solving. Design is one of those areas I keep coming back to; I love it, and I will always find an excuse to figure out how an idea should look on a screen.',
    ],
  },
  {
    id: '03',
    title: 'Elsewhere',
    tagline: 'Obsessions',
    paragraphs: [
      'Lately, I am going back to where I started with coding. There is something satisfying about returning to a subject years later with a completely different set of problems in mind. I want to see how far I can take AI and code to automate the repetitive parts of marketing, experimenting with what I can build myself instead of always relying on off-the-shelf software. I am also helping a friend with their e-commerce business and exploring paid ads, adding to a list of things to learn that grows a lot faster than my ability to get around to them.',
      "Outside of work, I spend my time reading classic philosophy and Kurt Vonnegut novels, or drinking cold brew while trying to get a double crochet stitch right. I am very much a beginner, so we'll see how that goes. I listen to Qawwali music, rewatch Schitt's Creek with absolutely no intention of stopping, and I've recently been exploring Rakhshan Banietemad's films alongside Rajnikanth's retro filmography (yes, the Jailer effect is real). None of this is meant to optimize my productivity or teach me a lesson about B2B SaaS, which is exactly why I do it.",
    ],
  },
];
const linkWord = 'Qawwali music';

const structuredData = {
  '@context': 'https://schema.org',
  '@type': 'ProfilePage',
  '@id': canonicalUrl,
  url: canonicalUrl,
  name: title,
  description,
  about: { '@id': siteUrl + '#person' },
  mainEntity: { '@id': siteUrl + '#person' },
  isPartOf: { '@id': siteUrl + '#website' },
  breadcrumb: {
    '@type': 'BreadcrumbList',
    itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'Home', item: siteUrl },
      { '@type': 'ListItem', position: 2, name: 'About', item: canonicalUrl },
    ],
  },
};
---
<SiteLayout
  title={title}
  description={description}
  ogDescription={openGraphDescription}
  ogType="profile"
  canonical={canonicalUrl}
  ogImage="https://imkiruthika.in/og-about.png"
  ogImageAlt="The white handwritten Kr. logo beside /about on a solid orange background."
  current="About"
  quote={{ text: 'Pay attention. Be astonished. Tell about it.', by: 'Mary Oliver' }}
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <h1 class="sr-only">About Kiruthika Ramesh</h1>

  <div class="evening">
    {sections.map((s, i) => (
      <section class="chapter" id={s.id} data-ch={s.id} data-side={i % 2 ? 'right' : 'left'} aria-labelledby={`ch-${s.id}`}>
        <div class="wrap ch-grid">
          <header class="ch-head">
            <p class="ch-kicker"><span class="ch-n" aria-hidden="true">{s.id}</span><span class="ch-rule" aria-hidden="true"></span><span class="ch-tag">{s.tagline}</span></p>
            <h2 id={`ch-${s.id}`}>{s.title}{s.id === '03' && <span class="perched"><Crow size={3} /></span>}</h2>
          </header>
          <div class="ch-body">
            {s.paragraphs.map((p) => {
              const k = p.indexOf(linkWord);
              return <p>{k < 0 ? p : <>{p.slice(0, k)}<a href={playlistUrl} target="_blank" rel="noopener noreferrer">{linkWord}</a>{p.slice(k + linkWord.length)}</>}</p>;
            })}
            {i === sections.length - 1 && <p class="next"><a href={careerUrl}>Curious about the work? <span aria-hidden="true">→</span></a></p>}
          </div>
        </div>
      </section>
    ))}

    <!-- Now: a short, dated note at the warmest point of the page -->
    <section class="wrap now" aria-labelledby="now-title" data-now>
      <div class="now-card">
        <p class="now-head"><span class="now-dot" aria-hidden="true"></span><span class="now-word" id="now-title">Now</span><time>{now.updated}</time></p>
        <p class="now-text">{now.text}</p>
      </div>
    </section>
  </div>

  <!-- glass chapter pill: the current chapter opens to show its title -->
  <nav class="dial" aria-label="Chapters" data-dial>
    <ol>
      {sections.map((s) => (
        <li><a href={`#${s.id}`} data-ch={s.id}><span class="d-n">{s.id}</span><span class="d-t">{s.title}</span></a></li>
      ))}
    </ol>
  </nav>
</SiteLayout>

<style>
  /* ---- the evening: the page warms, very slowly, from white toward the footer's sunset */
  .evening {
    background: linear-gradient(to bottom,
      var(--page) 0%,
      color-mix(in srgb, #FFB27A 4%, var(--page)) 35%,
      color-mix(in srgb, #FF8A45 8%, var(--page)) 72%,
      color-mix(in srgb, #FF6A2B 11%, var(--page)) 92%,
      var(--page) 100%);
  }
  :global(:root[data-theme='dark']) .evening {
    background: linear-gradient(to bottom,
      var(--page) 0%,
      color-mix(in srgb, #FF8A45 3%, var(--page)) 40%,
      color-mix(in srgb, #FF6A2B 6%, var(--page)) 78%,
      color-mix(in srgb, #FF5A1F 8%, var(--page)) 92%,
      var(--page) 100%);
  }

  /* ---- one chapter, one screen */
  .chapter { scroll-margin-top: var(--hh, var(--header-height)); }
  .ch-grid {
    display: grid; grid-template-columns: repeat(12, minmax(0, 1fr)); grid-template-rows: auto 1fr;
    column-gap: clamp(16px, 2vw, 28px); row-gap: clamp(28px, 6svh, 72px);
    min-height: calc(100svh - var(--hh, var(--header-height)));
    padding-block: clamp(40px, 9svh, 112px) clamp(56px, 11svh, 128px);
  }
  .ch-head { position: relative; grid-row: 1; }
  .ch-body { grid-row: 2; align-self: end; max-width: 34em; font-size: clamp(18px, 1.45vw, 21px); line-height: 1.7; }
  .ch-body p + p { margin-top: 1em; }

  /* alternate the composition: title top-left / text bottom-right, then mirrored (text always opposite its title) */
  .chapter[data-side='left'] .ch-head { grid-column: 1 / span 9; }
  .chapter[data-side='left'] .ch-body { grid-column: 7 / -1; }
  .chapter[data-side='right'] .ch-head { grid-column: 4 / -1; text-align: right; justify-self: end; }
  .chapter[data-side='right'] .ch-body { grid-column: 1 / span 6; }
  /* the longest chapter gets a wider measure, still on the left */
  .chapter[data-ch='03'] .ch-body { grid-column: 1 / span 7; max-width: 38em; }

  /* one display line (the title), led by a small kicker: number, a progress rule, the tagline in orange italic.
     The rule fills a quarter per chapter, so the numbers read as "how far into the evening" (and match the pill). */
  .ch-kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(14px, 2.6svh, 26px); }
  .chapter[data-side='right'] .ch-kicker { justify-content: flex-end; }
  .ch-n { font-size: 14px; font-weight: 500; color: var(--muted); font-variant-numeric: tabular-nums; letter-spacing: .02em; }
  .ch-rule { position: relative; width: 56px; height: 1px; background: color-mix(in srgb, var(--ink) 16%, transparent); }
  .ch-rule::after { content: ''; position: absolute; inset: 0 auto 0 0; width: calc(var(--fill) * 100%); background: var(--brand); }
  .chapter[data-ch='00'] { --fill: .25; } .chapter[data-ch='01'] { --fill: .5; }
  .chapter[data-ch='02'] { --fill: .75; } .chapter[data-ch='03'] { --fill: 1; }
  .ch-tag { font-size: clamp(20px, 1.9vw, 28px); font-style: italic; font-weight: 400; line-height: 1; letter-spacing: -.02em; color: var(--brand); }
  h2 { font-size: clamp(46px, min(7vw, 11.5svh), 124px); font-weight: 500; line-height: .96; letter-spacing: -.048em; text-wrap: balance; }

  .ch-body a { color: var(--ink); text-decoration: underline; text-decoration-color: var(--brand); text-underline-offset: .2em; text-decoration-thickness: 1px; }
  .ch-body a:hover { color: var(--brand); }
  .next { margin-top: 1.6em !important; }
  .next a {
    display: inline-flex; align-items: center; gap: .4em; min-height: 44px; font-size: 18px; font-weight: 500;
    color: var(--ink); text-decoration: none !important; border-bottom: 1px solid color-mix(in srgb, var(--ink) 30%, transparent);
    transition: color .2s ease, border-color .2s ease;
  }
  .next a:hover, .next a:focus-visible, .next a:active { color: var(--brand); border-color: var(--brand); }
  .next a span { transition: transform .25s var(--ease); }
  .next a:hover span { transform: translateX(3px); }

  .ch-grid { position: relative; z-index: 1; }

  /* ---- the crow stands on the baseline of "Elsewhere" */
  .perched { display: inline-block; margin-left: .14em; line-height: 0; vertical-align: baseline; }

  /* ---- Now: the one "live" thing on the page, a wide frosted note at the warmest point of the evening.
     Big enough to read as its own moment rather than a footnote. */
  .now { position: relative; isolation: isolate; display: grid; place-items: center; padding-block: clamp(72px, 14svh, 160px) clamp(96px, 18svh, 200px); }
  /* glass needs something behind it to frost: a low, wide band of evening light (no sun, no shape),
     brightest just under the card's lower half, so the glass visibly softens it */
  .now::before {
    /* every glow fades out well inside this box, so no edge ever shows */
    content: ''; position: absolute; z-index: -1; left: 50%; top: 56%; width: min(1180px, 100%); height: 84%; translate: -50% -50%;
    background:
      radial-gradient(ellipse 30% 40% at 32% 55%, color-mix(in srgb, #FF8A45 30%, transparent), transparent 100%),
      radial-gradient(ellipse 28% 38% at 70% 50%, color-mix(in srgb, #FFB36B 34%, transparent), transparent 100%),
      radial-gradient(ellipse 48% 34% at 50% 62%, color-mix(in srgb, #F94D03 15%, transparent), transparent 100%);
    pointer-events: none;
  }
  :global(:root[data-theme='dark']) .now::before { opacity: .75; }
  .now-card {
    position: relative; width: min(100%, 1000px); padding: clamp(28px, 4.4vw, 64px) clamp(26px, 4.8vw, 72px) clamp(32px, 5vw, 72px);
    border-radius: clamp(24px, 2.6vw, 36px);
    background: linear-gradient(160deg, color-mix(in srgb, var(--page) 72%, transparent), color-mix(in srgb, var(--page) 40%, transparent));
    -webkit-backdrop-filter: blur(30px) saturate(1.6); backdrop-filter: blur(30px) saturate(1.6);
    box-shadow:
      inset 0 1px 0 color-mix(in srgb, #fff 75%, transparent),
      inset 0 -1px 0 color-mix(in srgb, var(--ink) 5%, transparent),
      0 1px 2px rgba(60, 25, 5, .06), 0 40px 80px -48px rgba(120, 50, 10, .45);
  }
  /* the lit edge real glass has: bright where the light hits (top left), fading round the rim */
  .now-card::before {
    content: ''; position: absolute; inset: 0; border-radius: inherit; padding: 1px; pointer-events: none;
    background: linear-gradient(150deg, rgba(255, 255, 255, .95), rgba(255, 255, 255, .25) 38%, color-mix(in srgb, var(--ink) 10%, transparent) 70%, rgba(255, 255, 255, .5));
    -webkit-mask: linear-gradient(#000 0 0) content-box, linear-gradient(#000 0 0); -webkit-mask-composite: xor;
    mask: linear-gradient(#000 0 0) content-box exclude, linear-gradient(#000 0 0);
  }
  :global(:root[data-theme='dark']) .now-card {
    background: linear-gradient(160deg, color-mix(in srgb, #fff 9%, transparent), color-mix(in srgb, #fff 3%, transparent));
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .12), 0 40px 80px -48px rgba(0, 0, 0, .7);
  }
  :global(:root[data-theme='dark']) .now-card::before { background: linear-gradient(150deg, rgba(255, 255, 255, .28), rgba(255, 255, 255, .06) 40%, rgba(255, 255, 255, .03) 70%, rgba(255, 255, 255, .14)); }
  .now-head { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(18px, 2.6vw, 34px); }
  .now-dot { position: relative; width: 9px; height: 9px; border-radius: 50%; background: var(--brand); }
  .now-dot::after { content: ''; position: absolute; inset: -5px; border-radius: 50%; border: 1px solid var(--brand); opacity: 0; }
  .now[data-visible] .now-dot::after { animation: now-pulse 2.8s cubic-bezier(.3, .7, .2, 1) infinite; }
  @keyframes now-pulse { 0% { opacity: .7; transform: scale(.6); } 70%, 100% { opacity: 0; transform: scale(1.5); } }
  .now-word { font-size: clamp(16px, 1.3vw, 19px); font-weight: 600; letter-spacing: -.01em; }
  .now-head time { margin-left: auto; font-size: clamp(13px, 1.05vw, 15px); color: var(--muted); font-variant-numeric: tabular-nums; }
  .now-text { max-width: 22em; font-size: clamp(24px, 2.8vw, 42px); font-weight: 400; line-height: 1.24; letter-spacing: -.026em; text-wrap: balance; }

  /* ---- glass chapter pill, fixed at the bottom centre */
  .dial {
    position: fixed; z-index: 15; left: 50%; bottom: max(18px, env(safe-area-inset-bottom));
    transform: translateX(-50%); transition: opacity .3s ease, transform .4s var(--ease);
  }
  .dial[data-hidden] { opacity: 0; transform: translate(-50%, 16px); pointer-events: none; }
  .dial ol {
    list-style: none; margin: 0; padding: 5px; display: flex; gap: 2px; border-radius: 999px;
    background: color-mix(in srgb, var(--page) 62%, transparent);
    -webkit-backdrop-filter: blur(20px) saturate(1.8); backdrop-filter: blur(20px) saturate(1.8);
    border: 1px solid color-mix(in srgb, var(--ink) 10%, transparent);
    box-shadow: 0 10px 30px -12px rgba(40, 20, 10, .3), inset 0 1px 0 rgba(255, 255, 255, .45);
  }
  .dial a {
    display: flex; align-items: center; min-height: 36px; padding: 0 12px; border-radius: 999px;
    color: var(--muted); text-decoration: none; font-size: 13px; font-weight: 500; white-space: nowrap;
    transition: background-color .3s ease, color .3s ease;
  }
  .d-n { font-variant-numeric: tabular-nums; }
  .d-t { display: inline-block; max-width: 0; overflow: hidden; opacity: 0; vertical-align: bottom; transition: max-width .45s var(--ease), opacity .3s ease, margin .45s var(--ease); }
  .dial a:hover { color: var(--ink); }
  .dial a[aria-current='true'] { color: var(--ink); background: color-mix(in srgb, var(--page) 85%, transparent); box-shadow: 0 1px 3px rgba(0, 0, 0, .1); }
  .dial a[aria-current='true'] .d-n { color: var(--brand); }
  .dial a[aria-current='true'] .d-t { max-width: 14em; opacity: 1; margin-left: 8px; }

  @media (max-width: 1060px) {
    .chapter[data-side='left'] .ch-body { grid-column: 6 / -1; }
    .chapter[data-side='right'] .ch-body, .chapter[data-ch='03'] .ch-body { grid-column: 1 / span 8; }
  }
  /* tablet and phone: one clean left edge for everything, title then text */
  @media (max-width: 820px) {
    .ch-grid { display: block; min-height: 0; padding-block: clamp(56px, 10svh, 96px) clamp(40px, 7svh, 72px); }
    .chapter[data-side] .ch-head { text-align: left; justify-self: start; }
    .chapter[data-side='right'] .ch-kicker { justify-content: flex-start; }
    .ch-kicker { margin-bottom: 14px; }
    .ch-rule { width: 40px; }
    .ch-tag { font-size: 21px; }
    h2 { font-size: clamp(40px, 12vw, 72px); line-height: .98; }
    .ch-body { margin-top: 24px; max-width: 36em; font-size: 18px; line-height: 1.7; }
    .perched :global(.crow) { scale: .75; transform-origin: 0 100%; }
    .now { padding-block: 48px 96px; }
    .now-text { font-size: clamp(22px, 6.4vw, 28px); line-height: 1.3; }
  }
  @media (max-width: 420px) { .dial a { padding: 0 10px; } .dial a[aria-current='true'] .d-t { max-width: 9.5em; text-overflow: ellipsis; } }
  @media (prefers-reduced-motion: reduce) { .d-t, .dial { transition: none; } .now[data-visible] .now-dot::after { animation: none; } }
</style>

<script>
  // which chapter is being read; the pill hides once the closing quote and footer arrive
  const links = Array.from(document.querySelectorAll<HTMLAnchorElement>('.dial a'));
  const dial = document.querySelector<HTMLElement>('[data-dial]');
  const setActive = (id: string) => links.forEach((a) => {
    if (a.dataset.ch === id) a.setAttribute('aria-current', 'true'); else a.removeAttribute('aria-current');
  });
  setActive(location.hash.slice(1) || '00');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) setActive((e.target as HTMLElement).dataset.ch!); });
    }, { rootMargin: '-45% 0px -50% 0px' });
    document.querySelectorAll<HTMLElement>('.chapter').forEach((c) => io.observe(c));
    // step aside for the Now note, the closing quote and the footer
    const outro = Array.from(document.querySelectorAll('.now, .end-fold'));
    const seen = new Set<Element>();
    if (dial && outro.length) {
      const hide = new IntersectionObserver((entries) => {
        entries.forEach((e) => (e.isIntersecting ? seen.add(e.target) : seen.delete(e.target)));
        dial.toggleAttribute('data-hidden', seen.size > 0);
      }, { threshold: 0.2 });
      outro.forEach((el) => hide.observe(el));
    }
    // the Now dot only pulses while the note is on screen
    const nowEl = document.querySelector('[data-now]');
    if (nowEl) new IntersectionObserver(([e]) => nowEl.toggleAttribute('data-visible', e.isIntersecting)).observe(nowEl);
  }
</script>
