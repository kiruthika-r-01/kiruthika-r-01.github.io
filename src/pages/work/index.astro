---
/**
 * Selected Works. Two folds on desktop: the heading on its own (the folders may peek in at the bottom), then all six
 * folders filling exactly one screen (gentle snapping for mouse and trackpad, as on the homepage; touch scrolls freely).
 * Each folder: a back panel with a tab (its name), a sheet of the work peeking out, and a frosted glass front with
 * only the name, one line and an arrow. Light theme: paper. Dark theme: dark glass, its shape drawn by highlight
 * edges and a soft sheen (not a colour swap). Hover: the front tips forward, the sheet rises; click: the folder's
 * page grows out of it (view transition from the front to the folder page's glass plate).
 * Kafka is the filing clerk: a perch beside the heading with a hint; she flies to the folder you point at, silently;
 * her remark shows in a small glass note at her feet only when you hover or tap her. No "caw!" on this page.
 * Content: src/data/work.json (Pages CMS: "Selected works").
 */
import SiteLayout from '../../layouts/SiteLayout.astro';
import PerchingCrow from '../../components/PerchingCrow.astro';
import { work, folders, smallSrc } from '../../lib/work';

const site = 'https://imkiruthika.in';
const url = site + '/work/';
const structuredData = {
  '@context': 'https://schema.org', '@type': 'CollectionPage', '@id': url, url, name: 'Selected Works by Kiruthika Ramesh',
  description: work.seo.description, isPartOf: { '@id': site + '/#website' }, author: { '@id': site + '/#person' },
  hasPart: folders.map((f) => ({ '@type': 'CollectionPage', name: f.name, url: `${site}/work/${f.slug}/` })),
  breadcrumb: { '@type': 'BreadcrumbList', itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Home', item: site + '/' },
    { '@type': 'ListItem', position: 2, name: 'Selected Works', item: url },
  ] },
};
---
<SiteLayout
  title={work.seo.title}
  description={work.seo.description}
  canonical={url}
  current="Selected Works"
  quote={work.quote}
  ogImage={site + '/og-selected-works.png'}
  ogImageAlt="The white handwritten Kr. logo beside /selected works on a solid orange background."
>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <section class="wrap cabinet" aria-labelledby="w-title">
    <PerchingCrow targets=".folder, .k-home" start=".k-home" at={0.5} size={2.6} talk="hover" />

    <header class="head intro">
      <div class="head-text">
        <p class="kicker"><span class="n">{work.kicker}</span><span class="rule" aria-hidden="true"></span><em>{folders.length} folders</em></p>
        <h1 id="w-title">{work.title} <em>{work.titleItalic}</em></h1>
        <p class="lede">{work.lede}</p>
      </div>
      <!-- Kafka's own perch: a short rule she stands on until you point at a folder -->
      <span class="k-home" data-says={work.kafka?.says} data-hint={work.kafka?.hint} data-hint-touch={work.kafka?.hintTouch} aria-hidden="true"></span>
    </header>

    <div class="drawer">
      <ul class="folders" role="list">
        {folders.map((f, i) => (
          <li class:list={['slot', { sealed: f.sealed }]} style={`--i:${i}`}>
            <a class="folder" href={`/work/${f.slug}/`} data-says={f.kafka}>
              <span class="back" aria-hidden="true"></span>
              <span class="tab" aria-hidden="true"><span class="spot" data-perch-spot></span></span>
              {f.peek
                ? <span class="sheet" aria-hidden="true"><img src={f.peek} srcset={smallSrc(f.peek) ? `${smallSrc(f.peek)} 750w, ${f.peek} 1500w` : undefined} sizes="(max-width: 620px) 90vw, 32vw" alt="" width="1500" height="600" loading={i < 3 ? 'eager' : 'lazy'} decoding="async" /></span>
                : <span class="sheet blank" aria-hidden="true"></span>}
              <span class="front" style={`view-transition-name: folder-${f.slug}`}>
                <span class="f-text">
                  <span class="f-name">{f.name}</span>
                  <span class="f-tab">{f.tab}</span>
                </span>
                <span class="go" aria-hidden="true">→</span>
              </span>
            </a>
          </li>
        ))}
      </ul>
    </div>
  </section>
</SiteLayout>

<style>
  /* gentle snapping (mouse and trackpad only) so the second scroll lands on the whole drawer */
  @media (hover: hover) and (pointer: fine) { :global(html) { scroll-snap-type: y proximity; } }
  .cabinet { position: relative; }
  /* this page only: Kafka talks, she does not caw */
  .cabinet :global(.crow-caw) { display: none; }

  /* ---- fold 1: the heading, set large; the folders may peek in at the bottom */
  .intro {
    min-height: calc(82svh - var(--hh, var(--header-height)));
    display: grid; grid-template-columns: minmax(0, 1fr) auto; align-items: center; gap: 24px;
    padding-block: clamp(24px, 6svh, 72px) clamp(16px, 4svh, 40px);
  }
  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(14px, 2.6svh, 26px); }
  .kicker .n { font-size: 14px; font-weight: 500; color: var(--muted); letter-spacing: .02em; }
  .rule { width: 56px; height: 1px; background: color-mix(in srgb, var(--ink) 16%, transparent); }
  .kicker em { font-size: clamp(24px, 1.9vw, 28px); line-height: 1; letter-spacing: -.02em; color: var(--brand); }
  h1 { font-size: clamp(56px, min(8.4vw, 15svh), 148px); font-weight: 500; line-height: .94; letter-spacing: -.05em; }
  h1 em { font-style: italic; }
  .lede { margin-top: clamp(18px, 3.4svh, 34px); max-width: 30em; font-size: clamp(18px, 1.6vw, 23px); line-height: 1.5; color: var(--muted); text-wrap: pretty; }
  /* her perch: a short rule, with room on its left for her hint */
  .k-home { align-self: end; display: block; width: 88px; height: 1px; margin: 0 18rem clamp(20px, 6svh, 64px) 0; background: color-mix(in srgb, var(--ink) 22%, transparent); }

  /* ---- fold 2: the drawer, exactly one screen; room above each row of tabs for Kafka */
  .drawer {
    height: calc(100svh - var(--hh, var(--header-height))); min-height: 560px;
    display: flex; flex-direction: column; padding-block: 76px 28px;
    scroll-snap-align: start; scroll-margin-top: var(--hh, var(--header-height));
  }
  .folders {
    flex: 1; min-height: 0; list-style: none; margin: 0; padding: 0;
    display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr));
    gap: 76px clamp(16px, 2vw, 28px);
    /* light: paper */
    --back: linear-gradient(to bottom, #E4DDD1, #EFE9DF 30%); --tab: #E4DDD1;
    --back-edge: 0 0 0 1px rgba(20, 10, 4, .04); --back-shadow: 0 30px 50px -36px rgba(20, 10, 4, .55);
    --glass: rgba(250, 247, 242, .62); --glass-edge: inset 0 1px 0 rgba(255, 255, 255, .8), inset 0 0 0 1px rgba(255, 255, 255, .35);
    --sheen: linear-gradient(165deg, rgba(255, 255, 255, .45), rgba(255, 255, 255, 0) 38%);
    --f-ink: #1B1A17; --f-muted: #5E5B55; --go-bg: rgba(255, 255, 255, .55); --go-line: rgba(27, 26, 23, .12);
  }
  /* dark: dark glass, drawn by its highlights */
  :global(:root[data-theme='dark']) .folders {
    --back: linear-gradient(to bottom, #34322F, #2A2927 36%, #252422);
    --tab: #34322F;
    --back-edge: inset 0 1px 0 rgba(255, 255, 255, .22), inset 0 0 0 1px rgba(255, 255, 255, .11); --back-shadow: 0 34px 56px -28px rgba(0, 0, 0, .85);
    --glass: rgba(58, 56, 52, .55); --glass-edge: inset 0 1px 0 rgba(255, 255, 255, .34), inset 0 0 0 1px rgba(255, 255, 255, .14), 0 -12px 24px -18px rgba(0, 0, 0, .7);
    --sheen: linear-gradient(165deg, rgba(255, 255, 255, .16), rgba(255, 255, 255, 0) 45%);
    --f-ink: #FFFFFF; --f-muted: rgba(255, 255, 255, .64); --go-bg: rgba(255, 255, 255, .06); --go-line: rgba(255, 255, 255, .18);
  }
  .slot { position: relative; min-height: 0; animation: rise .7s var(--ease) both; animation-delay: calc(var(--i) * 60ms + 80ms); }
  @keyframes rise { from { opacity: 0; translate: 0 18px; } to { opacity: 1; translate: 0 0; } }

  .folder { position: relative; display: block; height: 100%; color: var(--f-ink); text-decoration: none; perspective: 1100px; -webkit-tap-highlight-color: transparent; }
  .folder:focus-visible { outline: none; }
  .folder:focus-visible .front { outline: 2px solid var(--brand); outline-offset: 4px; }

  .back { position: absolute; inset: 26px 0 0; border-radius: 6px 18px 18px 18px; background: var(--back); box-shadow: var(--back-edge), var(--back-shadow); }
  .tab {
    position: absolute; left: 0; top: 0; height: 30px; width: 34%; max-width: 160px; padding: 0 18px 4px;
    display: flex; align-items: center; border-radius: 14px 14px 0 0; background: var(--tab);
    font-size: 13px; font-weight: 500; white-space: nowrap; color: var(--f-ink);
  }
  :global(:root[data-theme='dark']) .tab { box-shadow: inset 0 1px 0 rgba(255, 255, 255, .24), inset 1px 0 0 rgba(255, 255, 255, .12), inset -1px 0 0 rgba(255, 255, 255, .06); }
  .tab::after { content: ''; position: absolute; right: -14px; bottom: 0; width: 14px; height: 14px; background: radial-gradient(circle at 100% 0, transparent 13.5px, var(--tab) 14px); }
  .tab-name { overflow: hidden; text-overflow: ellipsis; }
  .spot { position: absolute; left: 26px; top: 0; width: 1px; height: 1px; }

  .sheet {
    position: absolute; left: 7%; right: 7%; top: 42px; bottom: 30%; overflow: hidden; border-radius: 10px;
    background: #fff; box-shadow: 0 10px 24px -14px rgba(20, 10, 4, .5);
    transform: rotate(-.6deg); transition: transform .6s var(--ease);
  }
  .sheet img { width: 100%; height: 100%; object-fit: cover; object-position: 50% 0; }
  .sheet.blank { background: linear-gradient(to right, transparent 34px, rgba(249, 77, 3, .45) 34px 35px, transparent 35px), repeating-linear-gradient(to bottom, #fff 0 18px, #ECE8E1 18px 19px); }

  .front {
    position: absolute; left: 0; right: 0; bottom: 0; height: 41%; min-height: 92px;
    display: flex; align-items: flex-end; justify-content: space-between; gap: 14px;
    padding: clamp(14px, 1.5vw, 20px) clamp(16px, 1.7vw, 22px);
    border-radius: 16px 16px 18px 18px; background: var(--sheen), var(--glass);
    -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5);
    box-shadow: var(--glass-edge);
    transform-origin: 50% 100%; transition: transform .6s var(--ease);
  }
  .f-text { display: flex; flex-direction: column; gap: 6px; min-width: 0; }
  .f-name { font-size: clamp(26px, 2.3vw, 38px); font-weight: 500; line-height: 1; letter-spacing: -.04em; color: var(--f-ink); }
  .f-tab { font-size: 14px; font-style: italic; line-height: 1.3; color: var(--f-muted); }
  .go {
    flex: none; width: 40px; height: 40px; display: grid; place-items: center; border-radius: 50%; font-size: 16px; color: var(--f-ink);
    background: var(--go-bg); border: 1px solid var(--go-line); transition: transform .3s var(--ease), color .2s ease, border-color .2s ease;
  }

  @media (hover: hover) {
    .folder:hover .front { transform: rotateX(-16deg); }
    .folder:hover .sheet { transform: translateY(-16px) rotate(-1.2deg); }
    .folder:hover .go { transform: translateX(3px); color: var(--brand); border-color: var(--brand); }
  }
  .folder:focus-visible .front { transform: rotateX(-16deg); }
  .folder:focus-visible .sheet { transform: translateY(-16px) rotate(-1.2deg); }
  .folder:active .front { transform: rotateX(-24deg) scale(.99); transition-duration: .2s; }

  @media (prefers-reduced-motion: reduce) { .slot { animation: none; } .front, .sheet { transition: none; } }

  /* shorter laptop screens: smaller folder type so the drawer still breathes */
  @media (min-width: 1061px) and (max-height: 820px) {
    .front { min-height: 80px; padding: 12px 16px; }
    .f-name { font-size: clamp(22px, 2vw, 30px); }
    .f-tab { font-size: 13px; }
    .go { width: 36px; height: 36px; }
    .folders { gap: 68px clamp(16px, 2vw, 28px); }
    .drawer { padding-top: 68px; }
  }
  /* tablets and phones: the folders simply scroll, a fixed comfortable size each */
  @media (max-width: 1060px) {
    .drawer { height: auto; min-height: 0; padding-block: 64px 32px; }
    .folders { flex: none; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: none; grid-auto-rows: 250px; }
  }
  @media (max-width: 620px) {
    .rule { width: 40px; }
    .intro { min-height: 0; grid-template-columns: 1fr; gap: 0; padding-block: 28px 0; }
    h1 { font-size: clamp(44px, 13vw, 64px); }
    .k-home { justify-self: start; margin: 112px 0 0 8px; }
    .drawer { padding-top: 64px; }
    .folders { grid-template-columns: 1fr; grid-auto-rows: 240px; gap: 64px; }
  }
</style>
