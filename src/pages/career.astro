---
import SiteFooter from '../components/SiteFooter.astro';

const title = 'Career | Kiruthika Ramesh';
const canonicalUrl = 'https://imkiruthika.in/career/';
---
<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="theme-color" content="#F7F6F2" />
    <title>{title}</title>
    <link rel="canonical" href={canonicalUrl} />
    <link rel="icon" type="image/svg+xml" href="/kr-favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin="anonymous" />
    <link href="https://fonts.googleapis.com/css2?family=Google+Sans+Flex:opsz,wght@6..144,100..1000&display=swap" rel="stylesheet" />
    <script is:inline>
      (() => {
        try {
          const savedTheme = localStorage.getItem('site-theme');
          const systemPrefersDark = window.matchMedia('(prefers-color-scheme: dark)').matches;
          document.documentElement.dataset.theme = savedTheme === 'light' || savedTheme === 'dark'
            ? savedTheme
            : systemPrefersDark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
      })();
    </script>
    <style>
      :root {
        color-scheme: light;
        --page: #F7F6F2;
        --surface: #eee8dc;
        --ink: #24231f;
        --muted: #67655e;
        --line: #d8d2c6;
        --brand: #F94D03;
        --sans: 'Google Sans Flex', 'Google Sans', Arial, sans-serif;
        --header-height: 82px;
      }
      :root[data-theme='dark'] {
        color-scheme: dark;
        --page: #171815;
        --surface: #20211d;
        --ink: #f2eee5;
        --muted: #b0ada4;
        --line: #3b3c35;
        --brand: #ff6a2b;
        --social-icon-filter: invert(1);
        --logo-filter: invert(1);
      }
      *, *::before, *::after { box-sizing: border-box; }
      html { min-height: 100%; background: var(--page); }
      body { min-height: 100vh; min-height: 100svh; display: flex; flex-direction: column; margin: 0; background: var(--page); color: var(--ink); font-family: var(--sans); font-size: 17px; line-height: 1.68; -webkit-font-smoothing: antialiased; text-rendering: optimizeLegibility; transition: background-color 180ms ease, color 180ms ease; }
      button, a { -webkit-tap-highlight-color: transparent; }
      button:focus-visible { outline: 2px solid var(--brand); outline-offset: 5px; }
      .skip-link { position: fixed; z-index: 20; top: 10px; left: 10px; padding: 10px 14px; transform: translateY(-150%); background: var(--ink); color: var(--page); }
      .skip-link:focus { transform: translateY(0); }
      .site-header { position: sticky; z-index: 10; top: 0; height: var(--header-height); flex: 0 0 auto; border-bottom: 1px solid var(--line); background: var(--page); }
      .header-inner { width: min(100% - 80px, 1380px); height: 100%; margin: 0 auto; display: flex; align-items: center; gap: clamp(20px, 3vw, 44px); }
      .brand { display: inline-flex; align-items: center; flex: 0 0 auto; line-height: 0; }
      .brand img { display: block; width: 75px; height: 58px; object-fit: contain; filter: var(--logo-filter, none); }
      .primary-nav { display: flex; align-items: center; justify-content: flex-end; gap: clamp(14px, 2.1vw, 30px); flex: 1; }
      .primary-nav a { position: relative; white-space: nowrap; font-size: 14px; font-weight: 500; line-height: 1.2; }
      .primary-nav a::after { content: ''; position: absolute; right: 0; bottom: -7px; left: 0; height: 2px; background: var(--brand); transform: scaleX(0); transform-origin: left; transition: transform 160ms ease; }
      .primary-nav a:hover::after, .primary-nav a[aria-current='page']::after { transform: scaleX(1); }
      .nav-soon { display: none; position: absolute; top: 18px; right: 0; color: var(--muted); font-size: 9px; letter-spacing: .04em; }
      .primary-nav a[data-placeholder] { color: var(--muted); }
      .primary-nav a[data-placeholder] .nav-soon { display: block; }
      .theme-toggle { width: 58px; height: 34px; position: relative; display: inline-flex; align-items: center; flex: 0 0 auto; padding: 3px; border: 1px solid var(--line); border-radius: 999px; background: var(--surface); cursor: pointer; }
      .switch-thumb { width: 26px; height: 26px; display: grid; place-items: center; border-radius: 50%; color: var(--brand); background: var(--page); transform: translateX(0); transition: transform 180ms ease, background-color 180ms ease; }
      :root[data-theme='dark'] .switch-thumb { transform: translateX(23px); }
      .cat-icon { width: 18px; height: 18px; overflow: visible; }
      .cat-icon path, .cat-icon circle { fill: none; stroke: currentColor; stroke-width: 1.55; stroke-linecap: round; stroke-linejoin: round; }
      .cat-awake, .cat-sleep { transition: opacity 140ms ease; }
      .cat-sleep { opacity: 0; }
      :root[data-theme='dark'] .cat-awake { opacity: 0; }
      :root[data-theme='dark'] .cat-sleep { opacity: 1; }
      .mobile-menu-button { display: none; align-items: center; justify-content: center; width: 42px; height: 42px; padding: 0; border: 1px solid var(--line); border-radius: 50%; background: transparent; color: var(--ink); cursor: pointer; }
      .mobile-menu-button svg { width: 20px; height: 20px; }
      .mobile-menu-button path { stroke: currentColor; stroke-width: 1.7; stroke-linecap: round; }
      main { width: min(100% - 80px, 1260px); flex: 1 0 auto; display: grid; place-items: center; min-height: 180px; margin: 0 auto; }
      .soon { margin: 0; color: var(--ink); font-size: clamp(24px, 3vw, 34px); font-weight: 500; line-height: 1.2; letter-spacing: -.035em; }
      @media (max-width: 1060px) {
        :root { --header-height: 76px; }
        .header-inner, main { width: min(100% - 56px, 1260px); }
        .primary-nav { gap: clamp(12px, 1.55vw, 20px); }
        .primary-nav a { font-size: 13px; }
        .brand img { width: 68px; }
      }
      @media (max-width: 820px) {
        .header-inner { gap: 14px; }
        .primary-nav { display: none; position: absolute; top: calc(var(--header-height) - 1px); right: 0; left: 0; align-items: stretch; padding: 15px 28px 23px; border-bottom: 1px solid var(--line); background: var(--page); }
        .primary-nav.is-open { display: grid; grid-template-columns: 1fr 1fr; gap: 0 24px; }
        .primary-nav a { min-height: 46px; display: flex; align-items: center; justify-content: space-between; padding: 7px 0; border-bottom: 1px solid var(--line); font-size: 15px; }
        .primary-nav a::after { display: none; }
        .nav-soon { position: static; margin-left: 4px; font-size: 10px; }
        .mobile-menu-button { display: inline-flex; order: 2; margin-left: auto; }
        .theme-toggle { order: 3; }
      }
      @media (max-width: 620px) {
        :root { --header-height: 70px; }
        .header-inner, main { width: min(100% - 40px, 1260px); }
        .brand img { width: 62px; height: 50px; }
        .header-inner { gap: 12px; }
        .primary-nav { padding-right: 20px; padding-left: 20px; }
      }
      @media (max-width: 380px) {
        .header-inner, main { width: min(100% - 32px, 1260px); }
      }
      @media (prefers-reduced-motion: reduce) {
        *, *::before, *::after { scroll-behavior: auto !important; transition-duration: .01ms !important; }
      }
    </style>
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <header class="site-header">
      <div class="header-inner">
        <a class="brand" href="/" aria-label="Kiruthika Ramesh home"><img src="/kr-logo.svg" alt="" width="75" height="58" /></a>
        <button class="mobile-menu-button" type="button" aria-label="Open navigation" aria-controls="primary-navigation" aria-expanded="false">
          <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" fill="none" /></svg>
        </button>
        <nav class="primary-nav" id="primary-navigation" aria-label="Main navigation">
          <a href="/about/">About</a>
          <a href="/career/" aria-current="page">Career</a>
          <a href="https://ripe-stoat-21e.notion.site/Kiruthika-Ramesh-Portfolio-b938168891d8823892b08165cdc90adf?pvs=74">Selected Works</a>
          <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Writings" aria-label="Writings, coming soon">Writings <span class="nav-soon" aria-hidden="true">Soon</span></a>
          <a role="link" tabindex="0" aria-disabled="true" data-placeholder="Shelf" aria-label="Shelf, coming soon">Shelf <span class="nav-soon" aria-hidden="true">Soon</span></a>
          <a href="mailto:kiruthikar123@gmail.com">Contact</a>
        </nav>
        <button class="theme-toggle" type="button" role="switch" aria-checked="false" aria-label="Switch to dark theme" title="Switch to dark theme">
          <span class="switch-thumb" aria-hidden="true">
            <svg class="cat-icon" viewBox="0 0 24 24">
              <path d="M5 10 4.2 5.2 9 7.5a8 8 0 0 1 6 0l4.8-2.3L19 10a7 7 0 1 1-14 0Z" />
              <path class="cat-awake" d="M8.3 11v1.1m7.4-1.1v1.1M9.6 15c1.4 1.1 3.4 1.1 4.8 0M5.8 13.2 3.8 12.7m14.4.5 2-.5" />
              <path class="cat-sleep" d="M7.9 12.1q1-.9 2 0m4.2 0q1-.9 2 0m-5.1 2.8q1.5 1 3 0m3.4-8.2h2l-2 2h2" />
            </svg>
          </span>
        </button>
      </div>
    </header>

    <main id="main-content"><p class="soon">Soon</p></main>

    <SiteFooter />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const toggle = document.querySelector('.theme-toggle');
        const mobileMenuButton = document.querySelector('.mobile-menu-button');
        const navigation = document.querySelector('#primary-navigation');
        const themePreference = window.matchMedia('(prefers-color-scheme: dark)');

        const updateToggle = () => {
          const isDark = root.dataset.theme === 'dark';
          toggle.setAttribute('aria-checked', String(isDark));
          toggle.setAttribute('aria-label', isDark ? 'Switch to light theme' : 'Switch to dark theme');
          toggle.setAttribute('title', isDark ? 'Switch to light theme' : 'Switch to dark theme');
        };

        updateToggle();
        toggle.addEventListener('click', () => {
          const nextTheme = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = nextTheme;
          try { localStorage.setItem('site-theme', nextTheme); } catch {}
          updateToggle();
        });
        themePreference.addEventListener('change', (event) => {
          try { if (localStorage.getItem('site-theme')) return; } catch {}
          root.dataset.theme = event.matches ? 'dark' : 'light';
          updateToggle();
        });
        mobileMenuButton.addEventListener('click', () => {
          const open = mobileMenuButton.getAttribute('aria-expanded') !== 'true';
          mobileMenuButton.setAttribute('aria-expanded', String(open));
          mobileMenuButton.setAttribute('aria-label', open ? 'Close navigation' : 'Open navigation');
          navigation.classList.toggle('is-open', open);
        });
        navigation.addEventListener('click', (event) => {
          if (event.target.closest('[data-placeholder]')) { event.preventDefault(); return; }
          mobileMenuButton.setAttribute('aria-expanded', 'false');
          mobileMenuButton.setAttribute('aria-label', 'Open navigation');
          navigation.classList.remove('is-open');
        });
      })();
    </script>
  </body>
</html>
