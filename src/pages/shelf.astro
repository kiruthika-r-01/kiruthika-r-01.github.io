---
/**
 * Shelf: off the clock.
 *   01 Currently    heading + four glass cards with covers (last watched comes from Letterboxd automatically)
 *   The room       one full fold: a voxel room (three.js, src/scripts/room.ts) with a floor-to-ceiling bookcase, her
 *                  desk, her and Kafka, and a Great Wave blind over a window onto Chennai. Wide screens with WebGL only,
 *                  loaded when it nears the viewport. "View as a list" swaps it for the two list folds below.
 *   02 On the shelf  her favourite four of everything, one quiet row per medium (the list; phones see this instead)
 *   02 On the desk   the kit, and the apps on each screen
 *   03 Bookmarks    tabs; six per tab, "See all" for the rest
 * Content: src/data/shelf.json (Pages CMS: "Shelf").
 */
import SiteLayout from '../layouts/SiteLayout.astro';
import shelf from '../data/shelf.json';
import { recentWatches } from '../lib/letterboxd';
import { APP_COLORS, appIcon } from '../lib/apps';

type Person = { name: string; knownFor?: string; note?: string; url?: string; image?: string };
const site = 'https://imkiruthika.in';
const watches = shelf.letterboxd ? await recentWatches(shelf.letterboxd, 1) : [];
const currently = shelf.currently.map((c: any) => {
  const w = c.fromLetterboxd && watches[0];
  return w ? { ...c, title: w.title, by: w.year, url: w.link, image: c.title === w.title ? c.image : (w.poster ?? c.image) } : c;
});
const groups = shelf.bookmarks as { group: string; note?: string; people: Person[] }[];
const initials = (n: string) => n.split(/\s+/).filter(Boolean).slice(0, 2).map((w) => w[0]).join('').toUpperCase();
const square = ['music', 'podcasts', 'youtube'];
const kit = shelf.desk.items.filter((d: any) => !['frame', 'pens'].includes(d.id));
const roomData = { shelves: shelf.shelves, missingNote: shelf.missingNote, currently, desk: shelf.desk };
const app = (a: string) => APP_COLORS[a] ?? ['#444444', '#FFFFFF', a[0]];
const structuredData = { '@context': 'https://schema.org', '@type': 'WebPage', '@id': site + '/shelf/', url: site + '/shelf/', name: 'Shelf', description: shelf.seo.description, isPartOf: { '@id': site + '/#website' }, about: { '@id': site + '/#person' } };
---
<SiteLayout title={shelf.seo.title} description={shelf.seo.description} canonical={site + '/shelf/'} current="Shelf" quote={shelf.quote?.text ? shelf.quote : undefined}>
  <script slot="head" type="application/ld+json" set:html={JSON.stringify(structuredData)} />

  <!-- 01 Currently -->
  <section class="wrap fold now" aria-labelledby="s-title">
    <header>
      <p class="kicker"><span class="n">{shelf.kicker}</span><span class="rule" aria-hidden="true"></span><em>right now</em></p>
      <h1 id="s-title">{shelf.title} <em>{shelf.titleItalic}</em></h1>
      <p class="lede">{shelf.lede}</p>
    </header>
    <ul class="current" role="list" aria-label="Currently">
      {currently.map((c: any) => {
        const inner = (
          <>
            {c.image && <img src={c.image} alt="" width="96" height="144" loading="eager" decoding="async" />}
            <span class="cur-text">
              <span class="cur-label"><span class="dot" aria-hidden="true"></span>{c.label}</span>
              <span class="cur-title">{c.title}</span>
              {c.by && <span class="cur-by">{c.by}</span>}
              {c.note && <span class="cur-note">{c.note}</span>}
            </span>
          </>
        );
        if (c.spotify) return <li class="cur"><button type="button" class="cur-play" data-play={c.spotify} data-label={[c.title, c.by].filter(Boolean).join(', ')} aria-label={`Play ${c.title}${c.by ? ' by ' + c.by : ''}`}>{inner}<span class="pb" aria-hidden="true"></span></button></li>;
        return <li class="cur">{c.url ? <a href={c.url} target="_blank" rel="noopener">{inner}</a> : <div>{inner}</div>}</li>;
      })}
    </ul>
  </section>

  <div class="mid" data-mid>
    <!-- The room (wide screens with WebGL) -->
    <section class="room-fold" id="room" aria-labelledby="r-title" data-room>
      <div class="stage" data-stage></div>
      <div class="room-ui wrap">
        <div class="room-head">
          <h2 id="r-title">The <em>room</em></h2>
          <p class="hint" aria-hidden="true">Click anything in the room.</p>
        </div>
        <button class="pill" type="button" data-aslist>View as a list</button>
      </div>
      <div class="tip" data-tip aria-hidden="true" hidden></div>
      <p class="say" data-say hidden aria-live="polite"></p>
      <aside class="card" data-card hidden aria-live="polite">
        <img data-c-img alt="" width="48" height="72" hidden />
        <div class="c-text">
          <p class="c-kind" data-c-kind></p>
          <p class="c-title" data-c-title></p>
          <p class="c-by" data-c-by></p>
          <p class="c-note" data-c-note></p>
          <a class="c-link" data-c-link target="_blank" rel="noopener" hidden></a>
        </div>
        <button class="c-close" type="button" data-c-close aria-label="Close">×</button>
      </aside>
      <script type="application/json" data-room-data set:html={JSON.stringify(roomData)} />
    </section>

    <!-- 02 On the shelf: the favourite fours, one quiet row per medium -->
    <section class="wrap fold list-fold" id="lists" aria-labelledby="la-title">
      <div class="sec-head">
        <div>
          <p class="kicker"><span class="n">02</span><span class="rule" aria-hidden="true"></span><em>favourite four of everything</em></p>
          <h2 id="la-title" tabindex="-1">On the <em>shelf</em></h2>
        </div>
        <button class="pill back" type="button" data-backroom>Back to the room</button>
      </div>
      <div class="ledger">
        {shelf.shelves.map((s: any) => (
          <div class="lrow">
            <h3>{s.name}</h3>
            <ol class="litems" role="list" aria-label={s.name}>
              {[0, 1, 2, 3].map((i) => {
                const it = s.items[i];
                if (!it) return <li class="li miss"><span class="th ph" aria-hidden="true"></span><span class="lt"><span class="ttl">{shelf.missingNote}</span></span></li>;
                const body = (<><img class:list={['th', { sq: square.includes(s.id) }]} src={it.image} alt="" width={square.includes(s.id) ? 48 : 36} height={square.includes(s.id) ? 48 : 54} loading="lazy" decoding="async" /><span class="lt"><span class="ttl">{it.title}</span>{(it.by || it.year) && <span class="by">{[it.by, it.year].filter(Boolean).join(', ')}</span>}</span></>);
                if (it.spotify) return <li><button type="button" class="li song" data-play={it.spotify} data-label={[it.title, it.by].filter(Boolean).join(', ')} aria-label={`Play ${it.title}${it.by ? ' by ' + it.by : ''}`}>{body}<span class="pb" aria-hidden="true"></span></button></li>;
                return <li>{it.url ? <a class="li" href={it.url} target="_blank" rel="noopener">{body}</a> : <div class="li">{body}</div>}</li>;
              })}
            </ol>
          </div>
        ))}
      </div>
    </section>

    <!-- 02 On the desk: the kit, and the apps on each screen -->
    <section class="wrap fold list-fold desk-fold" aria-labelledby="lb-title">
      <div class="sec-head">
        <div>
          <p class="kicker"><span class="n">02</span><span class="rule" aria-hidden="true"></span><em>what I work with</em></p>
          <h2 id="lb-title">On the <em>desk</em></h2>
        </div>
      </div>
      <div class="desk-grid">
        <div class="panel-g kit-panel">
          <h3>The kit</h3>
          <ol class="kit" role="list">
            {kit.map((d: any, i: number) => (
              <li><span class="kn" aria-hidden="true">{String(i + 1).padStart(2, '0')}</span><span class="kt">{d.kind !== d.name && <span class="kk">{d.kind}</span>}<span class="kname">{d.name}</span>{d.note && <span class="knote">{d.note}</span>}</span></li>
            ))}
          </ol>
        </div>
        <div class="panel-g apps-panel">
          {[['Work', 'on the monitor', shelf.desk.monitorApps], ['After hours', 'on the laptop', shelf.desk.laptopApps]].map(([name, where, apps]) => (
            <div class="apps-group">
              <h3>{name as string} <span>{where as string}</span></h3>
              <ul class="dock" role="list">
                {(apps as string[]).map((a) => { const [bg, fg, g] = app(a); const icon = appIcon(a); return <li><span class="tile" style={`--bg:${bg};--fg:${fg}`} aria-hidden="true">{icon ? <img src={icon} alt="" width="48" height="48" loading="lazy" decoding="async" /> : g}</span><span class="an">{a}</span></li>; })}
              </ul>
            </div>
          ))}
        </div>
      </div>
    </section>
  </div>

  <!-- the song player: Spotify's own embed, opened by any song on the page -->
  <aside class="player" data-player hidden aria-label="Now playing">
    <div class="pl-embed" data-pl-embed></div>
    <button class="pl-close" type="button" data-pl-close aria-label="Close the player">×</button>
  </aside>

  <!-- 03 Bookmarks -->
  <section class="wrap fold marks" id="bookmarks" aria-labelledby="b-title" data-tabs>
    <div class="sec-head">
      <div>
        <p class="kicker"><span class="n">03</span><span class="rule" aria-hidden="true"></span><em>people I learn from</em></p>
        <h2 id="b-title">Book<em>marks</em></h2>
      </div>
    </div>
    <div class="tabs-wrap" data-tabswrap>
      <div class="tabs" role="group" aria-label="Choose a group" data-tabsrow>
        {groups.map((g, i) => <button type="button" data-tab={i} aria-pressed={i === 0 ? 'true' : 'false'}>{g.group}</button>)}
      </div>
    </div>
    {groups.map((g, i) => (
      <div class="panel" data-tabpanel={i} hidden={i !== 0}>
        {g.note && <p class="g-note">{g.note}</p>}
        <ul class="people" role="list" aria-label={g.group}>
          {g.people.map((p, j) => {
            const body = (<>
              <span class="av" aria-hidden="true">{p.image ? <img src={p.image} alt="" width="56" height="56" loading="lazy" decoding="async" /> : <span class="mono">{initials(p.name)}</span>}</span>
              <span class="who"><span class="p-name">{p.name}</span>{p.knownFor && <span class="p-known">{p.knownFor}</span>}</span>
              {p.note && <span class="p-line">{p.note}</span>}{p.url && <span class="go" aria-hidden="true">↗</span>}
            </>);
            return <li class:list={['person', { more: j >= 6 }]}>{p.url ? <a href={p.url} target="_blank" rel="noopener">{body}</a> : <div>{body}</div>}</li>;
          })}
        </ul>
        {g.people.length > 6 && <button class="see-all" type="button" data-seeall>See all {g.people.length}</button>}
      </div>
    ))}
  </section>
</SiteLayout>

<script>
  const still = matchMedia('(prefers-reduced-motion: reduce)').matches;

  // bookmarks: tabs (one scrollable line on phones) and "See all"
  document.querySelectorAll('[data-tabs]').forEach((root) => {
    const buttons = Array.from(root.querySelectorAll<HTMLButtonElement>('[data-tab]'));
    buttons.forEach((b) => b.addEventListener('click', () => {
      buttons.forEach((x) => x.setAttribute('aria-pressed', String(x === b)));
      root.querySelectorAll<HTMLElement>('[data-tabpanel]').forEach((p) => { p.hidden = p.dataset.tabpanel !== b.dataset.tab; });
      b.scrollIntoView({ block: 'nearest', inline: 'center', behavior: still ? 'auto' : 'smooth' });
    }));
    root.querySelectorAll<HTMLButtonElement>('[data-seeall]').forEach((b) => b.addEventListener('click', () => { b.closest('.panel')?.setAttribute('data-all', ''); b.remove(); }));
    const row = root.querySelector<HTMLElement>('[data-tabsrow]'), wrap = root.querySelector<HTMLElement>('[data-tabswrap]');
    const edges = () => { if (!row || !wrap) return; wrap.toggleAttribute('data-start', row.scrollLeft > 4); wrap.toggleAttribute('data-end', row.scrollLeft + row.clientWidth >= row.scrollWidth - 4); };
    row?.addEventListener('scroll', edges, { passive: true }); new ResizeObserver(edges).observe(row!);
  });

  // songs: Spotify's iFrame API, loaded on the first play only
  type Ctrl = { loadUri: (u: string) => void; play: () => void; pause: () => void; addListener: (e: string, f: (e: any) => void) => void };
  const player = document.querySelector<HTMLElement>('[data-player]')!, embed = player.querySelector<HTMLElement>('[data-pl-embed]')!;
  let ctrl: Ctrl | null = null, api: Promise<any> | null = null, spin: (on: boolean) => void = () => {};
  const loadApi = () => (api ??= new Promise((res) => { (window as any).onSpotifyIframeApiReady = res; const sc = document.createElement('script'); sc.src = 'https://open.spotify.com/embed/iframe-api/v1'; sc.async = true; document.head.appendChild(sc); }));
  const idOf = (u: string) => u.match(/track[/:]([A-Za-z0-9]+)/)?.[1];
  const mark = (id: string | null, on = false) => document.querySelectorAll<HTMLElement>('[data-play]').forEach((b) => { const me = id !== null && idOf(b.dataset.play!) === id; b.toggleAttribute('data-current', me); b.toggleAttribute('data-playing', me && on); });
  let currentId: string | null = null;
  const setPlaying = (on: boolean) => { mark(currentId, on); spin(on); };
  async function play(url: string, label: string) {
    const id = idOf(url); if (!id) return;
    currentId = id; player.hidden = false; player.setAttribute('aria-label', `Now playing: ${label}`); mark(id);
    const uri = `spotify:track:${id}`;
    if (ctrl) { ctrl.loadUri(uri); ctrl.play(); return; }
    const API = await loadApi(); const el = document.createElement('div'); embed.replaceChildren(el);
    API.createController(el, { uri, width: '100%', height: 80 }, (c: Ctrl) => {
      ctrl = c; c.addListener('ready', () => c.play());
      c.addListener('playback_update', (e) => setPlaying(!e.data.isPaused && e.data.position < e.data.duration));
    });
  }
  const closePlayer = () => { ctrl?.pause(); player.hidden = true; setPlaying(false); mark(null); };
  player.querySelector('[data-pl-close]')!.addEventListener('click', closePlayer);
  document.querySelectorAll<HTMLElement>('[data-play]').forEach((b) => b.addEventListener('click', () => play(b.dataset.play!, b.dataset.label ?? '')));

  // the room: wide screens with WebGL only; loaded when it nears the viewport
  const mid = document.querySelector<HTMLElement>('[data-mid]');
  const sec = mid?.querySelector<HTMLElement>('[data-room]');
  const stage = sec?.querySelector<HTMLElement>('[data-stage]');
  const webgl = () => { try { const c = document.createElement('canvas'); return !!(c.getContext('webgl2') || c.getContext('webgl')); } catch { return false; } };
  if (mid && sec && stage && matchMedia('(min-width: 700px)').matches && webgl()) {
    mid.setAttribute('data-3d', '');
    const q = <T extends HTMLElement>(s: string) => sec.querySelector<T>(s)!;
    const card = q('[data-card]'), tip = q('[data-tip]'), say = q('[data-say]');
    const img = q<HTMLImageElement>('[data-c-img]'), link = q<HTMLAnchorElement>('[data-c-link]');
    let room: { unfocus: () => void; spin: (on: boolean) => void } | null = null;
    const closeCard = () => { card.hidden = true; room?.unfocus(); };
    q('[data-c-close]').addEventListener('click', closeCard);
    addEventListener('keydown', (e) => { if (e.key === 'Escape' && (!card.hidden || !say.hidden)) closeCard(); });
    const go = (el: Element | null) => el?.scrollIntoView({ behavior: still ? 'auto' : 'smooth', block: 'start' });
    q('[data-aslist]').addEventListener('click', () => { mid.setAttribute('data-showlist', ''); closeCard(); const h = document.getElementById('la-title'); go(document.getElementById('lists')); h?.focus({ preventScroll: true }); });
    mid.querySelector('[data-backroom]')?.addEventListener('click', () => { mid.removeAttribute('data-showlist'); go(sec); });
    const io = new IntersectionObserver(async ([e]) => {
      if (!e.isIntersecting) return; io.disconnect();
      const data = JSON.parse(sec.querySelector('[data-room-data]')!.textContent || '{}');
      const { createRoom } = await import('../scripts/room');
      room = createRoom(stage, data, {
        show: (c) => {
          q('[data-c-kind]').textContent = c.kind; q('[data-c-title]').textContent = c.title;
          q('[data-c-by]').textContent = c.by ?? ''; q('[data-c-note]').textContent = c.note ?? '';
          img.hidden = !c.image; if (c.image) img.src = c.image; img.classList.toggle('pixel', !!c.pixel);
          link.hidden = !c.url; if (c.url) { link.href = c.url; link.textContent = `${c.linkLabel ?? 'Open'} ↗`; link.target = c.url.startsWith('/') ? '' : '_blank'; }
          card.hidden = false;
        },
        hide: () => { card.hidden = true; },
        tip: (text, x, y) => { tip.hidden = !text; if (text) { tip.textContent = text; tip.style.transform = `translate(${(x ?? 0) + 14}px, ${(y ?? 0) - 34}px)`; } },
        zoomed: (on) => sec.toggleAttribute('data-zoomed', on),
        play: (it) => { card.hidden = true; if (it.spotify) play(it.spotify, [it.title, it.by].filter(Boolean).join(', ')); },
        night: (on) => { sec.dataset.roomtime = on ? 'night' : 'day'; },
        say: (text, x, y) => { say.hidden = !text; if (text) { say.textContent = text; say.style.transform = `translate(calc(${x ?? 0}px - 50%), ${(y ?? 0) + 46}px)`; } },
      });
      spin = room.spin; stage.classList.add('on');
    }, { rootMargin: '400px 0px' });
    io.observe(sec);
  }
</script>

<style>
  [hidden] { display: none !important; }
  .fold { min-height: calc(100svh - var(--hh, var(--header-height))); padding-block: clamp(32px, 6svh, 80px); display: flex; flex-direction: column; justify-content: center; }
  .kicker { display: flex; align-items: center; gap: 12px; margin-bottom: clamp(12px, 2.2svh, 22px); }
  .kicker .n { font-size: 14px; font-weight: 500; color: var(--muted); letter-spacing: .02em; }
  .rule { width: 56px; height: 1px; background: color-mix(in srgb, var(--ink) 16%, transparent); }
  .kicker em { font-size: clamp(24px, 1.9vw, 28px); line-height: 1; letter-spacing: -.02em; color: var(--brand); }
  h1 { font-size: clamp(56px, min(8.4vw, 15svh), 148px); font-weight: 500; line-height: .94; letter-spacing: -.05em; }
  h1 em, h2 em { font-style: italic; }
  h2 { font-size: clamp(42px, min(5.6vw, 10svh), 96px); font-weight: 500; line-height: .96; letter-spacing: -.048em; }
  h2:focus { outline: none; }
  .lede { margin-top: clamp(16px, 3svh, 30px); max-width: 32em; font-size: clamp(18px, 1.6vw, 23px); line-height: 1.5; color: var(--muted); }
  .sec-head { display: flex; flex-wrap: wrap; align-items: flex-end; justify-content: space-between; gap: 16px; margin-bottom: clamp(18px, 3svh, 32px); }
  h3 { font-size: 13px; font-weight: 500; letter-spacing: .08em; text-transform: uppercase; color: var(--muted); }

  /* glass, as elsewhere on the site */
  .cur > a, .cur > div, .cur-play, .player, .card, .say, .person > a, .person > div, .panel-g, .pill {
    background: color-mix(in srgb, var(--page) 58%, transparent); -webkit-backdrop-filter: blur(22px) saturate(1.5); backdrop-filter: blur(22px) saturate(1.5);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .7), inset 0 0 0 1px color-mix(in srgb, var(--ink) 9%, transparent), 0 20px 40px -34px rgba(40, 20, 8, .5);
  }
  :global(:root[data-theme='dark']) :is(.cur > a, .cur > div, .cur-play, .player, .card, .say, .person > a, .person > div, .panel-g, .pill) {
    background: linear-gradient(165deg, rgba(255, 255, 255, .07), rgba(255, 255, 255, .025) 45%), color-mix(in srgb, var(--page) 55%, transparent);
    box-shadow: inset 0 1px 0 rgba(255, 255, 255, .17), inset 0 0 0 1px rgba(255, 255, 255, .1);
  }
  .pill { min-height: 40px; padding: 0 18px; border: 0; border-radius: 999px; font: inherit; font-size: 14px; font-weight: 500; color: var(--ink); cursor: pointer; transition: box-shadow .25s ease; }
  .pill:hover { box-shadow: inset 0 0 0 1px var(--brand), 0 20px 40px -34px rgba(40, 20, 8, .5); }

  /* 01 currently: every card lifts, its cover a touch more */
  .current { position: relative; isolation: isolate; list-style: none; margin: clamp(36px, 7svh, 72px) 0 0; padding: 0; display: grid; grid-template-columns: repeat(4, minmax(0, 1fr)); gap: 14px; }
  .current::before { content: ''; position: absolute; z-index: -1; inset: -12% -4%; pointer-events: none; filter: blur(40px); background: radial-gradient(40% 60% at 20% 50%, rgba(255, 150, 90, .2), transparent 70%), radial-gradient(36% 56% at 80% 60%, rgba(249, 77, 3, .12), transparent 70%); }
  .cur > a, .cur > div { display: flex; gap: 14px; height: 100%; padding: 14px; border-radius: 20px; color: var(--ink); text-decoration: none; transition: transform .35s var(--ease); }
  .cur img { flex: none; width: 64px; height: 96px; object-fit: cover; border-radius: 8px; box-shadow: 0 10px 20px -12px rgba(20, 10, 4, .6); transition: transform .45s var(--ease), box-shadow .45s var(--ease); }
  .cur:hover > :is(a, div, button) { transform: translateY(-3px); }
  .cur:hover img { transform: translateY(-2px) rotate(-2deg); box-shadow: 0 16px 24px -14px rgba(20, 10, 4, .7); }
  .cur-text { display: flex; flex-direction: column; gap: 4px; min-width: 0; }
  .cur-label { display: flex; align-items: center; gap: 8px; font-size: 13px; color: var(--muted); }
  .dot { position: relative; width: 8px; height: 8px; border-radius: 50%; background: var(--brand); }
  .dot::after { content: ''; position: absolute; inset: 0; border-radius: 50%; background: var(--brand); animation: pulse 2.4s ease-out infinite; }
  @keyframes pulse { from { opacity: .6; scale: 1; } to { opacity: 0; scale: 3; } }
  .cur-title { margin-top: 4px; font-size: 19px; font-weight: 500; line-height: 1.2; letter-spacing: -.015em; }
  .cur-by { font-size: 14px; color: var(--muted); }
  .cur-note { margin-top: auto; font-size: 14px; font-style: italic; color: var(--muted); }

  /* the room: one whole fold, edge to edge; the walls run on past the frame */
  .room-fold, .list-fold, .marks { scroll-margin-top: var(--hh, var(--header-height)); }
  .room-fold { position: relative; display: none; height: calc(100svh - var(--hh, var(--header-height))); min-height: 560px; overflow: hidden; }
  .mid[data-3d] .room-fold { display: block; }
  .mid[data-3d][data-showlist] .room-fold { display: none; }
  .stage { position: absolute; inset: 0; opacity: 0; transition: opacity .8s ease; -webkit-mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent); mask-image: linear-gradient(to bottom, transparent, #000 6%, #000 94%, transparent); }
  .stage:global(.on) { opacity: 1; }
  .stage :global(canvas) { display: block; width: 100%; height: 100%; }
  .room-ui { position: absolute; top: clamp(36px, 7svh, 72px); left: 0; right: 0; display: flex; align-items: flex-start; justify-content: space-between; gap: 16px; pointer-events: none; }
  .room-ui > * { pointer-events: auto; }
  .room-head { transition: opacity .4s ease, translate .5s var(--ease); }
  .room-fold[data-zoomed] .room-head { opacity: 0; translate: 0 -10px; pointer-events: none; }
