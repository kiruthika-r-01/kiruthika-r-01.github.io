---
/**
 * The writing list: one quiet row per piece (date · title and optional one-liner · section and topic),
 * hairlines between. Used on the Writings landing (latest) and on each section page.
 */
import type { CollectionEntry } from 'astro:content';
import { sections, newestFirst, shortDate, hrefOf } from '../lib/writings';
interface Props { list: CollectionEntry<'writings'>[]; showSection?: boolean; filterable?: boolean; limit?: number }
const { list, showSection = false, filterable = false, limit } = Astro.props;
const items = newestFirst(list).slice(0, limit ?? list.length);
---
<ol class="list" data-list={filterable ? '' : undefined}>
  {items.map((e) => (
    <li class="row" data-topic={e.data.topic}>
      <a href={hrefOf(e)}>
        <time class="date" datetime={e.data.date.toISOString().slice(0, 10)}>{shortDate(e.data.date)}</time>
        <span class="main">
          <span class="title">{e.data.title}</span>
          {e.data.dek && <span class="dek">{e.data.dek}</span>}
        </span>
        <span class="where">
          {showSection && <><span>{sections[e.data.section].name}</span><span aria-hidden="true">·</span></>}
          <em>{e.data.topic}</em>
        </span>
      </a>
    </li>
  ))}
</ol>

<style>
  .list { list-style: none; margin: 0; padding: 0; border-top: 1px solid var(--line); }
  .row { border-bottom: 1px solid var(--line); }
  .row[hidden] { display: none; }
  .row a {
    display: grid; grid-template-columns: minmax(0, 2fr) minmax(0, 7fr) minmax(0, 3fr); column-gap: clamp(16px, 2vw, 28px); align-items: baseline;
    padding-block: clamp(18px, 2.8svh, 30px); color: var(--ink); text-decoration: none;
  }
  .date { font-size: 13px; color: var(--muted); font-variant-numeric: tabular-nums; }
  .main { display: flex; flex-direction: column; gap: 6px; }
  .title { font-size: clamp(21px, 1.9vw, 27px); font-weight: 500; line-height: 1.18; letter-spacing: -.02em; text-wrap: balance; transition: color .2s ease; }
  .dek { font-size: 16px; line-height: 1.5; color: var(--muted); }
  .where { display: flex; flex-wrap: wrap; justify-content: flex-end; align-items: baseline; gap: 0 6px; font-size: 13px; color: var(--muted); text-align: right; }
  .where em { font-size: 15px; font-style: italic; color: var(--brand-ink); }
  .row a:hover .title, .row a:focus-visible .title { color: var(--brand); }

  @media (max-width: 820px) {
    .row a { grid-template-columns: auto 1fr; grid-template-areas: 'date where' 'main main'; row-gap: 10px; padding-block: 22px; }
    .date { grid-area: date; }
    .where { grid-area: where; }
    .main { grid-area: main; }
    .title { font-size: 21px; }
  }
</style>
