---
/**
 * The site's character: a small crow in round glasses, drawn as pixel art (one tiny inline SVG).
 * Crows are curious, stubborn problem-solvers that make their own tools; this one wears Kiruthika's glasses.
 *
 *   <Crow size={4} mood="idle" />
 *   size: CSS pixels per art pixel (the art is 22 x 18)
 *   mood: idle (blinks, hops now and then) | puzzled (adds a question mark) | still (no motion)
 *         | theme (the theme toggle: awake in light mode, eyes shut in dark mode)
 * Colours come from CSS custom properties so it works on light, dark and the dark footer plate:
 *   --crow-ink (body), --crow-frame (glasses), --crow-lens (glass)
 * Motion only runs while visible (data-visible) and never with prefers-reduced-motion.
 * One reaction everywhere: hover (mouse) or click/tap makes it hop twice and caw.
 * The "caw!" always appears just past the beak tip, level with the beak.
 */
interface Props { size?: number; mood?: 'idle' | 'puzzled' | 'still' | 'theme'; label?: string; class?: string; flyer?: boolean }
// flyer: also draws two wing-flap frames, shown while the element carries [data-flying]
const { size = 4, mood = 'idle', label, class: className, flyer = false } = Astro.props;

// '#' body  'o' glasses frame  'w' lens  'e' eye  'b' beak  'l' legs
const art = [
  '...........#####......',
  '.........########.....',
  '........###ooooo##....',
  '........##owwwwwo#bb..',
  '........##owwewwooobbb',
  '........##owwwwwo#bb..',
  '........###ooooo##....',
  '.......###########....',
  '......############....',
  '....#############.....',
  '..###############.....',
  '.################.....',
  '####.###########......',
  '##....#########.......',
  '........######........',
  '.........l..l.........',
  '.........l..l.........',
  '........ll.ll.........',
];
type Run = { x: number; y: number; w: number };
const runsOf = (rows: string[], dy = 0) => {
  const out: Record<string, Run[]> = {};
  rows.forEach((row, y) => {
    let x = 0;
    while (x < row.length) {
      const c = row[x];
      if (c === '.') { x++; continue; }
      let w = 1; while (row[x + w] === c) w++;
      const key = c === 'b' || c === 'l' ? '#' : c;
      (out[key] ??= []).push({ x, y: y + dy, w });
      x += w;
    }
  });
  return out;
};
const runs = runsOf(art);

// Flying: the same head and glasses, body level, tail out behind; wings up / wings down.
const head = art.slice(0, 7).map((r) => r.slice(8));
const wingUp = ['.##.....', '.###....', '..###...', '..####..', '...####.', '...#####', '....####'];
const flyBody = ['...###############....', '.#################....', '####..###########.....', '##.....########.......'];
const flyUp = runsOf([...head.map((h, i) => wingUp[i] + h), ...flyBody, '......................', '......................', '......................'], 2);
const flyDown = runsOf([...head.map((h) => '........' + h), ...flyBody, '....#######...........', '.....#####............', '......###.............'], 2);
const q = ['.##.', '#..#', '...#', '..#.', '..#.', '....', '..#.']; // pixel "?"
const W = 22, H = 18;
const top = mood === 'puzzled' ? 9 : 0;   // extra art rows above the head (room for the "?")
---
<span
  class:list={['crow', className]}
  data-crow
  data-mood={mood}
  style={`--px:${size}px;--top:${top}`}
  role={label ? 'img' : undefined}
  aria-label={label}
  aria-hidden={label ? undefined : 'true'}
>
  <svg viewBox={`0 ${-top} ${W} ${H + top}`} width={W * size} height={(H + top) * size} shape-rendering="crispEdges" focusable="false">
    <g class="crow-body">
      <g class="crow-ink">{runs['#']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
      <g class="crow-lens">{runs['w']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
      <g class="crow-frame">{runs['o']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
      <g class="crow-eye">{runs['e']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
      <g class="crow-lid"><rect x="11" y="4" width="5" height="1" /></g>
      <g class="crow-beak-open"><rect x="18" y="5" width="3" height="1" /></g>
    </g>
    {flyer && [flyUp, flyDown].map((f, k) => (
      <g class:list={['crow-fly', k ? 'crow-fly-b' : 'crow-fly-a']}>
        <g class="crow-ink">{f['#']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
        <g class="crow-lens">{f['w']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
        <g class="crow-frame">{f['o']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
        <g class="crow-eye">{f['e']?.map((r) => <rect x={r.x} y={r.y} width={r.w} height="1" />)}</g>
      </g>
    ))}
    {mood === 'puzzled' && (
      <g class="crow-q">{q.flatMap((row, y) => row.split('').map((c, x) => c === '#' ? <rect x={16 + x} y={y - 9} width="1" height="1" /> : null))}</g>
    )}
  </svg>
  {mood !== 'theme' && <span class="crow-caw" aria-hidden="true">caw!</span>}
</span>

<style>
  .crow { position: relative; display: inline-block; line-height: 0; cursor: pointer; -webkit-tap-highlight-color: transparent; color: var(--crow-ink, var(--ink, #1B1A17)); }
  .crow svg { display: block; overflow: visible; }
  .crow-ink, .crow-eye, .crow-lid, .crow-beak-open { fill: currentColor; }
  .crow-frame { fill: var(--crow-frame, var(--brand, #F94D03)); }
  .crow-lens { fill: var(--crow-lens, var(--page, #fff)); }
  .crow-q { fill: var(--crow-frame, var(--brand, #F94D03)); }
  .crow-lid, .crow-beak-open { opacity: 0; }

  /* idle life: a blink every few seconds, a double hop now and then (in whole pixels, like the art) */
  .crow-body { transform-box: fill-box; }
  .crow[data-mood='idle'] .crow-eye, .crow[data-mood='theme'] .crow-eye { animation: crow-blink 5.2s steps(1) infinite; }
  .crow[data-mood='idle'] .crow-body { animation: crow-hop 9s steps(1) infinite; }
  .crow[data-mood='puzzled'] .crow-eye { animation: crow-blink 3.6s steps(1) infinite; }
  .crow[data-mood='puzzled'] .crow-q { animation: crow-q 2.4s steps(1) infinite; }
  /* theme toggle in dark mode: asleep, eyes shut */
  :global(:root[data-theme='dark']) .crow[data-mood='theme'] .crow-eye { opacity: 0; animation: none; }
  :global(:root[data-theme='dark']) .crow[data-mood='theme'] .crow-lid { opacity: 1; }
  .crow:not([data-visible]) * { animation-play-state: paused !important; }
  @keyframes crow-blink { 0%, 94% { opacity: 1; } 95%, 97% { opacity: 0; } }
  @keyframes crow-hop {
    0%, 80% { transform: translateY(0); }
    81% { transform: translateY(-2px); } 83% { transform: translateY(0); }
    85% { transform: translateY(-2px); } 87%, 100% { transform: translateY(0); }
  }
  @keyframes crow-q { 0%, 60% { opacity: 1; } 61%, 80% { opacity: 0; } 81%, 100% { opacity: 1; } }

  /* flying (only when a page sets [data-flying] on a flyer crow): hide the perched pose, flap two frames */
  .crow-fly { display: none; }
  .crow[data-flying] .crow-body { display: none; }
  .crow[data-flying] .crow-fly { display: inline; }
  .crow[data-flying] .crow-fly-a { animation: flap-a .32s steps(1) infinite; }
  .crow[data-flying] .crow-fly-b { animation: flap-b .32s steps(1) infinite; }
  @keyframes flap-a { 0%, 49% { opacity: 1; } 50%, 100% { opacity: 0; } }
  @keyframes flap-b { 0%, 49% { opacity: 0; } 50%, 100% { opacity: 1; } }
  @media (prefers-reduced-motion: reduce) { .crow[data-flying] .crow-fly-b { display: none; } }

  /* the reaction: "caw!" sits just past the beak tip (art x = 22), centred on the beak row (y = 4.5) */
  .crow-caw {
    position: absolute; left: calc(var(--px) * 23); top: calc(var(--px) * (var(--top) + 4.5));
    font: 600 max(12px, calc(var(--px) * 3.2)) / 1 var(--sans, system-ui, sans-serif); letter-spacing: -.01em; white-space: nowrap;
    color: var(--crow-frame, var(--brand, #F94D03)); opacity: 0; transform: translate(-3px, -50%); pointer-events: none;
  }
  .crow[data-react] .crow-body { animation: crow-react .7s steps(1) 1 !important; }
  .crow[data-react] .crow-beak-open { animation: crow-beak .7s steps(1) 1; }
  .crow[data-react] .crow-caw { animation: crow-caw 1.1s cubic-bezier(.3, .7, .2, 1) 1; }
  @keyframes crow-react {
    0% { transform: translateY(-3px); } 20% { transform: translateY(0); }
    35% { transform: translateY(-2px); } 55%, 100% { transform: translateY(0); }
  }
  @keyframes crow-beak { 0%, 15% { opacity: 1; } 16%, 34% { opacity: 0; } 35%, 55% { opacity: 1; } 56%, 100% { opacity: 0; } }
  @keyframes crow-caw { 0% { opacity: 0; transform: translate(-3px, -50%); } 15%, 70% { opacity: 1; transform: translate(0, -50%); } 100% { opacity: 0; transform: translate(3px, -50%); } }
  @media (prefers-reduced-motion: reduce) {
    .crow * { animation: none !important; }
    .crow[data-react] .crow-caw { opacity: 1; transform: translate(0, -50%); }
  }
</style>

<script>
  const crows = document.querySelectorAll<HTMLElement>('[data-crow]');
  if ('IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => es.forEach((e) => e.target.toggleAttribute('data-visible', e.isIntersecting)));
    crows.forEach((c) => io.observe(c));
  } else crows.forEach((c) => c.setAttribute('data-visible', ''));

  // one reaction, same everywhere: hover with a mouse, or click / tap
  const fine = matchMedia('(hover: hover) and (pointer: fine)');
  const react = (c: HTMLElement) => {
    if (c.hasAttribute('data-react')) return;
    c.setAttribute('data-react', '');
    window.setTimeout(() => c.removeAttribute('data-react'), 1150);
  };
  crows.forEach((c) => {
    c.addEventListener('pointerenter', () => { if (fine.matches) react(c); });
    c.addEventListener('click', () => react(c));
  });
</script>
